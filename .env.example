# Hyperliquid API wallet private key
# Generate this from Settings → API on the Hyperliquid testnet/mainnet site
# NEVER commit your actual .env file to git
HL_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Network: "testnet" or "mainnet"
# Always start with testnet!
HL_NETWORK=testnet

# Dashboard port (optional, defaults to 3000)
DASHBOARD_PORT=3000
