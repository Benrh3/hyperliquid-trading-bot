# ─────────────────────────────────────────────────────────────────────────────
# Hyperliquid Trading Bot — Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. The .gitignore already excludes it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Hyperliquid wallet ────────────────────────────────────────────────────────

# 32-byte hex private key for the Hyperliquid TESTNET wallet.
# Get one from: https://app.hyperliquid-testnet.xyz/  → API tab → Generate key
HL_PRIVATE_KEY=0xYOUR_64_HEX_CHAR_PRIVATE_KEY_HERE

# Separate key for MAINNET. Must be DISTINCT from HL_PRIVATE_KEY.
# Leave blank until you are ready for real-money trading.
HL_MAINNET_PRIVATE_KEY=

# Network to connect to: "testnet" (default, safe) or "mainnet" (real funds).
# All safety gates on the Settings page must pass before switching to mainnet.
HL_NETWORK=testnet

# ── Execution mode ────────────────────────────────────────────────────────────

# Set to "false" to place real testnet orders. Defaults to "true" (dry-run).
# Live bots on the Bots page also respect this flag.
DRY_RUN=true

# ── dYdX v4 testnet (cross-venue strategy) ───────────────────────────────────

# 24-word BIP-39 mnemonic for the dYdX v4 TESTNET wallet.
# Required only for cross-venue live mode; paper simulation works without it.
# Generate a fresh wallet: npm run dydx:setup  (then fund it via the faucet).
# NEVER use a mainnet/production mnemonic here.
DYDX_TESTNET_MNEMONIC=

# ── Dashboard ─────────────────────────────────────────────────────────────────

# Port the web dashboard listens on. Defaults to 3002.
DASHBOARD_PORT=3002

# ── Telegram notifications (optional) ────────────────────────────────────────

# Create a bot at https://t.me/BotFather, then get your chat ID via:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Leave both blank to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
