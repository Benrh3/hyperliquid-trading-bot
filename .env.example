# Hyperliquid API wallet private key
# Generate this from Settings → API on the Hyperliquid testnet/mainnet site
# NEVER commit your actual .env file to git
HL_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Network: "testnet" or "mainnet"
# Always start with testnet!
HL_NETWORK=testnet

# Dashboard port (optional, defaults to 3000)
DASHBOARD_PORT=3000

# dYdX v4 testnet mnemonic (required for cross-venue real-order execution)
# Generate a new wallet at https://v4.testnet.dydx.exchange/ or use any BIP-39 tool.
# If absent, the cross-venue strategy runs in paper-simulation mode only.
# NEVER commit your actual .env file to git
DYDX_TESTNET_MNEMONIC=

# Telegram notifications (optional)
# 1. Open Telegram and message @BotFather
# 2. Send /newbot and follow the prompts to get your token
# 3. Start a chat with your bot, then fetch your chat ID from:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
