# ─────────────────────────────────────────────────────────────────────────────
# Hyperliquid Trading Bot — Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. The .gitignore already excludes it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Hyperliquid wallet ────────────────────────────────────────────────────────

# 32-byte hex private key for the Hyperliquid TESTNET wallet.
# Get one from: https://app.hyperliquid-testnet.xyz/  → API tab → Generate key
HL_PRIVATE_KEY=0xYOUR_64_HEX_CHAR_PRIVATE_KEY_HERE

# Separate key for MAINNET. Must be DISTINCT from HL_PRIVATE_KEY.
# Leave blank until you are ready for real-money trading.
HL_MAINNET_PRIVATE_KEY=

# Network to connect to: "testnet" (default, safe) or "mainnet" (real funds).
# All safety gates on the Settings page must pass before switching to mainnet.
HL_NETWORK=testnet

# ── Funding data network (read-only, never affects trading) ──────────────────

# Controls which PUBLIC indexers the funding-matrix heatmap reads from.
# Completely separate from HL_NETWORK (which controls order execution).
# Use "mainnet" (default) for real funding rates even while trading on testnet,
# because testnet has no trading activity and all rates are zero.
# Set to "testnet" only if you specifically want testnet indexer data.
FUNDING_DATA_NETWORK=mainnet

# ── Execution mode ────────────────────────────────────────────────────────────

# Set to "false" to place real testnet orders. Defaults to "true" (dry-run).
# Live bots on the Bots page also respect this flag.
DRY_RUN=true

# ── dYdX v4 testnet (cross-venue strategy) ───────────────────────────────────

# 24-word BIP-39 mnemonic for the dYdX v4 TESTNET wallet.
# Required only for cross-venue live mode; paper simulation works without it.
# Generate a fresh wallet: npm run dydx:setup  (then fund it via the faucet).
# NEVER use a mainnet/production mnemonic here.
DYDX_TESTNET_MNEMONIC=

# ── Dashboard ─────────────────────────────────────────────────────────────────

# Port the web dashboard listens on. Defaults to 3002.
DASHBOARD_PORT=3002

# bcrypt hash of the admin password. Required (along with SESSION_SECRET
# below) to enable the dashboard's admin login — without both set, the
# dashboard runs in fully public, read-only mode (no login link, all action
# buttons hidden, all POST/PUT/DELETE endpoints return 403).
#
# Generate a hash with:
#   node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('yourpassword', 10).then(h => console.log(h))"
#
# Paste the resulting string (starts with $2a$ or $2b$) below.
ADMIN_PASSWORD_HASH=

# Random secret used to sign the admin session cookie (HMAC-SHA256).
# Required alongside ADMIN_PASSWORD_HASH to enable admin login.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Keep this secret — anyone who has it can forge admin session cookies.
# Changing it invalidates all existing sessions.
SESSION_SECRET=

# Note: the login session cookie is sent with the `secure` flag, so the
# admin login only works when the dashboard is served over HTTPS
# (e.g. behind a reverse proxy that terminates TLS).

# ── Telegram notifications (optional) ────────────────────────────────────────

# Create a bot at https://t.me/BotFather, then get your chat ID via:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Leave both blank to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
