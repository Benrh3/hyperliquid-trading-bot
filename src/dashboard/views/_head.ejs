<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <title><%= title %> — Howbrook Quant</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ── Dark theme (default) ── */
    :root {
      --bg:      #0A0E14;
      --surface: #0D1520;
      --surface2: #111E2D;
      --border:  rgba(129,140,248,0.14);
      --text:    #e6edf3;
      --muted:   #3D5A78;
      --green:   #3fb950;
      --red:     #f85149;
      --blue:    #58a6ff;
      --yellow:  #d29922;
      --chart-bg: #0D1520;
      /* ── Accent: indigo (bot pillar default) ── */
      --accent:        #818CF8;
      --accent-dim:    rgba(129,140,248,0.12);
      --accent-border: rgba(129,140,248,0.25);
      --up:            #22C55E;
      --down:          #EF4444;
      /* ── Type scale ── */
      --t-label:    11px;
      --t-value:    26px;
      --t-value-sm: 20px;
      --t-hero:     40px;
      --t-body:     13px;
      /* ── Spacing: 4 / 8 / 12 / 16 / 20 / 24 ── */
      --sp-1: 4px;
      --sp-2: 8px;
      --sp-3: 12px;
      --sp-4: 16px;
      --sp-5: 20px;
      --sp-6: 24px;
    }

    /* ── Light theme ── */
    body.light {
      --bg:      #ffffff;
      --surface: #f6f8fa;
      --border:  #d0d7de;
      --text:    #24292f;
      --muted:   #656d76;
      --green:   #1a7f37;
      --red:     #cf222e;
      --blue:    #0969da;
      --yellow:  #9a6700;
      --chart-bg: #f6f8fa;
      --accent:        #0EA5E9;
      --accent-dim:    rgba(14,165,233,0.12);
      --accent-border: rgba(14,165,233,0.25);
      --up:            #16A34A;
      --down:          #DC2626;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 14px;
      line-height: 1.5;
      transition: background .15s, color .15s;
    }

    /* ── Nav ── */
    .nav {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0 1.5rem;
      display: flex;
      align-items: center;
      gap: 0;
      height: 48px;
      position: relative;
    }
    .nav-brand {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 18px;
      font-weight: 400;
      letter-spacing: .02em;
      color: var(--text);
      margin-right: 1.5rem;
      text-decoration: none;
      flex-shrink: 0;
    }
    .nav-brand .brand-desc {
      color: var(--muted);
    }

    /* ── Page header (serif title + subtitle) ── */
    .page-header { margin-bottom: var(--sp-6); }
    .page-title {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: var(--t-hero);
      font-weight: 400;
      letter-spacing: -.01em;
      line-height: 1.1;
    }
    .page-subtitle {
      font-size: var(--t-body);
      color: var(--muted);
      margin-top: var(--sp-1);
      line-height: 1.5;
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 0;
    }
    .nav-link {
      color: var(--muted);
      text-decoration: none;
      padding: 0 0.75rem;
      height: 48px;
      display: flex;
      align-items: center;
      border-bottom: 2px solid transparent;
      font-size: 13px;
      transition: color 0.15s;
      white-space: nowrap;
    }
    .nav-link:hover { color: var(--text); }
    .nav-link.active { color: var(--blue); border-bottom-color: var(--blue); }
    .nav-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 12px;
      color: var(--muted);
      flex-shrink: 0;
    }
    .dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--green);
      display: inline-block;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.4; }
    }

    /* ── Theme toggle ── */
    .theme-btn {
      background: none;
      border: 1px solid var(--border);
      color: var(--muted);
      font-size: 14px;
      line-height: 1;
      padding: 3px 6px;
      border-radius: 4px;
      cursor: pointer;
      transition: color .1s, border-color .1s;
    }
    .theme-btn:hover { color: var(--text); border-color: var(--muted); }

    /* ── Hamburger (mobile) ── */
    .hamburger {
      display: none;
      background: none;
      border: none;
      color: var(--muted);
      font-size: 20px;
      cursor: pointer;
      padding: 4px 6px;
      margin-left: 0.25rem;
    }
    .nav-links.open { display: flex; }

    /* ── Bot pillar nav: group row + sub-page row ── */
    .nav-sub {
      height: 40px;
      border-top: none;
    }
    .nav-sub .nav-link { height: 40px; font-size: 12px; }
    .nav-sub .nav-link.active { color: var(--accent); border-bottom-color: var(--accent); }

    /* ── Layout ── */
    .container { max-width: 1100px; margin: 0 auto; padding: 1.5rem; }

    /* ── Stat grid ── */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1rem 1.25rem;
    }
    .card-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      margin-bottom: 0.4rem;
    }
    .card-value {
      font-size: 1.6rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.02em;
    }
    .card-sub {
      font-size: 11px;
      color: var(--muted);
      margin-top: 0.25rem;
    }

    /* ── Section ── */
    .section-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.75rem;
    }

    /* ── Table ── */
    .table-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
      margin-bottom: 1.5rem;
      overflow-x: auto;
    }
    table { width: 100%; border-collapse: collapse; min-width: 500px; }
    th {
      padding: 0.5rem 0.875rem;
      text-align: left;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }
    td {
      padding: 0.5rem 0.875rem;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
      font-variant-numeric: tabular-nums;
    }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(128,128,128,0.04); }
    .empty { padding: 2rem; text-align: center; color: var(--muted); }

    /* ── Badges ── */
    .badge {
      display: inline-block;
      padding: 0.15rem 0.5rem;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
    }
    .badge-info  { background: rgba(88,166,255,0.12);  color: var(--blue);   }
    .badge-warn  { background: rgba(210,153,34,0.12);  color: var(--yellow); }
    .badge-error { background: rgba(248,81,73,0.12);   color: var(--red);    }
    .badge-long  { background: rgba(63,185,80,0.12);   color: var(--green);  }
    .badge-short { background: rgba(248,81,73,0.12);   color: var(--red);    }
    .badge-net   { background: rgba(88,166,255,0.10);  color: var(--blue);   font-size: 10px; }

    /* ── Misc ── */
    .mono { font-family: 'SFMono-Regular', Consolas, monospace; }
    .text-muted { color: var(--muted); }
    .text-green { color: var(--green); }
    .text-red   { color: var(--red);   }

    /* ── Mobile responsive ── */
    @media (max-width: 768px) {
      .container { padding: 1rem 0.75rem; }

      /* ── Top nav: brand(flex-1) | dot | theme | hamburger ── */
      .nav-top { overflow: visible; }
      .nav-brand { flex: 1; margin-right: 0; }

      /* Push hamburger to far right via order */
      .hamburger { display: flex; align-items: center; order: 10; margin-left: 0.25rem; }

      /* Nav-right: shrink, keep only dot + theme-btn; hide login/logout */
      .nav-right { order: 9; gap: 0.4rem; font-size: 11px; }
      .nav-right .nav-link { display: none; }          /* hide login/logout from top bar */
      .nav-right .text-muted { display: none; }

      /* Pillar nav-links: dropdown below the top bar */
      .nav-links {
        display: none;
        position: absolute;
        top: 48px;
        left: 0;
        right: 0;
        flex-direction: column;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        z-index: 100;
        padding: 0.5rem 0;
      }
      .nav-links.open { display: flex; }

      /* Mobile-only auth link inside hamburger dropdown */
      .nav-mobile-auth { display: flex !important; }

      /* Sub-nav: horizontal scroll strip */
      .nav-sub { overflow-x: auto; -webkit-overflow-scrolling: touch; height: auto; padding: 0 0.5rem; }
      .nav-sub .nav-links { display: flex; position: static; flex-direction: row; border-bottom: none; padding: 0; background: none; }

      /* Nav-link row items in dropdown */
      .nav-top .nav-links .nav-link {
        height: auto;
        padding: 0.6rem 1.25rem;
        border-bottom: none;
        border-left: 2px solid transparent;
        width: 100%;
      }
      .nav-top .nav-links .nav-link.active { border-left-color: var(--blue); border-bottom: none; }

      /* Sub-nav link sizing */
      .nav-sub .nav-link { height: auto; padding: 0.5rem 0.75rem; font-size: 11px; white-space: nowrap; }
      .nav-sub .nav-link.active { color: var(--accent); border-bottom: 2px solid var(--accent); }

      /* Cards: two column */
      .grid { grid-template-columns: 1fr 1fr; }
      .card-funding { grid-column: span 2; }
      .card-value { font-size: 1.3rem; }
    }

    @media (max-width: 480px) {
      .grid { grid-template-columns: 1fr; }
      .card-funding { grid-column: span 1; }
    }

    /* ── Signal-card font scaling on mobile ── */
    @media (max-width: 600px) {
      .signal-card { padding: var(--sp-3); min-height: 90px; }
      .sc-value { font-size: 20px; }
      .sc-subline { font-size: 11px; }
    }
    @media (max-width: 400px) {
      .sc-value { font-size: 16px; overflow-wrap: break-word; word-break: break-word; }
      .sc-label { font-size: 10px; }
    }

    /* ═══════════════════════════════════════════════════════════════════════
       Shared primitives — SignalCard, chart-card, badges, caveat
       Themed per pillar via --accent, --surface, --border, etc.
    ═══════════════════════════════════════════════════════════════════════ */

    /* ── SignalCard ──────────────────────────────────────────────────────── */
    .signal-card {
      background: var(--surface);
      border: none;
      border-radius: 6px;
      padding: var(--sp-5);
      min-height: 120px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
      transition: box-shadow .15s;
    }
    .signal-card:hover { box-shadow: 0 4px 16px var(--accent-dim); }
    .sc-header { display: flex; align-items: center; gap: var(--sp-1); margin-bottom: var(--sp-2); }
    .sc-label {
      font-size: var(--t-label); text-transform: uppercase;
      letter-spacing: .08em; color: var(--muted); font-weight: 600;
    }
    .sc-info-btn {
      background: none; border: none; color: var(--muted);
      font-size: var(--t-label); cursor: pointer; padding: 0;
      line-height: 1; transition: color .1s; opacity: .65;
    }
    .sc-info-btn:hover { color: var(--accent); opacity: 1; }
    .sc-value {
      font-size: var(--t-value); font-weight: 600;
      font-variant-numeric: tabular-nums; letter-spacing: -.02em;
      line-height: 1; margin-bottom: var(--sp-2);
    }
    .sc-value.val-pos { color: var(--up); }
    .sc-value.val-neg { color: var(--down); }
    .sc-subline { font-size: var(--t-body); color: var(--muted); margin-bottom: var(--sp-2); }
    .sc-dir { font-size: var(--t-label); font-weight: 600; letter-spacing: .02em; line-height: 1; margin-bottom: var(--sp-2); }
    .sc-dir-pos     { color: var(--up); }
    .sc-dir-neg     { color: var(--down); }
    .sc-dir-neutral { color: var(--muted); }
    .sc-read { font-size: var(--t-label); color: var(--muted); font-style: italic; margin-bottom: var(--sp-2); line-height: 1.5; }
    .sc-badges { display: flex; gap: var(--sp-1); flex-wrap: wrap; margin-top: auto; }
    .sc-badge {
      display: inline-block; padding: .08rem .35rem;
      border-radius: 20px; font-size: 9px; font-weight: 600; letter-spacing: .03em;
    }
    .sc-kind-level      { background: var(--accent-dim);            color: var(--accent); }
    .sc-kind-window     { background: rgba(245,158,11,0.14);        color: #F59E0B; }
    .sc-kind-delta-prev { background: rgba(139,92,246,0.14);        color: #A78BFA; }
    .sc-kind-ratio      { background: rgba(236,72,153,0.14);        color: #F472B6; }
    .sc-kind-aggregate  { background: rgba(34,211,238,0.14);        color: #22D3EE; }
    .sc-kind-count      { background: var(--accent-dim);            color: var(--muted); }
    .sc-source          { background: rgba(129,140,248,0.06);       color: var(--muted); }
    /* A tracker whose warm-up window (filled fraction) hasn't reached its
       confidence threshold yet — e.g. right after a process restart. Distinct
       from a genuine value of zero, which renders normally. */
    .signal-card.warming { opacity: .55; }
    .signal-card.warming .sc-value { color: var(--muted); }

    /* ── Chart card ─────────────────────────────────────────────────────── */
    .chart-card {
      background: var(--surface);
      border-radius: 8px;
      margin: 0 var(--sp-4) var(--sp-4);
      overflow: hidden;
    }
    .chart-card-toolbar {
      align-items: center; border-bottom: 1px solid var(--border);
      display: flex; gap: var(--sp-3); padding: var(--sp-3) var(--sp-4);
    }
    .chart-card-title { font-size: var(--t-body); font-weight: 600; color: var(--muted); flex: 1; }
    .chart-card-meta  { font-size: var(--t-label); color: var(--muted); opacity: .6; }
    .tf-group { display: flex; gap: 2px; }
    .tf {
      background: transparent; border: 1px solid transparent;
      border-radius: 4px; color: var(--muted); cursor: pointer;
      font-size: var(--t-label); font-weight: 600; font-family: inherit;
      letter-spacing: .04em; padding: 2px 6px;
      transition: color .15s, background .15s;
    }
    .tf:hover  { color: var(--accent); }
    .tf.active { background: var(--accent-dim); border-color: var(--accent-border); color: var(--accent); }

    /* ── Caveat banner ──────────────────────────────────────────────────── */
    .caveat {
      background: rgba(245,158,11,0.07);
      border-left: 3px solid rgba(245,158,11,0.5);
      border-radius: 0 4px 4px 0;
      color: var(--muted); font-size: var(--t-label);
      line-height: 1.5;
      margin: var(--sp-4) var(--sp-4) 0;
      padding: var(--sp-2) var(--sp-3);
    }
    .caveat strong { color: #F59E0B; font-weight: 600; }
  </style>
</head>
<body>
<script>
(function () {
  // Apply saved theme before paint to avoid flash
  const saved = document.cookie.split(';').map((s) => s.trim()).find((s) => s.startsWith('theme='));
  if (saved && saved.split('=')[1] === 'light') document.body.classList.add('light');

  // Wire up theme toggle and hamburger after DOM is ready
  document.addEventListener('DOMContentLoaded', function () {
    // Theme toggle
    const themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
      function updateThemeIcon() {
        themeBtn.textContent = document.body.classList.contains('light') ? '☀' : '☽';
      }
      updateThemeIcon();
      themeBtn.addEventListener('click', function () {
        document.body.classList.toggle('light');
        const isLight = document.body.classList.contains('light');
        document.cookie = 'theme=' + (isLight ? 'light' : 'dark') + ';path=/;max-age=31536000';
        updateThemeIcon();
      });
    }

    // Hamburger menu
    const hamburger = document.getElementById('nav-hamburger');
    const navLinks  = document.getElementById('nav-links');
    if (hamburger && navLinks) {
      hamburger.addEventListener('click', function () {
        navLinks.classList.toggle('open');
      });
      // Close menu when a link is clicked
      navLinks.querySelectorAll('.nav-link').forEach(function (link) {
        link.addEventListener('click', function () { navLinks.classList.remove('open'); });
      });
    }
  });
})();
</script>
