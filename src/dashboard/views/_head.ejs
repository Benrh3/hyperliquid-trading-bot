<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — HL Bot</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ── Dark theme (default) ── */
    :root {
      --bg:      #0d1117;
      --surface: #161b22;
      --border:  #30363d;
      --text:    #e6edf3;
      --muted:   #8b949e;
      --green:   #3fb950;
      --red:     #f85149;
      --blue:    #58a6ff;
      --yellow:  #d29922;
      --chart-bg: #161b22;
      /* ── Design-system tokens (global, consumed by Market section) ── */
      --accent:        #38BDF8;
      --accent-dim:    rgba(56,189,248,0.12);
      --accent-border: rgba(56,189,248,0.25);
      --up:            #22C55E;
      --down:          #EF4444;
    }

    /* ── Light theme ── */
    body.light {
      --bg:      #ffffff;
      --surface: #f6f8fa;
      --border:  #d0d7de;
      --text:    #24292f;
      --muted:   #656d76;
      --green:   #1a7f37;
      --red:     #cf222e;
      --blue:    #0969da;
      --yellow:  #9a6700;
      --chart-bg: #f6f8fa;
      --accent:        #0EA5E9;
      --accent-dim:    rgba(14,165,233,0.12);
      --accent-border: rgba(14,165,233,0.25);
      --up:            #16A34A;
      --down:          #DC2626;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 14px;
      line-height: 1.5;
      transition: background .15s, color .15s;
    }

    /* ── Nav ── */
    .nav {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0 1.5rem;
      display: flex;
      align-items: center;
      gap: 0;
      height: 48px;
      position: relative;
    }
    .nav-brand {
      font-weight: 600;
      font-size: 15px;
      color: var(--text);
      margin-right: 1.5rem;
      text-decoration: none;
      flex-shrink: 0;
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 0;
    }
    .nav-link {
      color: var(--muted);
      text-decoration: none;
      padding: 0 0.75rem;
      height: 48px;
      display: flex;
      align-items: center;
      border-bottom: 2px solid transparent;
      font-size: 13px;
      transition: color 0.15s;
      white-space: nowrap;
    }
    .nav-link:hover { color: var(--text); }
    .nav-link.active { color: var(--blue); border-bottom-color: var(--blue); }
    .nav-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 12px;
      color: var(--muted);
      flex-shrink: 0;
    }
    .dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--green);
      display: inline-block;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.4; }
    }

    /* ── Theme toggle ── */
    .theme-btn {
      background: none;
      border: 1px solid var(--border);
      color: var(--muted);
      font-size: 14px;
      line-height: 1;
      padding: 3px 6px;
      border-radius: 4px;
      cursor: pointer;
      transition: color .1s, border-color .1s;
    }
    .theme-btn:hover { color: var(--text); border-color: var(--muted); }

    /* ── Hamburger (mobile) ── */
    .hamburger {
      display: none;
      background: none;
      border: none;
      color: var(--muted);
      font-size: 20px;
      cursor: pointer;
      padding: 4px 6px;
      margin-left: 0.25rem;
    }
    .nav-links.open { display: flex; }

    /* ── Two-tier nav ── */
    .nav-sub {
      height: 40px;
      border-top: none;
    }
    .nav-sub .nav-link { height: 40px; font-size: 12px; }

    /* ── Layout ── */
    .container { max-width: 1100px; margin: 0 auto; padding: 1.5rem; }

    /* ── Stat grid ── */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1rem 1.25rem;
    }
    .card-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      margin-bottom: 0.4rem;
    }
    .card-value {
      font-size: 1.6rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.02em;
    }
    .card-sub {
      font-size: 11px;
      color: var(--muted);
      margin-top: 0.25rem;
    }

    /* ── Section ── */
    .section-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.75rem;
    }

    /* ── Table ── */
    .table-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
      margin-bottom: 1.5rem;
      overflow-x: auto;
    }
    table { width: 100%; border-collapse: collapse; min-width: 500px; }
    th {
      padding: 0.5rem 0.875rem;
      text-align: left;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }
    td {
      padding: 0.5rem 0.875rem;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
      font-variant-numeric: tabular-nums;
    }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(128,128,128,0.04); }
    .empty { padding: 2rem; text-align: center; color: var(--muted); }

    /* ── Badges ── */
    .badge {
      display: inline-block;
      padding: 0.15rem 0.5rem;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
    }
    .badge-info  { background: rgba(88,166,255,0.12);  color: var(--blue);   }
    .badge-warn  { background: rgba(210,153,34,0.12);  color: var(--yellow); }
    .badge-error { background: rgba(248,81,73,0.12);   color: var(--red);    }
    .badge-long  { background: rgba(63,185,80,0.12);   color: var(--green);  }
    .badge-short { background: rgba(248,81,73,0.12);   color: var(--red);    }
    .badge-net   { background: rgba(88,166,255,0.10);  color: var(--blue);   font-size: 10px; }

    /* ── Misc ── */
    .mono { font-family: 'SFMono-Regular', Consolas, monospace; }
    .text-muted { color: var(--muted); }
    .text-green { color: var(--green); }
    .text-red   { color: var(--red);   }

    /* ── Mobile responsive ── */
    @media (max-width: 768px) {
      .container { padding: 1rem 0.75rem; }

      /* Hamburger visible, links hidden by default */
      .hamburger { display: block; }
      .nav-links {
        display: none;
        position: absolute;
        top: 48px;
        left: 0;
        right: 0;
        flex-direction: column;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        z-index: 100;
        padding: 0.5rem 0;
      }
      .nav-links.open { display: flex; }
      .nav-sub { overflow-x: auto; -webkit-overflow-scrolling: touch; height: auto; padding: 0 0.5rem; }
      .nav-sub .nav-links { display: flex; position: static; flex-direction: row; border-bottom: none; padding: 0; background: none; }
      .nav-link {
        height: auto;
        padding: 0.6rem 1.25rem;
        border-bottom: none;
        border-left: 2px solid transparent;
        width: 100%;
      }
      .nav-link.active { border-left-color: var(--blue); border-bottom: none; }

      /* Cards: single column */
      .grid {
        grid-template-columns: 1fr 1fr;
      }
      .card-funding { grid-column: span 2; }
      .card-value { font-size: 1.3rem; }

      /* Nav right: compact */
      .nav-right { gap: 0.25rem; font-size: 11px; }
      .nav-right .text-muted { display: none; }
    }

    @media (max-width: 480px) {
      .grid { grid-template-columns: 1fr; }
      .card-funding { grid-column: span 1; }
    }
  </style>
</head>
<body>
<script>
(function () {
  // Apply saved theme before paint to avoid flash
  const saved = document.cookie.split(';').map((s) => s.trim()).find((s) => s.startsWith('theme='));
  if (saved && saved.split('=')[1] === 'light') document.body.classList.add('light');

  // Wire up theme toggle and hamburger after DOM is ready
  document.addEventListener('DOMContentLoaded', function () {
    // Theme toggle
    const themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
      function updateThemeIcon() {
        themeBtn.textContent = document.body.classList.contains('light') ? '☀' : '☽';
      }
      updateThemeIcon();
      themeBtn.addEventListener('click', function () {
        document.body.classList.toggle('light');
        const isLight = document.body.classList.contains('light');
        document.cookie = 'theme=' + (isLight ? 'light' : 'dark') + ';path=/;max-age=31536000';
        updateThemeIcon();
      });
    }

    // Hamburger menu
    const hamburger = document.getElementById('nav-hamburger');
    const navLinks  = document.getElementById('nav-links');
    if (hamburger && navLinks) {
      hamburger.addEventListener('click', function () {
        navLinks.classList.toggle('open');
      });
      // Close menu when a link is clicked
      navLinks.querySelectorAll('.nav-link').forEach(function (link) {
        link.addEventListener('click', function () { navLinks.classList.remove('open'); });
      });
    }
  });
})();
</script>
