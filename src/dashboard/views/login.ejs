<%- include('_head', { title: 'Login' }) %>

<style>
  .login-page {
    max-width: 360px;
    margin: 4rem auto;
    padding: 0 1.5rem;
  }
  .login-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
  }
  .login-card h1 { font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; }
  .login-field { margin-bottom: 1rem; }
  .login-field label {
    display: block; font-size: 12px; color: var(--muted); margin-bottom: 0.4rem;
  }
  .login-field input {
    width: 100%; padding: 0.5rem 0.6rem; font-size: 13px;
    background: var(--bg); color: var(--text);
    border: 1px solid var(--border); border-radius: 4px;
  }
  .login-error {
    background: rgba(248,81,73,0.1); color: var(--red);
    border: 1px solid rgba(248,81,73,0.25);
    border-radius: 4px; padding: 0.5rem 0.75rem;
    font-size: 12px; margin-bottom: 1rem;
  }
  .login-submit {
    width: 100%; padding: 0.55rem; font-size: 13px; font-weight: 600;
    background: var(--blue); color: #fff; border: none; border-radius: 4px;
    cursor: pointer;
  }
  .login-submit:hover { opacity: 0.9; }
</style>

<nav class="nav">
  <a href="/" class="nav-brand">HL Bot</a>
</nav>

<div class="login-page">
  <div class="login-card">
    <h1>Admin Login</h1>
    <% if (error) { %>
      <div class="login-error"><%= error %></div>
    <% } %>
    <form method="POST" action="/login">
      <div class="login-field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" autofocus required>
      </div>
      <button type="submit" class="login-submit">Log in</button>
    </form>
  </div>
</div>
