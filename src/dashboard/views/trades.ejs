<%- include('_head', { title: 'Trades' }) %>

<style>
  .trades-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--sp-6);
  }
  .trades-page-hdr {
    margin-bottom: var(--sp-5);
  }
  .trades-card {
    background: var(--surface);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }
  .trades-card-hdr {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-5);
    border-bottom: 1px solid var(--border);
  }
  .trades-card-title {
    font-size: var(--t-label); font-weight: 700;
    text-transform: uppercase; letter-spacing: .06em; color: var(--muted);
  }
  .trades-card-meta {
    font-size: var(--t-label); color: var(--muted); margin-left: auto;
  }
  .trades-scroll { overflow-x: auto; }
  .trades-tbl { width: 100%; border-collapse: collapse; min-width: 700px; }
  .trades-tbl th {
    font-size: var(--t-label); font-weight: 600; color: var(--muted);
    text-transform: uppercase; letter-spacing: .04em;
    text-align: left; padding: var(--sp-2) var(--sp-3);
    border-bottom: 1px solid var(--border);
    background: var(--surface); white-space: nowrap;
  }
  .trades-tbl td {
    padding: var(--sp-2) var(--sp-3); font-size: var(--t-body);
    border-bottom: 1px solid var(--border);
    font-variant-numeric: tabular-nums;
  }
  .trades-tbl tbody tr:last-child td { border-bottom: none; }
  .trades-tbl tbody tr:hover td { background: rgba(129,140,248,0.04); }
  .trades-empty {
    padding: var(--sp-6); text-align: center; color: var(--muted); font-size: var(--t-body);
  }
  .trades-load-more {
    padding: var(--sp-4) var(--sp-5);
    border-top: 1px solid var(--border);
    display: flex; align-items: center; gap: var(--sp-3);
  }
  .btn-load {
    background: transparent; border: 1px solid var(--border); color: var(--text);
    font-size: var(--t-label); font-weight: 600; font-family: inherit;
    padding: var(--sp-1) var(--sp-4); border-radius: 4px; cursor: pointer;
    transition: border-color .15s, color .15s;
  }
  .btn-load:hover { border-color: var(--accent); color: var(--accent); }
  .btn-load:disabled { opacity: 0.4; cursor: default; }
</style>

<%- include('_nav') %>

<div class="trades-page">

  <div class="trades-page-hdr">
    <h1 class="page-title">Trades</h1>
  </div>

  <div class="trades-card">
    <div class="trades-card-hdr">
      <span class="trades-card-title">Trade History</span>
      <span class="trades-card-meta" id="trade-count-label">
        Showing <span id="showing-count"><%= trades.length %></span> of <span id="total-count"><%= total %></span>
      </span>
    </div>

    <% if (total === 0) { %>
      <p class="trades-empty" id="empty-msg">No trades recorded yet.</p>
    <% } else { %>
      <div class="trades-scroll">
        <table class="trades-tbl" id="trades-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Time</th>
              <th>Side</th>
              <th>Coin</th>
              <th>Size</th>
              <th>Price</th>
              <th>PnL</th>
              <th>Strategy</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody id="trades-body">
            <% for (const t of trades) { %>
              <tr>
                <td style="color:var(--muted)"><%= t.id %></td>
                <td style="color:var(--muted);white-space:nowrap;font-family:'SFMono-Regular',Consolas,monospace"><%= t.created_at %></td>
                <td><span class="badge badge-<%= t.side %>"><%= t.side %></span></td>
                <td style="font-family:'SFMono-Regular',Consolas,monospace"><%= t.coin %></td>
                <td style="font-family:'SFMono-Regular',Consolas,monospace"><%= t.size %></td>
                <td style="font-family:'SFMono-Regular',Consolas,monospace">$<%= t.price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                <td style="font-family:'SFMono-Regular',Consolas,monospace">
                  <% if (t.pnl !== null) { %>
                    <span class="<%= t.pnl >= 0 ? 'text-green' : 'text-red' %>">
                      <%= t.pnl >= 0 ? '+' : '' %><%= t.pnl.toFixed(2) %>
                    </span>
                  <% } else { %>
                    <span style="color:var(--muted)">—</span>
                  <% } %>
                </td>
                <td><%= t.strategy %></td>
                <td>
                  <% if (t.success) { %>
                    <span class="badge badge-info">ok</span>
                  <% } else { %>
                    <span class="badge badge-error" title="<%= t.error || '' %>">failed</span>
                  <% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>

    <div class="trades-load-more" id="load-more-wrap" style="display:<%= trades.length < total ? 'flex' : 'none' %>">
      <button class="btn-load" id="btn-load-more">Load 100 more</button>
      <span id="load-msg" style="font-size:var(--t-label);color:var(--muted);display:none"></span>
    </div>

  </div>
</div>

<script>
(function () {
  var offset    = <%= trades.length %>;
  var total     = <%= total %>;
  var loading   = false;

  function esc(s) {
    return String(s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function pnlCell(pnl) {
    if (pnl === null || pnl === undefined) return '<span class="text-muted">—</span>';
    var cls = pnl >= 0 ? 'text-green' : 'text-red';
    var prefix = pnl >= 0 ? '+' : '';
    return '<span class="' + cls + '">' + prefix + Number(pnl).toFixed(2) + '</span>';
  }

  function statusCell(success, error) {
    if (success) return '<span class="badge badge-info">ok</span>';
    return '<span class="badge badge-error" title="' + esc(error || '') + '">failed</span>';
  }

  function formatPrice(p) {
    return '$' + Number(p).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function makeRow(t) {
    return '<tr>' +
      '<td class="text-muted">'  + esc(t.id) + '</td>' +
      '<td class="mono text-muted" style="white-space:nowrap">' + esc(t.created_at) + '</td>' +
      '<td><span class="badge badge-' + esc(t.side) + '">' + esc(t.side) + '</span></td>' +
      '<td class="mono">' + esc(t.coin) + '</td>' +
      '<td class="mono">' + esc(t.size) + '</td>' +
      '<td class="mono">' + formatPrice(t.price) + '</td>' +
      '<td class="mono">' + pnlCell(t.pnl) + '</td>' +
      '<td>' + esc(t.strategy) + '</td>' +
      '<td>' + statusCell(t.success, t.error) + '</td>' +
    '</tr>';
  }

  document.getElementById('btn-load-more').addEventListener('click', async function () {
    if (loading) return;
    loading = true;
    var btn = this;
    var msg = document.getElementById('load-msg');
    btn.disabled = true;
    msg.style.display = 'inline';
    msg.textContent = 'Loading…';

    try {
      var resp = await fetch('/api/trades?limit=100&offset=' + offset);
      if (!resp.ok) throw new Error(resp.statusText);
      var data = await resp.json();

      // Ensure the table exists (could have been hidden if total was 0 initially)
      var tbody = document.getElementById('trades-body');
      data.trades.forEach(function (t) {
        tbody.insertAdjacentHTML('beforeend', makeRow(t));
      });

      offset += data.trades.length;
      total   = data.total;

      document.getElementById('showing-count').textContent = offset;
      document.getElementById('total-count').textContent   = total;

      if (!data.hasMore) {
        document.getElementById('load-more-wrap').style.display = 'none';
      }

      msg.style.display = 'none';
    } catch (err) {
      msg.textContent = 'Error: ' + err.message;
    } finally {
      btn.disabled = false;
      loading = false;
    }
  });
})();
</script>
</body>
</html>
