<%- include('_head', { title: 'Trades' }) %>

<nav class="nav">
  <a href="/" class="nav-brand">HL Bot</a>
  <button class="hamburger" id="nav-hamburger" aria-label="Menu">&#9776;</button>
  <div class="nav-links" id="nav-links">
    <a href="/" class="nav-link">Overview</a>
    <a href="/strategies" class="nav-link">Strategies</a>
    <a href="/trades" class="nav-link active">Trades</a>
    <a href="/backtest" class="nav-link">Backtest</a>
  </div>
  <div class="nav-right">
    <span class="dot"></span>
    <span class="text-muted"><%= coin %></span>
    <button class="theme-btn" id="theme-toggle" title="Toggle theme">&#9790;</button>
  </div>
</nav>

<div class="container">

  <p class="section-title">Trade History</p>
  <div class="table-wrap">
    <% if (trades.length === 0) { %>
      <p class="empty">No trades recorded yet.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Time</th>
            <th>Side</th>
            <th>Coin</th>
            <th>Size</th>
            <th>Price</th>
            <th>PnL</th>
            <th>Strategy</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% for (const t of trades) { %>
            <tr>
              <td class="text-muted"><%= t.id %></td>
              <td class="mono text-muted" style="white-space:nowrap"><%= t.created_at %></td>
              <td><span class="badge badge-<%= t.side %>"><%= t.side %></span></td>
              <td class="mono"><%= t.coin %></td>
              <td class="mono"><%= t.size %></td>
              <td class="mono">$<%= t.price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
              <td class="mono">
                <% if (t.pnl !== null) { %>
                  <span class="<%= t.pnl >= 0 ? 'text-green' : 'text-red' %>">
                    <%= t.pnl >= 0 ? '+' : '' %><%= t.pnl.toFixed(2) %>
                  </span>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td><%= t.strategy %></td>
              <td>
                <% if (t.success) { %>
                  <span class="badge badge-info">ok</span>
                <% } else { %>
                  <span class="badge badge-error" title="<%= t.error || '' %>">failed</span>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </div>

</div>

<script>setTimeout(() => location.reload(), 5000)</script>
</body>
</html>
