    });
    su1Circ = su1.addAreaSeries({
      lineColor: '#F59E0B', topColor: 'rgba(245,158,11,0.10)', bottomColor: 'rgba(245,158,11,0)',
      lineWidth: 1, priceFormat: { type: 'volume', precision: 0 },
    });
  }

  function refreshSu1() {
    mountSu1();
    if (!su1) return;
    var meta = document.getElementById('su-chart1-meta');
    fetch('/api/market/history?fields=total_staked_hype,circulating_supply&range=' + sr1.v)
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (d) {
        if (!d.rows || !d.rows.length) { if (meta) meta.textContent = 'no data yet'; return; }
        var sData = [], cData = [];
        d.rows.forEach(function (row) {
          var ts = Math.floor(row.ts / 1000);
          if (row.total_staked_hype !== null && row.total_staked_hype !== undefined)  sData.push({ time: ts, value: row.total_staked_hype });
          if (row.circulating_supply !== null && row.circulating_supply !== undefined) cData.push({ time: ts, value: row.circulating_supply });
        });
        if (sData.length) su1Staked.setData(sData);
        if (cData.length) su1Circ.setData(cData);
        suApplyRange(su1, sr1.v);
        if (meta) meta.textContent = new Date().toLocaleTimeString();
      })
      .catch(function () { if (meta) meta.textContent = 'error'; });
  }

  suBindTfGroup('su-chart1-tf', sr1, refreshSu1);

  // ── Chart 2: Net Staking Flow (signed bars) ──────────────────────────────
  var su2 = null, su2Bars = null, sr2 = { v: '1W' };

  function mountSu2() {
    if (su2) return;
    su2 = suChartBase('su-chart2', 220);
    if (!su2) return;
    su2Bars = su2.addHistogramSeries({ priceFormat: { type: 'volume', precision: 0 } });
  }

  function refreshSu2() {
    mountSu2();
    if (!su2) return;
    var meta = document.getElementById('su-chart2-meta');
    fetch('/api/market/history?fields=staked_delta&range=' + sr2.v)
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (d) {
        if (!d.rows || !d.rows.length) { if (meta) meta.textContent = 'no data yet'; return; }
        var data = [];
        d.rows.forEach(function (row) {
          var ts = Math.floor(row.ts / 1000);
          if (row.staked_delta !== null && row.staked_delta !== undefined)
            data.push({ time: ts, value: row.staked_delta, color: row.staked_delta >= 0 ? '#26C281' : '#E5494D' });
        });
        if (!data.length) { if (meta) meta.textContent = 'no data yet'; return; }
        su2Bars.setData(data);
        suApplyRange(su2, sr2.v);
        if (meta) meta.textContent = new Date().toLocaleTimeString();
      })
      .catch(function () { if (meta) meta.textContent = 'error'; });
  }

  suBindTfGroup('su-chart2-tf', sr2, refreshSu2);

  // ── Chart 3: Unstake Pipeline (3 lines — warming) ────────────────────────
  var su3 = null, su3Q = null, su3M24 = null, su3M72 = null, sr3 = { v: '1W' };

  function mountSu3() {
    if (su3) return;
    su3 = suChartBase('su-chart3', 220);
    if (!su3) return;
    su3Q   = su3.addLineSeries({ color: _accent,  lineWidth: 1, priceFormat: { type: 'volume', precision: 0 } });
    su3M24 = su3.addLineSeries({ color: '#F59E0B', lineWidth: 1, priceFormat: { type: 'volume', precision: 0 } });
    su3M72 = su3.addLineSeries({ color: '#A78BFA', lineWidth: 1, priceFormat: { type: 'volume', precision: 0 } });
  }

  function refreshSu3() {
    mountSu3();
    if (!su3) return;
    var meta = document.getElementById('su-chart3-meta');
    fetch('/api/market/history?fields=unstake_queue_hype,unstake_maturing_24h,unstake_maturing_72h&range=' + sr3.v)
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (d) {
        if (!d.rows || !d.rows.length) { if (meta) meta.textContent = 'warming'; return; }
        var qData = [], m24Data = [], m72Data = [];
        d.rows.forEach(function (row) {
          var ts = Math.floor(row.ts / 1000);
          if (row.unstake_queue_hype !== null && row.unstake_queue_hype !== undefined)    qData.push({ time: ts, value: row.unstake_queue_hype });
          if (row.unstake_maturing_24h !== null && row.unstake_maturing_24h !== undefined) m24Data.push({ time: ts, value: row.unstake_maturing_24h });
          if (row.unstake_maturing_72h !== null && row.unstake_maturing_72h !== undefined) m72Data.push({ time: ts, value: row.unstake_maturing_72h });
        });
        if (!qData.length && !m24Data.length && !m72Data.length) { if (meta) meta.textContent = 'warming'; return; }
        if (qData.length)   su3Q.setData(qData);
        if (m24Data.length) su3M24.setData(m24Data);
        if (m72Data.length) su3M72.setData(m72Data);
        suApplyRange(su3, sr3.v);
        if (meta) meta.textContent = new Date().toLocaleTimeString();
      })
      .catch(function () { if (meta) meta.textContent = 'error'; });
  }

  suBindTfGroup('su-chart3-tf', sr3, refreshSu3);

  // ── Tab activation (lazy init) ────────────────────────────────────────────
  var suInited = false;
  document.querySelector('.market-tab[data-tab="supply"]').addEventListener('click', function () {
    if (suInited) return;
    suInited = true;
    fetchAndRenderCards();
    setTimeout(function () { refreshSu1(); refreshSu2(); refreshSu3(); }, 60);
  });

})();
</script>

<!-- ── Liquidations tab ──────────────────────────────────────────────────── -->
<script>
(function () {
  'use strict';

  // ── Format helpers ───────────────────────────────────────────────────────
  function fmtC(v) {
    if (v === null || v === undefined || !isFinite(v)) return '—';
    var abs = Math.abs(v), sign = v < 0 ? '-' : '';
    if (abs >= 1e9) return sign + (abs / 1e9).toFixed(2) + 'B';
    if (abs >= 1e6) return sign + (abs / 1e6).toFixed(1) + 'M';
    if (abs >= 1e3) return sign + Math.round(abs / 1e3) + 'K';
    return sign + Math.round(abs).toString();
  }
  function fmtSignedC(v) { return (v === null || !isFinite(v)) ? '—' : (v >= 0 ? '+' : '') + fmtC(v); }

  // ── Direction helpers ─────────────────────────────────────────────────────
  function dirBullEps(eps) {
    return function (v) {
      if (v === null || v === undefined || !isFinite(v)) return null;
      if (v > eps)  return { cls: 'val-pos', text: '▲ bullish' };
      if (v < -eps) return { cls: 'val-neg', text: '▼ bearish' };
      return { cls: '', text: '– neutral' };
    };
  }
  function dirBearEps(eps) {
    return function (v) {
      if (v === null || v === undefined || !isFinite(v)) return null;
      if (v > eps)  return { cls: 'val-neg', text: '▼ bearish' };
      if (v < -eps) return { cls: 'val-pos', text: '▲ bullish' };
      return { cls: '', text: '– neutral' };
    };
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  var SRC_CLS = { 'hl-market': 'hlmarket', 'hl-native': 'hlnative', 'on-chain': 'onchain', 'cex-agg': 'cexagg' };

  // ── Tile definitions — two separate arrays, never mixed ───────────────────
  var HL_TILES = [
    { key: 'hl_liq_long_1h',   label: 'FORCED SELLING 1H',   beginner: 'Forced selling 1h (HL)',
      kind: 'window',  source: 'hl-native', fmt: fmtC,       dir: dirBearEps(0), read: null },
    { key: 'hl_liq_short_1h',  label: 'FORCED BUYING 1H',    beginner: 'Forced buying 1h (HL)',
      kind: 'window',  source: 'hl-native', fmt: fmtC,       dir: dirBullEps(0), read: null },
    { key: 'hl_liq_long_24h',  label: 'FORCED SELLING 24H',  beginner: 'Forced selling 24h (HL)',
      kind: 'window',  source: 'hl-native', fmt: fmtC,       dir: dirBearEps(0), read: null },
    { key: 'hl_liq_short_24h', label: 'FORCED BUYING 24H',   beginner: 'Forced buying 24h (HL)',
      kind: 'window',  source: 'hl-native', fmt: fmtC,       dir: dirBullEps(0), read: null },
    { key: 'hl_liq_net_24h',   label: 'FORCED TRADES NET',   beginner: 'Forced trades net (HL)',
      kind: 'window',  source: 'hl-native', fmt: fmtSignedC, dir: dirBullEps(0),
      read: '+ = shorts squeezed (net = short − long); never sum with CEX' },
    { key: 'hl_liq_count_24h', label: 'BLOW-UP EVENTS',      beginner: 'Blow-up events (HL)',
      kind: 'count',   source: 'hl-native', fmt: fmtC,       dir: null, read: null },
  ];

  var CEX_TILES = [
    { key: 'cex_liq_long_1h',   label: 'FORCED SELLING 1H',   beginner: 'Forced selling 1h (CEX)',
      kind: 'window',  source: 'cex-agg', fmt: fmtC,       dir: dirBearEps(0), read: null },
    { key: 'cex_liq_short_1h',  label: 'FORCED BUYING 1H',    beginner: 'Forced buying 1h (CEX)',
      kind: 'window',  source: 'cex-agg', fmt: fmtC,       dir: dirBullEps(0), read: null },
    { key: 'cex_liq_long_24h',  label: 'FORCED SELLING 24H',  beginner: 'Forced selling 24h (CEX)',
      kind: 'window',  source: 'cex-agg', fmt: fmtC,       dir: dirBearEps(0),
      read: 'long-liq = forced SELLS (cascade)' },
    { key: 'cex_liq_short_24h', label: 'FORCED BUYING 24H',   beginner: 'Forced buying 24h (CEX)',
      kind: 'window',  source: 'cex-agg', fmt: fmtC,       dir: dirBullEps(0),
      read: 'short-liq = forced BUYS (squeeze)' },
    { key: 'cex_liq_net_24h',   label: 'FORCED TRADES NET',   beginner: 'Forced trades net (CEX)',
      kind: 'window',  source: 'cex-agg', fmt: fmtSignedC, dir: dirBullEps(0),
      read: '+ = shorts squeezed (bullish thrust); − = longs flushed; undercounts' },
    { key: 'cex_liq_count_24h', label: 'BLOW-UP EVENTS',      beginner: 'Blow-up events (CEX)',
      kind: 'count',   source: 'cex-agg', fmt: fmtC,       dir: null, read: null },
  ];

  // ── Card builder ──────────────────────────────────────────────────────────
  // `filled`: fraction (0-1) of the metric's tracker window that's warm, or
  // null/undefined if this metric isn't tracker-gated. Below MIN_CARD_FILLED
  // the card renders as "warming" (grayed, value hidden) instead of a
  // confident-looking value — a cold tracker's real "0" is indistinguishable
  // from "nothing happened" otherwise (see cex_liq_* restart-reset bug).
  var MIN_CARD_FILLED = 0.8;
  function makeCard(tile, value, filled) {
    var isWarming = typeof filled === 'number' && filled < MIN_CARD_FILLED;
    var val     = (!isWarming && value !== null && value !== undefined) ? tile.fmt(value) : '—';
    var dirInfo = (!isWarming && tile.dir && value !== null && value !== undefined) ? tile.dir(value) : null;
    var valCls  = dirInfo && dirInfo.cls ? ' ' + dirInfo.cls : '';
    var dirCls  = dirInfo ? (dirInfo.cls ? ' sc-dir-' + dirInfo.cls.replace('val-', '') : ' sc-dir-neutral') : '';
    var srcCls  = SRC_CLS[tile.source] || '';
    var ib = tile.read
      ? '<button class="sc-info-btn" data-tip="' + esc(tile.read) + '" aria-label="About ' + esc(tile.label) + '">&#9432;</button>'
      : '';
    var rd = tile.read ? '<div class="sc-read" style="display:none">' + esc(tile.read) + '</div>' : '';
    var subLabel = isWarming ? '<div class="sc-dir sc-dir-neutral">warming</div>'
      : (dirInfo ? '<div class="sc-dir' + dirCls + '">' + esc(dirInfo.text) + '</div>' : '');
    return '<div class="signal-card' + (isWarming ? ' warming' : '') + '" data-key="' + esc(tile.key) + '">'
      + '<div class="sc-header">'
      +   '<span class="sc-label" data-expert="' + esc(tile.label) + '" data-beginner="' + esc(tile.beginner) + '">' + esc(tile.label) + '</span>'
      +   ib
      + '</div>'
      + '<div class="sc-value' + valCls + '">' + esc(val) + '</div>'
      + subLabel
      + rd
      + '<div class="sc-badges">'
      +   '<span class="sc-badge sc-kind sc-kind-' + esc(tile.kind) + '">' + esc(tile.kind) + '</span>'
      +   '<span class="sc-badge sc-source sc-src-' + esc(srcCls) + '">' + esc(tile.source) + '</span>'
      + '</div>'
      + '</div>';
  }

  // ── Signals fetch → render BOTH blocks ────────────────────────────────────
  function fetchAndRenderCards() {
    fetch('/api/market/signals?subtab=liquidations')
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (d) {
        var vm = {};
        var filledMap = {};
        (d.signals || []).forEach(function (s) { vm[s.key] = s.currentValue; filledMap[s.key] = s.filled; });
        var hlHtml = HL_TILES.map(function (t) {
          return makeCard(t, vm[t.key] !== undefined ? vm[t.key] : null, filledMap[t.key]);
        }).join('');
        var cexHtml = CEX_TILES.map(function (t) {
          return makeCard(t, vm[t.key] !== undefined ? vm[t.key] : null, filledMap[t.key]);
        }).join('');
        document.getElementById('lq-hl-cards-grid').innerHTML = hlHtml;
        document.getElementById('lq-cex-cards-grid').innerHTML = cexHtml;
        if (window.MKT && window.MKT.applyBeginner) window.MKT.applyBeginner();
      })
      .catch(function () {
        var err = '<p style="color:var(--muted);font-size:var(--t-body);padding:var(--sp-3)">Could not load signals.</p>';
        document.getElementById('lq-hl-cards-grid').innerHTML = err;
        document.getElementById('lq-cex-cards-grid').innerHTML = err;
      });
  }

  // ── Chart infrastructure ──────────────────────────────────────────────────
  var _border = 'rgba(56,189,248,0.09)';
  var _accent = '#38BDF8';
  var _gridC  = 'rgba(56,189,248,0.05)';
  var _muted  = '#3D5A78';

  function lqChartBase(containerId, h) {
    var LC = window.LightweightCharts;
    if (!LC) return null;
    return LC.createChart(document.getElementById(containerId), {
      autoSize: true, height: h || 220,
      layout: { background: { type: 'solid', color: '#0D1520' }, textColor: _muted, attributionLogo: false },
      grid:   { vertLines: { color: _gridC, style: 1 }, horzLines: { color: _gridC, style: 1 } },
      crosshair: {
        mode: 0,
        vertLine: { color: _accent, width: 1, style: 1, labelBackgroundColor: _accent },
        horzLine: { color: _accent, width: 1, style: 1, labelBackgroundColor: _accent },
      },
      rightPriceScale: { borderColor: _border },
      timeScale: { borderColor: _border, timeVisible: true, secondsVisible: false },
    });
  }
  function lqApplyRange(chart, rangeKey) {
    if (rangeKey === 'All') { chart.timeScale().fitContent(); return; }
    var secs = { '1D': 86400, '1W': 604800, '1M': 2592000, '3M': 7776000 }[rangeKey];
    if (secs) {
      var now = Math.floor(Date.now() / 1000);
      chart.timeScale().setVisibleRange({ from: now - secs, to: now + 3600 });
    }
  }
  function lqBindTfGroup(groupId, rangeRef, refreshFn) {
    document.getElementById(groupId).addEventListener('click', function (e) {
      var btn = e.target.closest('[data-range]');
      if (!btn) return;
      rangeRef.v = btn.getAttribute('data-range');
      document.querySelectorAll('#' + groupId + ' .tf').forEach(function (b) {
        b.classList.toggle('active', b === btn);
      });
      refreshFn();
    });
  }

  // ── Chart 1: HL Forced Flow (warming) ─────────────────────────────────────
  var lq1 = null, lq1Long = null, lq1Short = null, lr1 = { v: '1W' };

  function mountLq1() {
    if (lq1) return;
    lq1 = lqChartBase('lq-chart1', 220);
    if (!lq1) return;
    lq1Long  = lq1.addAreaSeries({
      lineColor: '#E5494D', topColor: 'rgba(229,73,77,0.14)', bottomColor: 'rgba(229,73,77,0)',
      lineWidth: 1, priceFormat: { type: 'volume', precision: 0 },
    });
    lq1Short = lq1.addAreaSeries({
      lineColor: '#26C281', topColor: 'rgba(38,194,129,0.14)', bottomColor: 'rgba(38,194,129,0)',
      lineWidth: 1, priceFormat: { type: 'volume', precision: 0 },
    });
  }

  function refreshLq1() {
    mountLq1();
    if (!lq1) return;
    var meta = document.getElementById('lq-chart1-meta');
    fetch('/api/market/history?fields=hl_liq_long_24h,hl_liq_short_24h&range=' + lr1.v)
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (d) {
        if (!d.rows || !d.rows.length) { if (meta) meta.textContent = 'warming'; return; }
        var lData = [], sData = [];
        d.rows.forEach(function (row) {
          var ts = Math.floor(row.ts / 1000);
          if (row.hl_liq_long_24h !== null && row.hl_liq_long_24h !== undefined)  lData.push({ time: ts, value: row.hl_liq_long_24h });
          if (row.hl_liq_short_24h !== null && row.hl_liq_short_24h !== undefined) sData.push({ time: ts, value: row.hl_liq_short_24h });
        });
        if (!lData.length && !sData.length) { if (meta) meta.textContent = 'warming'; return; }
        if (lData.length) lq1Long.setData(lData);
        if (sData.length) lq1Short.setData(sData);
        lqApplyRange(lq1, lr1.v);
        if (meta) meta.textContent = new Date().toLocaleTimeString();
      })
      .catch(function () { if (meta) meta.textContent = 'error'; });
  }

  lqBindTfGroup('lq-chart1-tf', lr1, refreshLq1);

  // ── Chart 2: CEX Forced Flow ──────────────────────────────────────────────
  var lq2 = null, lq2Long = null, lq2Short = null, lr2 = { v: '1W' };

  function mountLq2() {
    if (lq2) return;
    lq2 = lqChartBase('lq-chart2', 220);
    if (!lq2) return;
    lq2Long  = lq2.addAreaSeries({
      lineColor: '#E5494D', topColor: 'rgba(229,73,77,0.14)', bottomColor: 'rgba(229,73,77,0)',
      lineWidth: 1, priceFormat: { type: 'volume', precision: 0 },
    });
    lq2Short = lq2.addAreaSeries({
      lineColor: '#26C281', topColor: 'rgba(38,194,129,0.14)', bottomColor: 'rgba(38,194,129,0)',
      lineWidth: 1, priceFormat: { type: 'volume', precision: 0 },
    });
  }

  function refreshLq2() {
    mountLq2();
    if (!lq2) return;
    var meta = document.getElementById('lq-chart2-meta');
    fetch('/api/market/history?fields=cex_liq_long_24h,cex_liq_short_24h&range=' + lr2.v)
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (d) {
        if (!d.rows || !d.rows.length) { if (meta) meta.textContent = 'no data yet'; return; }
        var lData = [], sData = [];
        d.rows.forEach(function (row) {
          var ts = Math.floor(row.ts / 1000);
          if (row.cex_liq_long_24h !== null && row.cex_liq_long_24h !== undefined)  lData.push({ time: ts, value: row.cex_liq_long_24h });
          if (row.cex_liq_short_24h !== null && row.cex_liq_short_24h !== undefined) sData.push({ time: ts, value: row.cex_liq_short_24h });
        });
        if (lData.length) lq2Long.setData(lData);
        if (sData.length) lq2Short.setData(sData);
        lqApplyRange(lq2, lr2.v);
        if (meta) meta.textContent = new Date().toLocaleTimeString();
      })
      .catch(function () { if (meta) meta.textContent = 'error'; });
  }

  lqBindTfGroup('lq-chart2-tf', lr2, refreshLq2);

  // ── Chart 3: Blow-up Events — HL vs CEX (counts OK to compare) ───────────
  var lq3 = null, lq3Hl = null, lq3Cex = null, lr3 = { v: '1W' };

  function mountLq3() {
    if (lq3) return;
    lq3 = lqChartBase('lq-chart3', 220);
    if (!lq3) return;
    lq3Hl  = lq3.addLineSeries({ color: _accent,  lineWidth: 1, priceFormat: { type: 'volume', precision: 0 } });
    lq3Cex = lq3.addLineSeries({ color: '#F59E0B', lineWidth: 1, priceFormat: { type: 'volume', precision: 0 } });
  }

  function refreshLq3() {
    mountLq3();
    if (!lq3) return;
    var meta = document.getElementById('lq-chart3-meta');
    fetch('/api/market/history?fields=hl_liq_count_24h,cex_liq_count_24h&range=' + lr3.v)
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (d) {
        if (!d.rows || !d.rows.length) { if (meta) meta.textContent = 'no data yet'; return; }
        var hlData = [], cexData = [];
        d.rows.forEach(function (row) {
          var ts = Math.floor(row.ts / 1000);
          if (row.hl_liq_count_24h !== null && row.hl_liq_count_24h !== undefined)  hlData.push({ time: ts, value: row.hl_liq_count_24h });
          if (row.cex_liq_count_24h !== null && row.cex_liq_count_24h !== undefined) cexData.push({ time: ts, value: row.cex_liq_count_24h });
        });
        if (hlData.length)  lq3Hl.setData(hlData);
        if (cexData.length) lq3Cex.setData(cexData);
        lqApplyRange(lq3, lr3.v);
        if (meta) meta.textContent = new Date().toLocaleTimeString();
      })
      .catch(function () { if (meta) meta.textContent = 'error'; });
  }

  lqBindTfGroup('lq-chart3-tf', lr3, refreshLq3);

  // ── Tab activation (lazy init) ────────────────────────────────────────────
  var lqInited = false;
  document.querySelector('.market-tab[data-tab="liquidations"]').addEventListener('click', function () {
    if (lqInited) return;
    lqInited = true;
    fetchAndRenderCards();
    setTimeout(function () { refreshLq1(); refreshLq2(); refreshLq3(); }, 60);
  });

})();
</script>

<!-- ── Signals tab (scorecard table) ─────────────────────────────────────── -->
<script>
(function () {
  'use strict';

  var HORIZONS = [4, 24, 72, 168];
  var MIN_N_PROVEN = 20;
  var IC_PROVEN = 0.10;
  var LIQ_KEYS = ['hl_liq_long_1h','hl_liq_long_24h','hl_liq_short_1h','hl_liq_short_24h',
    'hl_liq_net_24h','cex_liq_long_1h','cex_liq_long_24h','cex_liq_short_1h','cex_liq_short_24h','cex_liq_net_24h'];

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // Derive family from dir string: dirBear* → 'bear', dirBull* → 'bull', null → null
  function dirFamily(dirStr) {
    if (!dirStr) return null;
    if (dirStr.indexOf('Bear') !== -1 || dirStr.indexOf('bear') !== -1) return 'bear';
    if (dirStr.indexOf('Bull') !== -1 || dirStr.indexOf('bull') !== -1) return 'bull';
    return null;
  }

  // Expected IC sign: bear-mapped signals should have negative IC, bull-mapped positive
  function expectedSign(family) {
    if (family === 'bear') return -1;
    if (family === 'bull') return +1;
    return 0;
  }

  var sigData = null; // { signals, cells } after fetch
  var sortHz = 24;
  var filterFam = 'all';

  function fetchData() {
    Promise.all([
      fetch('/api/market/scorecard?format=json').then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); }),
      fetch('/api/market/signals').then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); }),
    ]).then(function (results) {
      var sc = results[0], sg = results[1];
      sigData = { cells: sc.cells || [], signals: sg.signals || [] };
      render();
    }).catch(function () {
      document.getElementById('sig-tbody').innerHTML =
        '<tr><td colspan="7" style="color:var(--muted);padding:var(--sp-4)">Could not load scorecard.</td></tr>';
    });
  }

  function render() {
    if (!sigData) return;

    // Build lookup: signal key → { dir, label, subtab }
    var meta = {};
    sigData.signals.forEach(function (s) { meta[s.key] = s; });

    // Build lookup: signal+horizon → cell
    var cellMap = {};
    sigData.cells.forEach(function (c) {
      cellMap[c.signal + ':' + c.horizon_h] = c;
    });

    // Unique scored signal keys (from cells)
    var keysSeen = {};
    var keys = [];
    sigData.cells.forEach(function (c) {
      if (!keysSeen[c.signal]) { keysSeen[c.signal] = true; keys.push(c.signal); }
    });

    // Enrich with family
    var rows = keys.map(function (key) {
      var m = meta[key] || {};
      var family = dirFamily(m.dir);
      return { key: key, label: m.label || key, dir: m.dir || null, family: family, subtab: m.subtab || '' };
    });

    // Filter
    if (filterFam !== 'all') {
      rows = rows.filter(function (r) { return r.family === filterFam; });
    }

    // Sort by |IC| on selected horizon (strongest first)
    rows.sort(function (a, b) {
      var ca = cellMap[a.key + ':' + sortHz];
      var cb = cellMap[b.key + ':' + sortHz];
      var ai = ca && ca.ic !== null ? Math.abs(ca.ic) : -1;
      var bi = cb && cb.ic !== null ? Math.abs(cb.ic) : -1;
      return bi - ai;
    });

    // Group into families
    var bearRows = rows.filter(function (r) { return r.family === 'bear'; });
    var bullRows = rows.filter(function (r) { return r.family === 'bull'; });
    var nullRows = rows.filter(function (r) { return r.family === null; });

    var html = '';

    function renderGroup(label, groupRows) {
      if (!groupRows.length) return;
      html += '<tr class="fam-head"><td colspan="7">' + esc(label) + '</td></tr>';
      groupRows.forEach(function (r) { html += renderRow(r, cellMap); });
    }

    if (filterFam === 'all') {
      renderGroup('Contrarian / sell-pressure (expect IC −)', bearRows);
      renderGroup('Flow / follow / accumulation (expect IC +)', bullRows);
      if (nullRows.length) renderGroup('Unclassified', nullRows);
    } else {
      rows.forEach(function (r) { html += renderRow(r, cellMap); });
    }

    if (!html) html = '<tr><td colspan="7" style="color:var(--muted);padding:var(--sp-4)">No scored signals.</td></tr>';
    document.getElementById('sig-tbody').innerHTML = html;
  }

  function renderRow(r, cellMap) {
    var dirLabel = r.family === 'bear' ? '▼ bear' : r.family === 'bull' ? '▲ bull' : '–';
    var dirCls = r.family === 'bear' ? 'ic-neg' : r.family === 'bull' ? 'ic-pos' : '';

    // Reconciliation: check the sort horizon's IC against expected sign
    var reconHtml = reconCell(r, cellMap);

    var out = '<tr>';
    out += '<td><span class="sig-key">' + esc(r.key) + '</span><span class="sig-sub">' + esc(r.subtab) + '</span></td>';
    out += '<td class="' + dirCls + '" style="font-size:var(--t-label);font-weight:600">' + esc(dirLabel) + '</td>';

    HORIZONS.forEach(function (h) {
      var c = cellMap[r.key + ':' + h];
      out += icCell(c);
    });

    out += '<td>' + reconHtml + '</td>';
    out += '</tr>';
    return out;
  }

  function icCell(c) {
    if (!c || c.ic === null) {
      var nLabel = c ? c.n.toString() : '0';
      return '<td class="td-ic ic-warming" title="n=' + nLabel + ' (warming)">—</td>';
    }
    var proven = c.n >= MIN_N_PROVEN && Math.abs(c.ic) >= IC_PROVEN;
    var cls = proven ? 'ic-proven' : 'ic-warming';
    var colorCls = c.ic > 0 ? ' ic-pos' : c.ic < 0 ? ' ic-neg' : '';
    var tip = 'IC=' + c.ic.toFixed(3) + '  n=' + c.n + '  hit=' + (c.hit_rate !== null ? (c.hit_rate * 100).toFixed(1) + '%' : '?');
    return '<td class="td-ic ' + cls + colorCls + '" title="' + esc(tip) + '">'
      + c.ic.toFixed(3)
      + '<span style="display:block;font-size:9px;opacity:.6;font-weight:400">n=' + c.n + '</span>'
      + '</td>';
  }

  function reconCell(r, cellMap) {
    if (!r.family) return '<span class="recon-na">–</span>';
    // Check all horizons — flag if ANY proven cell disagrees
    var anyProven = false;
    var anyMismatch = false;
    var exp = expectedSign(r.family);
    var isLiq = LIQ_KEYS.indexOf(r.key) !== -1;

    HORIZONS.forEach(function (h) {
      var c = cellMap[r.key + ':' + h];
      if (!c || c.ic === null) return;
      var proven = c.n >= MIN_N_PROVEN && Math.abs(c.ic) >= IC_PROVEN;
      if (!proven) return;
      anyProven = true;
      if (exp !== 0 && Math.sign(c.ic) !== 0 && Math.sign(c.ic) !== exp) anyMismatch = true;
    });

    if (!anyProven) return '<span class="recon-na">warming</span>';
    if (anyMismatch && isLiq) return '<span class="recon-warn" title="Opposite IC — likely capitulation/contrarian effect, NOT a mapping error">⚠ contrarian?</span>';
    if (anyMismatch) return '<span class="recon-warn" title="Measured IC sign opposes the mapped direction — possible inversion">⚠ check dir</span>';
    return '<span class="recon-ok" title="IC sign matches expected direction">✓</span>';
  }

  // ── Controls ──────────────────────────────────────────────────────────────
  document.getElementById('sig-sort-hz').addEventListener('change', function (e) {
    sortHz = parseInt(e.target.value, 10);
    render();
  });

  document.getElementById('sig-controls').addEventListener('click', function (e) {
    var btn = e.target.closest('[data-fam]');
    if (!btn) return;
    filterFam = btn.getAttribute('data-fam');
    document.querySelectorAll('#sig-controls [data-fam]').forEach(function (b) {
      b.classList.toggle('active', b === btn);
    });
    render();
  });

  // ── Tab activation (lazy init) ────────────────────────────────────────────
  var sigInited = false;
  document.querySelector('.market-tab[data-tab="signals"]').addEventListener('click', function () {
    if (sigInited) return;
    sigInited = true;
    fetchData();
  });

})();
</script>

<!-- ── Time Machine tab ──────────────────────────────────────────────────── -->
<script>
(function () {
  'use strict';

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function fmtPct(v) { return (v >= 0 ? '+' : '') + (v * 100).toFixed(2) + '%'; }
  function fmtTs(ms) { return new Date(ms).toLocaleString('en-GB', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit', hour12:false }); }

  function fmtMetric(key, v) {
    if (v === null || v === undefined || !isFinite(v)) return '—';
    if (key === 'perp_mark_px') return '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (key === 'funding_rate') return (v >= 0 ? '+' : '') + (v * 100).toFixed(4) + '%';
    if (key === 'book_imbalance') return (v >= 0 ? '+' : '') + v.toFixed(3);
    var abs = Math.abs(v), sign = v < 0 ? '-' : '';
    if (abs >= 1e6) return sign + (abs / 1e6).toFixed(1) + 'M';
    if (abs >= 1e3) return sign + Math.round(abs / 1e3) + 'K';
    return sign + Math.round(abs).toString();
  }

  var METRIC_LABELS = {
    perp_mark_px: 'Price', funding_rate: 'Funding', open_interest: 'OI',
    cvd_perp_24h: 'CVD 24h', cex_net_flow_hype: 'CEX Flow', total_staked_hype: 'Staked',
    book_imbalance: 'Imbalance',
  };

  var slider   = document.getElementById('tm-slider');
  var tsLabel  = document.getElementById('tm-ts-label');
  var range    = null; // { oldest, newest }
  var tmChart  = null;
  var tmLine   = null;
  var tmMarkers = [];
  var debounceTimer = null;

  function sliderToTs() {
    if (!range) return Date.now();
    var pct = parseInt(slider.value, 10) / 100;
    return Math.round(range.oldest + pct * (range.newest - range.oldest));
  }

  function tsToSlider(ts) {
    if (!range || range.newest === range.oldest) return 100;
    return Math.round(((ts - range.oldest) / (range.newest - range.oldest)) * 100);
  }

  function loadReplay(ts) {
    tsLabel.textContent = fmtTs(ts);
    fetch('/api/market/replay?ts=' + ts)
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (d) {
        if (d.error) { tsLabel.textContent = d.error; return; }
        if (d.range) range = d.range;
        renderTally(d.tally);
        renderKeyMetrics(d.keyMetrics);
        renderChart(d.chartWindow, d.snapshotTs, d.priceAtTs);
        renderReturns(d.forwardReturns, d.tally);
        tsLabel.textContent = fmtTs(d.snapshotTs);
        slider.value = tsToSlider(d.snapshotTs);
      })
      .catch(function () { tsLabel.textContent = 'error'; });
  }

  function renderTally(t) {
    var total = t.bull + t.bear + t.neutral;
    var thin = total < 10;
    document.getElementById('tm-tally').innerHTML =
      '<span style="color:var(--up);font-weight:600">▲ ' + t.bull + ' bull</span>'
      + ' · <span style="color:var(--down);font-weight:600">▼ ' + t.bear + ' bear</span>'
      + ' · <span style="color:var(--muted)">' + t.neutral + ' neutral</span>'
      + '<div style="font-size:var(--t-label);color:var(--muted);margin-top:var(--sp-1)">'
      + 'Based on ' + total + ' signals available at that moment'
      + (thin ? ' — early replays are thin; a match here is weak evidence.' : ' — all carried low confidence.')
      + '</div>';
  }

  function renderKeyMetrics(km) {
    var el = document.getElementById('tm-key-metrics');
    var html = '';
    Object.keys(METRIC_LABELS).forEach(function (k) {
      html += '<div style="background:var(--surface);border-radius:6px;padding:var(--sp-2) var(--sp-3);min-width:100px">'
        + '<div style="font-size:var(--t-label);color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.06em">' + esc(METRIC_LABELS[k]) + '</div>'
        + '<div style="font-size:var(--t-value-sm);color:#fff;font-weight:600;margin-top:2px">' + esc(fmtMetric(k, km[k])) + '</div>'
        + '</div>';
    });
    el.innerHTML = html;
  }

  function renderChart(points, snapTs, snapPx) {
    var LC = window.LightweightCharts;
    if (!LC) return;
    var container = document.getElementById('tm-chart');
    if (!tmChart) {
      tmChart = LC.createChart(container, {
        autoSize: true, height: 200,
        layout: { background: { type: 'solid', color: '#0D1520' }, textColor: '#3D5A78', attributionLogo: false },
        grid: { vertLines: { color: 'rgba(56,189,248,0.05)', style: 1 }, horzLines: { color: 'rgba(56,189,248,0.05)', style: 1 } },
        crosshair: { mode: 0, vertLine: { color: '#38BDF8', width: 1, style: 1 }, horzLine: { color: '#38BDF8', width: 1, style: 1 } },
        rightPriceScale: { borderColor: 'rgba(56,189,248,0.09)' },
        timeScale: { borderColor: 'rgba(56,189,248,0.09)', timeVisible: true },
      });
      tmLine = tmChart.addLineSeries({ color: '#38BDF8', lineWidth: 1, priceFormat: { type: 'price', precision: 2 } });
    }
    var data = points.filter(function (p) { return p.px !== null; })
      .map(function (p) { return { time: Math.floor(p.ts / 1000), value: p.px }; });
    if (data.length) {
      tmLine.setData(data);
      if (snapPx !== null) {
        tmLine.setMarkers([{
          time: Math.floor(snapTs / 1000), position: 'aboveBar', shape: 'circle',
          color: '#F59E0B', text: 'NOW',
        }]);
      }
      tmChart.timeScale().fitContent();
    }
    document.getElementById('tm-chart-meta').textContent = data.length ? fmtTs(snapTs) : 'no data';
  }

  function renderReturns(fr, tally) {
    var el = document.getElementById('tm-returns');
    var lean = tally.bull > tally.bear ? 'bullish' : tally.bear > tally.bull ? 'bearish' : 'neutral';
    var HZ_LABELS = { '4h': '4h', '24h': '1d', '72h': '3d', '168h': '7d' };
    var HORIZONS = ['4h', '24h', '72h', '168h'];
    var html = '';
    HORIZONS.forEach(function (h) {
      var ret = fr[h];
      var retStr, verdictStr, verdictCls, icon;
      if (ret === null) {
        retStr = '—'; verdictStr = 'in progress'; verdictCls = 'color:var(--muted)'; icon = '';
      } else {
        retStr = fmtPct(ret);
        var retDir = ret > 0.005 ? 'bullish' : ret < -0.005 ? 'bearish' : 'flat';
        if (lean === 'neutral' || retDir === 'flat') {
          verdictStr = 'inconclusive'; verdictCls = 'color:var(--muted)'; icon = '– ';
        } else if (lean === retDir) {
          verdictStr = 'read confirmed'; verdictCls = 'color:var(--up)'; icon = '✓ ';
        } else {
          verdictStr = 'read missed'; verdictCls = 'color:var(--down)'; icon = '✗ ';
        }
      }
      var retCls = ret === null ? '' : ret > 0 ? 'color:var(--up)' : ret < 0 ? 'color:var(--down)' : '';
      html += '<div style="background:var(--surface);border-radius:6px;padding:var(--sp-3)">'
        + '<div style="font-size:var(--t-label);color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.06em">' + esc(HZ_LABELS[h] || h) + ' forward</div>'
        + '<div style="font-size:var(--t-value-sm);font-weight:600;margin:var(--sp-1) 0;' + retCls + '">' + esc(retStr) + '</div>'
        + '<div style="font-size:var(--t-label);' + verdictCls + '">'
        + icon + (lean !== 'neutral' ? 'leaned ' + lean + ' · ' : '')
        + esc(verdictStr)
        + '</div></div>';
    });
    el.innerHTML = html;
  }

  // ── Controls ──────────────────────────────────────────────────────────────
  slider.addEventListener('input', function () {
    clearTimeout(debounceTimer);
    var ts = sliderToTs();
    tsLabel.textContent = fmtTs(ts) + ' …';
    debounceTimer = setTimeout(function () { loadReplay(ts); }, 250);
  });

  document.getElementById('tm-j-24h').addEventListener('click', function () {
    loadReplay(Date.now() - 24 * 3600000);
  });
  document.getElementById('tm-j-7d').addEventListener('click', function () {
    loadReplay(Date.now() - 7 * 24 * 3600000);
  });
  document.getElementById('tm-j-latest').addEventListener('click', function () {
    loadReplay(Date.now());
  });

  // ── Tab activation ────────────────────────────────────────────────────────
  var tmInited = false;
  document.querySelector('.market-tab[data-tab="timemachine"]').addEventListener('click', function () {
    if (tmInited) return;
    tmInited = true;
    loadReplay(Date.now() - 7 * 24 * 3600000);
  });

})();
</script>

<!-- ── Data tab ───────────────────────────────────────────────────────────── -->
<script>
(function () {
  'use strict';

  var DEFAULT_COLS = [
    'perp_mark_px','funding_rate','open_interest','cvd_perp_24h','cvd_spot_24h',
    'cex_net_flow_hype','total_staked_hype','book_imbalance','book_spread_bps',
    'cex_liq_long_24h','cex_liq_short_24h','cex_liq_net_24h',
  ];
  var PAGE_SIZE = 50;
  var dataRange = '1D';
  var dataPage  = 0;
  var allRows   = [];
  var cols      = DEFAULT_COLS.slice();

  function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function fmtTs(ms) {
    return new Date(ms).toLocaleString('en-GB', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit', hour12:false });
  }

  function fmtVal(v) {
    if (v === null || v === undefined || !isFinite(v)) return '—';
    var abs = Math.abs(v);
    if (abs >= 1e9) return (v < 0 ? '-' : '') + (abs / 1e9).toFixed(2) + 'B';
    if (abs >= 1e6) return (v < 0 ? '-' : '') + (abs / 1e6).toFixed(1) + 'M';
    if (abs >= 1e3) return (v < 0 ? '-' : '') + Math.round(abs / 1e3) + 'K';
    if (abs < 0.01 && abs > 0) return v.toFixed(6);
    if (abs < 1) return v.toFixed(4);
    return v.toFixed(2);
  }

  function fetchData() {
    var fields = cols.join(',');
    fetch('/api/market/history?fields=' + fields + '&range=' + dataRange)
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (d) {
        allRows = (d.rows || []).slice().reverse(); // newest first
        dataPage = 0;
        renderTable();
      })
      .catch(function () {
        document.getElementById('data-tbody').innerHTML = '<tr><td colspan="' + (cols.length + 1) + '" style="color:var(--muted)">Error loading data.</td></tr>';
      });
  }

  function renderTable() {
    // Header
    var hdr = '<tr><th>Time</th>';
    cols.forEach(function (c) { hdr += '<th>' + esc(c) + '</th>'; });
    hdr += '</tr>';
    document.getElementById('data-thead').innerHTML = hdr;

    // Body (paged)
    var start = dataPage * PAGE_SIZE;
    var page  = allRows.slice(start, start + PAGE_SIZE);
    var body  = '';
    page.forEach(function (row) {
      body += '<tr><td>' + fmtTs(row.ts) + '</td>';
      cols.forEach(function (c) { body += '<td>' + esc(fmtVal(row[c])) + '</td>'; });
      body += '</tr>';
    });
    if (!body) body = '<tr><td colspan="' + (cols.length + 1) + '" style="color:var(--muted)">No data for this range.</td></tr>';
    document.getElementById('data-tbody').innerHTML = body;

    // Pager
    var totalPages = Math.max(1, Math.ceil(allRows.length / PAGE_SIZE));
    var pagerHtml = '';
    if (totalPages > 1) {
      pagerHtml += '<button class="tf' + (dataPage === 0 ? '" disabled' : '"') + ' id="data-prev">&laquo; Prev</button>';
      pagerHtml += '<span style="color:var(--muted);font-size:var(--t-label)">' + (dataPage + 1) + ' / ' + totalPages + '</span>';
      pagerHtml += '<button class="tf' + (dataPage >= totalPages - 1 ? '" disabled' : '"') + ' id="data-next">Next &raquo;</button>';
    }
    document.getElementById('data-pager').innerHTML = pagerHtml;
  }

  // ── Controls ──────────────────────────────────────────────────────────────
  document.getElementById('data-controls').addEventListener('click', function (e) {
    var btn = e.target.closest('[data-dr]');
    if (!btn) return;
    dataRange = btn.getAttribute('data-dr');
    document.querySelectorAll('#data-controls [data-dr]').forEach(function (b) { b.classList.toggle('active', b === btn); });
    fetchData();
  });

  document.getElementById('data-pager').addEventListener('click', function (e) {
    if (e.target.id === 'data-prev' && dataPage > 0) { dataPage--; renderTable(); }
    if (e.target.id === 'data-next') { dataPage++; renderTable(); }
  });

  // ── Tab activation ────────────────────────────────────────────────────────
  var dataInited = false;
  document.querySelector('.market-tab[data-tab="data"]').addEventListener('click', function () {
    if (dataInited) return;
    dataInited = true;
    fetchData();
  });

})();
</script>

<!-- ── Glossary tab ──────────────────────────────────────────────────────── -->
<script>
(function () {
  'use strict';

  function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  var allMetrics = [];
  var searchTerm = '';
  var filterTab  = 'all';

  function dirReadLabel(dirStr) {
    if (!dirStr) return '<span style="color:var(--muted)">neutral level</span>';
    if (/BearPos/i.test(dirStr)) return '<span style="color:var(--down)">high = bearish (contrarian/sell-pressure)</span>';
    if (/BullPos/i.test(dirStr)) return '<span style="color:var(--up)">high = bullish (follow/accumulation)</span>';
    var m = dirStr.match(/Bear.*?High.*?\|?([\d.]+)/i);
    if (m) return '<span style="color:var(--down)">above ' + m[1] + ' = bearish (contrarian)</span>';
    m = dirStr.match(/Bull.*?High.*?\|?([\d.]+)/i);
    if (m) return '<span style="color:var(--up)">above ' + m[1] + ' = bullish (follow)</span>';
    return '<span style="color:var(--muted)">directional (see read)</span>';
  }

  function fetchManifest() {
    fetch('/api/market/manifest')
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (d) {
        allMetrics = d.metrics || [];
        render();
      })
      .catch(function () {
        document.getElementById('gls-entries').innerHTML = '<p style="color:var(--muted);padding:var(--sp-3)">Could not load manifest.</p>';
      });
  }

  function render() {
    var filtered = allMetrics.filter(function (m) {
      if (filterTab !== 'all' && m.subtab !== filterTab) return false;
      if (searchTerm) {
        var q = searchTerm.toLowerCase();
        return (m.key + ' ' + m.label + ' ' + (m.beginnerLabel || '') + ' ' + (m.read || '')).toLowerCase().indexOf(q) !== -1;
      }
      return true;
    });

    var html = '';
    filtered.forEach(function (m) {
      html += '<div class="gls-entry">';
      html += '<span class="gls-entry-key">' + esc(m.key) + '</span>';
      html += '<span class="gls-entry-label">' + esc(m.label) + '</span>';
      if (m.beginnerLabel) html += '<div style="font-size:var(--t-label);color:var(--muted);margin-top:2px">' + esc(m.beginnerLabel) + '</div>';
      html += '<div class="gls-entry-meta">';
      html += '<span style="margin-right:var(--sp-3)">source: ' + esc(m.source) + '</span>';
      html += '<span style="margin-right:var(--sp-3)">kind: ' + esc(m.kind) + '</span>';
      html += '<span style="margin-right:var(--sp-3)">tab: ' + esc(m.subtab) + '</span>';
      if (m.signalForScoring) html += '<span style="color:var(--accent)">scored</span>';
      html += '</div>';
      if (m.read) html += '<div class="gls-entry-read">' + esc(m.read) + '</div>';
      html += '<div class="gls-entry-dir">' + dirReadLabel(m.dir) + '</div>';
      html += '</div>';
    });

    if (!html) html = '<p style="color:var(--muted);padding:var(--sp-3)">No metrics match.</p>';
    document.getElementById('gls-entries').innerHTML = html;
  }

  document.getElementById('gls-search').addEventListener('input', function (e) {
    searchTerm = e.target.value;
    render();
  });

  document.getElementById('gls-filter').addEventListener('change', function (e) {
    filterTab = e.target.value;
    render();
  });

  // ── Tab activation ────────────────────────────────────────────────────────
  var glsInited = false;
  document.querySelector('.market-tab[data-tab="glossary"]').addEventListener('click', function () {
    if (glsInited) return;
    glsInited = true;
    fetchManifest();
  });

})();
</script>
