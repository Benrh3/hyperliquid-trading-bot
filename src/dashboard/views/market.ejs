<%- include('_head', { title: 'HYPE Market' }) %>
<style>
  /* ── Market pillar: sky accent + faint border override ── */
  :root {
    --accent:        #38BDF8;
    --accent-dim:    rgba(56,189,248,0.12);
    --accent-border: rgba(56,189,248,0.25);
    --border:        rgba(56,189,248,0.09);
  }

  /* ── Sub-tab strip ──────────────────────────────────────────── */
  .market-tabs-bar {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .market-tabs-inner {
    padding: 0 var(--sp-6);
    display: flex;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .market-tabs-inner::-webkit-scrollbar { display: none; }
  .market-tab {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-size: 12px;
    font-family: inherit;
    font-weight: 500;
    padding: 0.55rem 0.75rem;
    cursor: pointer;
    white-space: nowrap;
    transition: color .12s;
    flex-shrink: 0;
  }
  .market-tab:hover  { color: var(--text); }
  .market-tab.active { color: var(--accent); border-bottom-color: var(--accent); }

  /* ── Live ticker bar ───────────────────────────────────────── */
  .market-ticker-bar {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    font-size: 11px;
    font-family: 'SFMono-Regular', Consolas, monospace;
    font-variant-numeric: tabular-nums;
    overflow: hidden;
  }
  .market-ticker-inner {
    padding: 0 var(--sp-6);
    height: 32px;
    display: flex;
    align-items: center;
    gap: 0;
  }
  .tk-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0 0.75rem;
    border-right: 1px solid var(--border);
    height: 100%;
    flex-shrink: 0;
  }
  .tk-item:first-child { padding-left: 0; }
  .tk-label {
    color: var(--muted);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: .07em;
  }
  .tk-val  { color: var(--text); }
  .tk-unit { color: var(--muted); font-size: 10px; }
  .tk-up   { color: var(--up); }
  .tk-dn   { color: var(--down); }
  /* ● LIVE badge — far left of ticker */
  .tk-live-badge {
    gap: var(--sp-1);
    padding-right: 0.75rem;
  }
  .tk-live-label {
    font-size: var(--t-label);
    font-weight: 600;
    color: var(--accent);
    letter-spacing: .06em;
  }
  .tk-live {
    margin-left: auto;
    padding-right: 0;
    border-right: none;
    color: var(--muted);
    gap: 0.35rem;
  }
  .dot-accent {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
    animation: pulse 2s infinite;
  }

  /* ── Layout — full-width, edge-to-edge ────────────────────── */
  .container {
    max-width: none;
    margin: 0;
    padding: var(--sp-4) var(--sp-6);
  }

  /* ── Main row: chart (left) + tiles (right) ─────────────── */
  .mkt-main-row {
    display: flex;
    gap: var(--sp-4);
    align-items: stretch;
    margin-bottom: var(--sp-4);
  }
  .mkt-chart-col {
    flex: 0 0 62%;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .mkt-chart-col .chart-card { flex: 1; display: flex; flex-direction: column; }
  .mkt-chart-col .chart-card-toolbar { flex-shrink: 0; }
  .mkt-chart-col #px-chart { flex: 1; }
  .mkt-tiles-col {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  /* ── Market toolbar ────────────────────────────────────────── */
  .market-toolbar {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
    flex-wrap: wrap;
  }
  .horizon-label {
    font-size: var(--t-label);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .08em;
    font-weight: 600;
  }
  .horizon-group { display: flex; gap: 2px; }
  .hz-btn {
    background: none;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
    font-family: inherit;
    padding: 2px 7px;
    border-radius: 3px;
    cursor: pointer;
    transition: color .1s, border-color .1s, background .1s;
  }
  .hz-btn:hover { color: var(--text); border-color: rgba(56,189,248,0.3); }
  .hz-btn.active {
    background: var(--accent-dim);
    border-color: var(--accent-border);
    color: var(--accent);
  }
  .beginner-toggle {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: auto;
    cursor: pointer;
    font-size: 11px;
    color: var(--muted);
    user-select: none;
  }
  .beginner-toggle input { cursor: pointer; accent-color: var(--accent); }
  .beginner-toggle.active { color: var(--accent); }

  /* ── Bias hero — two-column ────────────────────────────────── */
  .bias-hero {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--accent-border);
    border-radius: 0 0 8px 8px;
    padding: 0;
    margin-bottom: var(--sp-4);
    box-shadow: 0 2px 12px rgba(0,0,0,0.35);
    display: flex;
    align-items: stretch;
  }
  .bias-left {
    flex: 0 0 30%;
    min-width: 0;
    padding: var(--sp-4) var(--sp-6);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    justify-content: center;
  }
  .bias-right {
    flex: 1 1 0;
    min-width: 0;
    padding: var(--sp-4) var(--sp-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .bias-hero-top {
    display: flex;
    align-items: baseline;
    gap: .75rem;
    flex-wrap: wrap;
  }
  .bias-label {
    font-family: Georgia, 'Palatino Linotype', serif;
    font-size: var(--t-hero);
    font-weight: normal;
    letter-spacing: -.02em;
    line-height: 1;
    flex: 1;
  }
  .bias-label.bullish { color: var(--up);   }
  .bias-label.bearish { color: var(--down); }
  .bias-label.neutral { color: var(--muted); }
  .bias-label.warming { color: var(--muted); font-size: 28px; }
  .conf-badge {
    display: inline-block;
    padding: .2rem .55rem;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    flex-shrink: 0;
    align-self: center;
  }
  .conf-high { background: rgba(34,197,94,0.15);  color: var(--up);     }
  .conf-low  { background: rgba(56,189,248,0.10); color: var(--muted);  }

  /* Split bar */
  .bias-bar-row {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-2);
  }
  .bias-bar-wrap {
    position: relative;
    flex: 1;
    height: 8px;
    border-radius: 4px;
    background: rgba(56,189,248,0.06);
    overflow: hidden;
  }
  .bias-bar-bull {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    background: var(--up);
    transition: width .5s ease;
  }
  .bias-bar-bear {
    position: absolute;
    right: 0; top: 0; bottom: 0;
    background: var(--down);
    transition: width .5s ease;
  }
  .bias-bar-center {
    position: absolute;
    left: 50%;
    top: -1px; bottom: -1px;
    width: 2px;
    background: rgba(255,255,255,0.22);
    transform: translateX(-50%);
    z-index: 2;
  }
  .bias-score-val {
    font-size: var(--t-label);
    font-family: 'SFMono-Regular', Consolas, monospace;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    flex-shrink: 0;
    width: 4.5em;
    text-align: right;
  }
  .bias-counts {
    font-size: var(--t-label);
    color: var(--muted);
    margin-bottom: var(--sp-2);
  }
  .bias-counts .bc-up { color: var(--up);   }
  .bias-counts .bc-dn { color: var(--down); }
  .bias-warming-note {
    font-size: var(--t-label);
    color: var(--muted);
    font-style: italic;
    margin-bottom: var(--sp-2);
  }
  /* ── Driver panel (bias hero right column) ── */
  .bias-drivers-panel {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    justify-content: center;
  }
  .bias-drivers-empty {
    font-size: 11px;
    color: var(--muted);
    font-style: italic;
  }
  .bias-driver-group { display: flex; flex-direction: column; gap: .25rem; }
  .bias-driver-group-label {
    font-size: var(--t-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
    margin-bottom: var(--sp-1);
  }
  .bias-driver-group-label.bull { color: var(--up);   }
  .bias-driver-group-label.bear { color: var(--down); }
  .bias-driver-chips { display: flex; flex-wrap: wrap; gap: .25rem; }
  .driver-chip {
    display: inline-block;
    padding: .12rem .4rem;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 600;
  }
  .driver-chip.bull { background: rgba(34,197,94,0.13);  color: var(--up);   }
  .driver-chip.bear { background: rgba(239,68,68,0.13);  color: var(--down); }

  /* ── Category cards — 6-col full-width row ─────────────── */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--sp-2);
    margin-bottom: 0;
  }
  .cat-card {
    background: var(--surface);
    border: none;
    border-left: 3px solid rgba(56,189,248,0.15);
    border-radius: 0 5px 5px 0;
    padding: var(--sp-3) var(--sp-4);
    box-shadow: 0 1px 4px rgba(0,0,0,0.3);
    transition: border-left-color .15s;
  }
  .cat-card.bullish { border-left-color: var(--up);   }
  .cat-card.bearish { border-left-color: var(--down); }
  .cat-card.neutral { border-left-color: var(--muted); }
  .cat-card.warming { border-left-color: rgba(56,189,248,0.12); opacity: .7; }
  .cat-name { font-size: var(--t-label); font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: var(--sp-1); }
  .cat-bias { font-size: var(--t-body); font-weight: 600; }
  .cat-bias.bullish { color: var(--up);   }
  .cat-bias.bearish { color: var(--down); }
  .cat-bias.neutral, .cat-bias.warming { color: var(--muted); }

  /* ── Headline tiles — fixed 2-col inside the side column ── */
  .tiles-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-2);
    flex: 1;
    align-content: start;
  }
  /* ── Summary chart card (overrides global .chart-card for the hero chart) ── */
  .mkt-chart-col .chart-card {
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 1px 6px rgba(0,0,0,0.25);
  }

  /* ── Section label ───────────────────────────────────────── */
  .mkt-section-label {
    font-size: var(--t-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--muted);
    margin-bottom: var(--sp-2);
  }

  /* ── Stub tab placeholder ─────────────────────────────────── */
  .tab-stub {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 13px;
  }
  .tab-stub-title {
    font-family: Georgia, serif;
    font-size: 1.25rem;
    font-weight: normal;
    color: var(--text);
    margin-bottom: .5rem;
  }

  /* ── Tooltip ─────────────────────────────────────────────── */
  #market-tip {
    position: fixed;
    pointer-events: none;
    display: none;
    background: var(--surface2);
    border: 1px solid var(--accent-border);
    color: var(--text);
    font-size: 11px;
    padding: .4rem .65rem;
    border-radius: 5px;
    max-width: 220px;
    line-height: 1.5;
    z-index: 9999;
    box-shadow: 0 6px 20px rgba(0,0,0,.5);
  }

  /* ── Value-change flash ─────────────────────────────────── */
  @keyframes mkt-flash-up {
    from { background-color: rgba(34,197,94,0.22); }
    to   { background-color: transparent; }
  }
  @keyframes mkt-flash-down {
    from { background-color: rgba(239,68,68,0.22); }
    to   { background-color: transparent; }
  }
  .flash-up   { border-radius: 3px; animation: mkt-flash-up   700ms ease-out forwards; }
  .flash-down { border-radius: 3px; animation: mkt-flash-down 700ms ease-out forwards; }
  @media (prefers-reduced-motion: reduce) {
    .flash-up, .flash-down { animation: none !important; }
  }

  /* ── Responsive breakdowns ───────────────────────────────── */
  @media (max-width: 1100px) {
    .mkt-chart-col { flex-basis: 58%; }
  }
  @media (max-width: 900px) {
    .mkt-main-row  { flex-direction: column; }
    .mkt-chart-col, .mkt-tiles-col { flex: none; }
    .tiles-grid    { grid-template-columns: repeat(3, 1fr); align-content: start; }
    .cat-grid      { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 768px) {
    .market-tabs-inner   { padding: 0 .75rem; }
    .market-ticker-inner { padding: 0 .75rem; }
    .container           { padding: .75rem; }
    .bias-hero           { flex-direction: column; min-height: 0; }
    .bias-left           { flex: none; border-right: none; border-bottom: 1px solid var(--border); }
    .bias-right          { flex: none; }
    .bias-label          { font-size: 28px; }
    .tiles-grid          { grid-template-columns: 1fr 1fr; }
    .cat-grid            { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .cat-grid { grid-template-columns: 1fr 1fr; }
  }

  /* ── Leverage tab ───────────────────────────────────────────────────────── */
  .lev-section-head {
    padding: var(--sp-5) var(--sp-4) var(--sp-2);
  }
  .lev-section-title {
    font-size: var(--t-label);
    font-weight: 700;
    letter-spacing: .1em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .lev-section-sub {
    font-size: var(--t-label);
    color: var(--muted);
    margin-top: var(--sp-1);
    opacity: .7;
  }
  .lev-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--sp-3);
    padding: 0 var(--sp-4) var(--sp-4);
  }
  .lev-chart-caption {
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--t-label);
    line-height: 1.5;
    opacity: .7;
    padding: var(--sp-2) var(--sp-4);
  }
  /* sc-dir sub-label (used in leverage cards) */
  .sc-dir          { font-size: var(--t-label); font-weight: 600; letter-spacing: .02em; line-height: 1; margin-bottom: var(--sp-2); }
  .sc-dir-pos      { color: var(--up); }
  .sc-dir-neg      { color: var(--down); }
  .sc-dir-neutral  { color: var(--muted); }

  /* ── Signals tab (scorecard table) ──────────────────────────────────────── */
  .sig-controls {
    display: flex; align-items: center; gap: var(--sp-3); flex-wrap: wrap;
    padding: 0 var(--sp-4) var(--sp-3);
  }
  .sig-controls select, .sig-controls button {
    background: var(--surface); border: 1px solid var(--border); border-radius: 4px;
    color: var(--muted); cursor: pointer; font-size: var(--t-label); font-weight: 600;
    padding: 3px 8px;
  }
  .sig-controls select:focus, .sig-controls button:hover { color: var(--accent); border-color: rgba(56,189,248,0.3); }
  .sig-controls button.active { background: rgba(56,189,248,0.1); color: var(--accent); border-color: rgba(56,189,248,0.25); }
  .sig-table-wrap {
    overflow-x: auto; padding: 0 var(--sp-4) var(--sp-4);
    -webkit-overflow-scrolling: touch;
  }
  .sig-table {
    border-collapse: collapse; width: 100%; min-width: 680px;
    font-size: var(--t-label); line-height: 1.5;
  }
  .sig-table th {
    border-bottom: 2px solid var(--border); color: var(--muted);
    font-weight: 700; letter-spacing: .06em; padding: var(--sp-2) var(--sp-3);
    position: sticky; top: 0; background: var(--bg); text-align: left;
    text-transform: uppercase; white-space: nowrap;
  }
  .sig-table th.th-h { text-align: center; min-width: 90px; }
  .sig-table td { border-bottom: 1px solid var(--border); padding: var(--sp-2) var(--sp-3); white-space: nowrap; }
  .sig-table td.td-ic { text-align: center; font-weight: 600; font-variant-numeric: tabular-nums; }
  .sig-table .fam-head td {
    background: var(--surface); color: var(--muted); font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase; padding: var(--sp-2) var(--sp-3);
  }
  .sig-table .sig-key { color: #7AA5C8; }
  .sig-table .sig-sub { color: var(--muted); font-weight: 400; margin-left: var(--sp-2); }
  .ic-proven  { opacity: 1; }
  .ic-warming { opacity: 0.4; }
  .ic-pos     { color: var(--up); }
  .ic-neg     { color: var(--down); }
  .recon-ok   { color: var(--muted); opacity: 0.5; }
  .recon-warn { color: #F59E0B; font-weight: 700; }
  .recon-na   { color: var(--muted); opacity: 0.3; }

  /* ── Data tab ───────────────────────────────────────────────────────────── */
  .data-controls {
    display: flex; align-items: center; gap: var(--sp-3); flex-wrap: wrap;
    padding: 0 var(--sp-4) var(--sp-3);
  }
  .data-controls select, .data-controls button, .data-controls a.btn {
    background: var(--surface); border: 1px solid var(--border); border-radius: 4px;
    color: var(--muted); cursor: pointer; font-size: var(--t-label); font-weight: 600;
    padding: 3px 8px; text-decoration: none;
  }
  .data-controls select:focus, .data-controls button:hover, .data-controls a.btn:hover {
    color: var(--accent); border-color: rgba(56,189,248,0.3);
  }
  .data-controls button.active { background: rgba(56,189,248,0.1); color: var(--accent); }
  .data-table-wrap { overflow-x: auto; padding: 0 var(--sp-4) var(--sp-4); -webkit-overflow-scrolling: touch; }
  .data-table {
    border-collapse: collapse; width: 100%; min-width: 600px;
    font-size: var(--t-label); line-height: 1.5; font-variant-numeric: tabular-nums;
  }
  .data-table th {
    border-bottom: 2px solid var(--border); color: var(--muted); font-weight: 700;
    letter-spacing: .04em; padding: var(--sp-2) var(--sp-3);
    position: sticky; top: 0; background: var(--bg); text-align: right; white-space: nowrap;
  }
  .data-table th:first-child { text-align: left; }
  .data-table td { border-bottom: 1px solid var(--border); padding: var(--sp-2) var(--sp-3); text-align: right; white-space: nowrap; }
  .data-table td:first-child { text-align: left; color: var(--muted); }

  /* ── Glossary tab ───────────────────────────────────────────────────────── */
  .gls-search {
    background: var(--surface); border: 1px solid var(--border); border-radius: 4px;
    color: #fff; font-size: var(--t-body); padding: var(--sp-2) var(--sp-3); width: 100%; max-width: 320px;
  }
  .gls-search::placeholder { color: var(--muted); }
  .gls-entry {
    background: var(--surface); border-radius: 6px; padding: var(--sp-3) var(--sp-4); margin-bottom: var(--sp-3);
  }
  .gls-entry-key { color: #7AA5C8; font-weight: 600; font-size: var(--t-body); }
  .gls-entry-label { color: #fff; font-weight: 600; font-size: var(--t-body); margin-left: var(--sp-2); }
  .gls-entry-meta { font-size: var(--t-label); color: var(--muted); margin-top: var(--sp-1); }
  .gls-entry-read { font-size: var(--t-label); color: #7AA5C8; margin-top: var(--sp-1); }
  .gls-entry-dir  { font-size: var(--t-label); font-weight: 600; margin-top: var(--sp-1); }
  /* ── Warming chart empty state ─────────────────────────────────────────── */
  .chart-warming {
    display: flex; align-items: center; justify-content: center;
    height: 100%; min-height: 180px;
    color: var(--muted); font-size: var(--t-body); font-weight: 600; letter-spacing: .02em;
  }
  .gls-methodology { padding: var(--sp-4); }
  .gls-methodology h3 { color: #7AA5C8; font-size: var(--t-body); font-weight: 700; margin: var(--sp-4) 0 var(--sp-2); text-transform: uppercase; letter-spacing: .06em; }
  .gls-methodology p, .gls-methodology li { color: var(--muted); font-size: var(--t-label); line-height: 1.6; }
  .gls-methodology ul { padding-left: 1.2em; margin: var(--sp-2) 0; }
</style>

<%- include('_nav') %>

<!-- ── Sub-tab strip ── -->
<div class="market-tabs-bar">
  <div class="market-tabs-inner" id="market-tab-strip">
    <button class="market-tab active" data-tab="summary">Summary</button>
    <button class="market-tab" data-tab="timemachine">Time Machine</button>
    <button class="market-tab" data-tab="orderflow">Order Flow</button>
    <button class="market-tab" data-tab="leverage">Leverage</button>
    <button class="market-tab" data-tab="supply">Supply</button>
    <button class="market-tab" data-tab="onchain">On-chain</button>
    <button class="market-tab" data-tab="microstructure">Microstructure</button>
