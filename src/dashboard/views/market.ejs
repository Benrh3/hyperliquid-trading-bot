<!-- ── Shared: tabs + tooltip + beginner mode ── -->
<script>
(function () {
  'use strict';

  // Tab switching
  var tabs = document.querySelectorAll('.market-tab');
  tabs.forEach(function (btn) {
    btn.addEventListener('click', function () {
      tabs.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var t = btn.getAttribute('data-tab');
      document.querySelectorAll('.tab-panel').forEach(function (p) {
        p.style.display = p.id === 'tab-' + t ? '' : 'none';
      });
    });
  });

  // Tooltip
  var tipEl = document.getElementById('market-tip');
  function showTip(el, text) {
    tipEl.textContent = text;
    tipEl.style.display = 'block';
    var r  = el.getBoundingClientRect();
    var tw = tipEl.offsetWidth;
    var th = tipEl.offsetHeight;
    var left = Math.min(r.left + r.width / 2 - tw / 2, window.innerWidth - tw - 8);
    left = Math.max(left, 8);
    var top = r.bottom + 6;
    if (top + th > window.innerHeight - 8) top = r.top - th - 6;
    tipEl.style.left = left + 'px';
    tipEl.style.top  = top  + 'px';
  }
  function hideTip() { tipEl.style.display = 'none'; }
  document.addEventListener('mouseover', function (e) {
    var el = e.target.closest('[data-tip]');
    if (el) showTip(el, el.getAttribute('data-tip'));
  });
  document.addEventListener('mouseout', function (e) {
    if (e.target.closest('[data-tip]')) hideTip();
  });

  // Beginner mode
  var bChk = document.getElementById('beginner-chk');
  var bLbl = document.getElementById('beginner-lbl');
  function applyBeginner(on) {
    bLbl.classList.toggle('active', on);
    document.querySelectorAll('[data-expert]').forEach(function (el) {
      el.textContent = on ? el.getAttribute('data-beginner') : el.getAttribute('data-expert');
    });
    document.querySelectorAll('.sc-read').forEach(function (el) {
      el.style.display = on ? '' : 'none';
    });
    try { localStorage.setItem('mkt-beginner', on ? '1' : '0'); } catch (_) {}
  }
  try {
    if (localStorage.getItem('mkt-beginner') === '1') { bChk.checked = true; applyBeginner(true); }
  } catch (_) {}
  bChk.addEventListener('change', function () { applyBeginner(bChk.checked); });
  window.MKT = window.MKT || {};
  window.MKT.applyBeginner = function () { applyBeginner(bChk.checked); };

  // Flash: remove→reflow→re-add so the animation can re-trigger on repeated updates
  window.MKT.flashEl = function (el, dir) {
    el.classList.remove('flash-up', 'flash-down');
    void el.offsetWidth; // force reflow to restart CSS animation
    el.classList.add(dir === 'up' ? 'flash-up' : 'flash-down');
  };
  // Clean up flash class after animation ends (enables re-triggering on next change)
  document.addEventListener('animationend', function (e) {
    var t = e.target;
    if (t && (t.classList.contains('flash-up') || t.classList.contains('flash-down'))) {
      t.classList.remove('flash-up', 'flash-down');
    }
  }, true);

})();
</script>

<!-- ── Summary: bias + ticker + signals + chart ── -->
<script>
(function () {
  'use strict';

  // ── State ──────────────────────────────────────────────────────────────────
  var activeH     = 24;
  var lastTkPrice = null;
  var tkTimes     = [];
  var prevVals    = {}; // metric key → last displayed number, for flash comparison

  // ── Horizon selector ───────────────────────────────────────────────────────
  document.getElementById('horizon-group').addEventListener('click', function (e) {
    var btn = e.target.closest('.hz-btn');
    if (!btn) return;
    activeH = parseInt(btn.getAttribute('data-h'), 10);
    document.querySelectorAll('.hz-btn').forEach(function (b) {
      b.classList.toggle('active', b === btn);
    });
    fetchBias(activeH);
  });

  // ── Helpers ────────────────────────────────────────────────────────────────
  function esc(s) {
    return String(s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function fmtCompact(v) {
    if (v === null || v === undefined || !isFinite(v)) return '—';
    var abs = Math.abs(v), sign = v < 0 ? '-' : '';
    if (abs >= 1e9) return sign + (abs / 1e9).toFixed(2) + 'B';
    if (abs >= 1e6) return sign + (abs / 1e6).toFixed(1) + 'M';
    if (abs >= 1e3) return sign + (abs / 1e3).toFixed(0) + 'K';
    return sign + abs.toFixed(2);
  }
  function fmtPrice(v)   { return (v === null || !isFinite(v)) ? '—' : '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
  function fmtFunding(v) { return (v === null || !isFinite(v)) ? '—' : (v >= 0 ? '+' : '') + (v * 100).toFixed(4) + '%'; }
  function fmtSigned(v)  { return (v === null || !isFinite(v)) ? '—' : (v >= 0 ? '+' : '') + fmtCompact(v); }
  function fmtBps(v)     { return (v === null || !isFinite(v)) ? '—' : v.toFixed(2); }

  // ── Tile definitions ───────────────────────────────────────────────────────
  var TILES = [
    { key: 'perp_mark_px',       label: 'PRICE (FUTURES)', beginner: 'Price (futures)',
      kind: 'level', source: 'hl-market',  read: null, fmt: fmtPrice,   sign: false },
    { key: 'funding_rate',       label: 'FUNDING /H',      beginner: 'Funding rate',
      kind: 'level', source: 'hl-market',
      read: 'high + = crowded longs (contrarian bearish); tiny scale',
      fmt: fmtFunding, sign: true },
    { key: 'open_interest',      label: 'PERP OI (HL)',    beginner: 'Open positions (HL)',
      kind: 'level', source: 'hl-market',  read: null, fmt: fmtCompact, sign: false },
    { key: 'cvd_perp_24h',       label: 'CVD PERP 24H',   beginner: 'Aggressive buying 24h',
      kind: 'window', source: 'hl-market',
      read: 'px up + CVD down = distribution; px down + CVD up = absorption',
      fmt: fmtSigned, sign: true },
    { key: 'cex_net_flow_hype',  label: 'CEX NET FLOW',   beginner: 'Coins moving to exchanges',
      kind: 'window', source: 'on-chain',
      read: '+ = into exchanges = SELL intent (bearish); - = withdrawals (bullish)',
      fmt: fmtSigned, sign: true },
    { key: 'total_staked_hype',  label: 'TOTAL STAKED',   beginner: 'Coins locked (staked)',
      kind: 'level', source: 'hl-native',
      read: 'rising = float reduction (bullish)',
      fmt: fmtCompact, sign: false },
  ];

  var SRC_CLS = { 'hl-market': 'hlmarket', 'hl-native': 'hlnative', 'on-chain': 'onchain', 'cex-agg': 'cexagg' };

  // In-place tile value update with flash — used by the 4s live poll.
  // Avoids full card re-render so beginner-mode text and badge classes are preserved.
  function updateFastTileValue(key, newVal, fmtFn, signSensitive) {
    if (newVal === null || newVal === undefined) return;
    var card = document.querySelector('.signal-card[data-key="' + key + '"]');
    if (!card) return;
    var valEl = card.querySelector('.sc-value');
    if (!valEl) return;
    var oldVal = prevVals[key];
    valEl.textContent = fmtFn(newVal);
    if (signSensitive) {
      valEl.classList.remove('val-pos', 'val-neg');
      if (newVal > 0) valEl.classList.add('val-pos');
      else if (newVal < 0) valEl.classList.add('val-neg');
    }
    if (oldVal !== undefined && oldVal !== null && newVal !== oldVal && window.MKT && window.MKT.flashEl) {
      window.MKT.flashEl(valEl, newVal > oldVal ? 'up' : 'down');
    }
    prevVals[key] = newVal;
  }

  function signCls(v, s) {
    if (!s || v === null || !isFinite(v)) return '';
    return v > 0 ? ' val-pos' : v < 0 ? ' val-neg' : '';
  }

  function makeCard(tile, value) {
    var val    = (value !== null && value !== undefined) ? tile.fmt(value) : '—';
    var cls    = signCls(value, tile.sign);
    var srcCls = SRC_CLS[tile.source] || '';
    var ib     = tile.read
      ? '<button class="sc-info-btn" data-tip="' + esc(tile.read) + '" aria-label="About ' + esc(tile.label) + '">&#9432;</button>'
      : '';
    var rd     = tile.read ? '<div class="sc-read" style="display:none">' + esc(tile.read) + '</div>' : '';
    return '<div class="signal-card" data-key="' + esc(tile.key) + '">'
      + '<div class="sc-header">'
      +   '<span class="sc-label" data-expert="' + esc(tile.label) + '" data-beginner="' + esc(tile.beginner) + '">' + esc(tile.label) + '</span>'
      +   ib
      + '</div>'
      + '<div class="sc-value' + cls + '">' + esc(val) + '</div>'
      + rd
      + '<div class="sc-badges">'
      +   '<span class="sc-badge sc-kind sc-kind-' + esc(tile.kind) + '">' + esc(tile.kind) + '</span>'
      +   '<span class="sc-badge sc-source sc-src-' + esc(srcCls) + '">' + esc(tile.source) + '</span>'
      + '</div>'
      + '</div>';
  }

  // ── Category name map ──────────────────────────────────────────────────────
  var CAT_NAMES = {
    leverage: 'Leverage', orderflow: 'Order Flow', supply: 'Supply',
    onchain: 'On-chain', microstructure: 'Microstructure', liquidations: 'Liquidations',
  };
  var CAT_ORDER = ['leverage', 'orderflow', 'supply', 'onchain', 'microstructure', 'liquidations'];

  // ── Live ticker update ─────────────────────────────────────────────────────
  function updateTicker(signals, capturedAt) {
    var vm = {};
    signals.forEach(function (s) { vm[s.key] = s.currentValue; });

    var price = vm['perp_mark_px'];
    var priceEl = document.getElementById('tk-price');
    var dirEl   = document.getElementById('tk-dir');
    if (priceEl && price !== null && price !== undefined) {
      if (lastTkPrice !== null && price !== lastTkPrice && window.MKT && window.MKT.flashEl) {
        window.MKT.flashEl(priceEl, price > lastTkPrice ? 'up' : 'down');
      }
      priceEl.textContent = fmtPrice(price);
      if (dirEl && lastTkPrice !== null) {
        if (price > lastTkPrice)       { dirEl.textContent = '▲'; dirEl.className = 'tk-val tk-up'; }
        else if (price < lastTkPrice)  { dirEl.textContent = '▼'; dirEl.className = 'tk-val tk-dn'; }
        else                           { dirEl.textContent = '';  dirEl.className = 'tk-val'; }
      }
      lastTkPrice = price;
    }

    var fundEl = document.getElementById('tk-funding');
    if (fundEl) { var fr = vm['funding_rate']; fundEl.textContent = fr !== null && fr !== undefined ? fmtFunding(fr) : '—'; fundEl.className = 'tk-val' + (fr > 0 ? ' tk-up' : fr < 0 ? ' tk-dn' : ''); }

    var cvdEl = document.getElementById('tk-cvd');
    if (cvdEl) { var cv = vm['cvd_perp_24h']; cvdEl.textContent = cv !== null && cv !== undefined ? fmtSigned(cv) : '—'; cvdEl.className = 'tk-val' + (cv > 0 ? ' tk-up' : cv < 0 ? ' tk-dn' : ''); }

    var spEl = document.getElementById('tk-spread');
    if (spEl) { var sp = vm['book_spread_bps']; spEl.textContent = sp !== null && sp !== undefined ? fmtBps(sp) : '—'; }

    // Updates/min counter
    var now = Date.now();
    tkTimes.push(now);
    tkTimes = tkTimes.filter(function (t) { return now - t < 60000; });
    var updEl = document.getElementById('tk-upd');
    if (updEl) updEl.textContent = String(tkTimes.length);

    // Timestamp
    if (capturedAt) {
      var atEl = document.getElementById('market-captured-at');
      if (atEl) atEl.textContent = new Date(capturedAt).toLocaleTimeString();
    }
  }

  // ── Bias fetch + render ────────────────────────────────────────────────────
  async function fetchBias(h) {
    try {
      var r = await fetch('/api/market/bias?horizon=' + h);
      if (!r.ok) throw new Error('HTTP ' + r.status);
      renderBias(await r.json());
    } catch (_) {
      var el = document.getElementById('bias-label');
      if (el) { el.textContent = 'Error'; el.className = 'bias-label neutral'; }
    }
  }

  function renderBias(d) {
    var lc = (d.label || '').toLowerCase();

    // Label
    var labelEl = document.getElementById('bias-label');
    labelEl.textContent = d.label || '—';
    labelEl.className = 'bias-label ' + (lc === 'bullish' ? 'bullish' : lc === 'bearish' ? 'bearish' : 'neutral');

    // Confidence badge
    var isHigh = d.confidence === 'HIGH';
    var confEl = document.getElementById('conf-badge');
    confEl.textContent = d.confidence || 'WARMING';
    confEl.className = 'conf-badge ' + (isHigh ? 'conf-high' : 'conf-low');

    // Split bar
    var up = d.bullCount || 0;
    var dn = d.bearCount || 0;
    var total = up + dn;
    var bullPct = total > 0 ? (up / total * 100) : 0;
    var bearPct = total > 0 ? (dn / total * 100) : 0;
    document.getElementById('bias-bar-bull').style.width = bullPct.toFixed(1) + '%';
    document.getElementById('bias-bar-bear').style.width = bearPct.toFixed(1) + '%';

    // Score
    var score = typeof d.score === 'number' ? d.score : 0;
    document.getElementById('bias-score-val').textContent = (score >= 0 ? '+' : '') + score.toFixed(3);

    // Counts
    document.getElementById('bias-counts').innerHTML =
      '<span class="bc-up">▲ ' + up + ' bullish</span> &middot; <span class="bc-dn">▼ ' + dn + ' bearish</span>';

    // Warming note
    var noteEl = document.getElementById('bias-warming-note');
    noteEl.textContent = isHigh ? '' : 'Signals warming — IC not yet proven';
    noteEl.style.display = isHigh ? 'none' : '';

    // Driver panel (right column of bias hero)
    renderDriverPanel(d.categoryBiases || []);
    // Category cards
    renderCatCards(d.categoryBiases || []);
  }

  function renderDriverPanel(biases) {
    var panel = document.getElementById('bias-drivers-panel');
    if (!panel) return;
    var bullCats = biases.filter(function (b) { return b.label === 'Bullish'; });
    var bearCats = biases.filter(function (b) { return b.label === 'Bearish'; });
    if (!bullCats.length && !bearCats.length) {
      panel.innerHTML = '<span class="bias-drivers-empty">Drivers appear as signals prove out</span>';
      return;
    }
    var html = '';
    if (bullCats.length) {
      html += '<div class="bias-driver-group">'
        + '<div class="bias-driver-group-label bull">▲ Bullish</div>'
        + '<div class="bias-driver-chips">'
        + bullCats.map(function (b) { return '<span class="driver-chip bull">' + esc(CAT_NAMES[b.category] || b.category) + '</span>'; }).join('')
        + '</div></div>';
    }
    if (bearCats.length) {
      html += '<div class="bias-driver-group">'
        + '<div class="bias-driver-group-label bear">▼ Bearish</div>'
        + '<div class="bias-driver-chips">'
        + bearCats.map(function (b) { return '<span class="driver-chip bear">' + esc(CAT_NAMES[b.category] || b.category) + '</span>'; }).join('')
        + '</div></div>';
    }
    panel.innerHTML = html;
  }

  function renderCatCards(biases) {
    var byKey = {};
    biases.forEach(function (b) { byKey[b.category] = b; });
    var html = CAT_ORDER.map(function (cat) {
      var b  = byKey[cat];
      var lc = b ? (b.label || '').toLowerCase() : 'warming';
      var lb = b ? (b.label || 'Neutral') : '—';
      return '<div class="cat-card ' + lc + '">'
        + '<div class="cat-name">' + esc(CAT_NAMES[cat] || cat) + '</div>'
        + '<div class="cat-bias ' + lc + '">' + esc(lb) + '</div>'
        + '</div>';
    }).join('');
    document.getElementById('cat-grid').innerHTML = html;
  }

  // ── Signals fetch + tiles ──────────────────────────────────────────────────
  async function fetchSignals() {
    try {
      var r = await fetch('/api/market/signals');
      if (!r.ok) throw new Error('HTTP ' + r.status);
      var d = await r.json();
      renderTiles(d.signals || [], d.capturedAt);
      updateTicker(d.signals || [], d.capturedAt);
    } catch (_) {
      document.getElementById('tiles-grid').innerHTML =
        '<p style="color:var(--muted);font-size:12px;padding:.5rem">Could not load signals.</p>';
    }
  }

  function renderTiles(signals, capturedAt) {
    var vm = {};
    signals.forEach(function (s) { vm[s.key] = s.currentValue; });
    var html = TILES.map(function (tile) {
      return makeCard(tile, vm[tile.key] !== undefined ? vm[tile.key] : null);
    }).join('');
    document.getElementById('tiles-grid').innerHTML = html;
    // Flash tiles whose value changed since last render
    TILES.forEach(function (tile) {
      var newVal = vm[tile.key];
      var oldVal = prevVals[tile.key];
      if (newVal !== null && newVal !== undefined && oldVal !== null && oldVal !== undefined && newVal !== oldVal) {
        var card = document.querySelector('.signal-card[data-key="' + tile.key + '"]');
        if (card) {
          var valEl = card.querySelector('.sc-value');
          if (valEl && window.MKT && window.MKT.flashEl) window.MKT.flashEl(valEl, newVal > oldVal ? 'up' : 'down');
        }
      }
      if (newVal !== null && newVal !== undefined) prevVals[tile.key] = newVal;
    });
    if (window.MKT && window.MKT.applyBeginner) window.MKT.applyBeginner();
  }

  // ── Price chart — always mainnet via /api/market/candles ──────────────────
  var pxChart        = null;
  var pxCandleSeries = null;
  var pxAreaSeries   = null;
  var pxRange        = '1M';
  var RANGES = {
    '1D':  { interval: '15m', secs: 86400 },
    '1W':  { interval: '1h',  secs: 604800 },
    '1M':  { interval: '4h',  secs: 2592000 },
    '3M':  { interval: '1d',  secs: 7776000 },
    'All': { interval: '1d',  secs: null },
  };

  function getCssVar(n) { return getComputedStyle(document.documentElement).getPropertyValue(n).trim(); }

  function mountChart() {
    if (pxChart) return;
    var LC = window.LightweightCharts;
    if (!LC) return;
    var muted  = '#3D5A78';
    var border = 'rgba(56,189,248,0.09)';
    var accent = '#38BDF8';
    var grid   = 'rgba(56,189,248,0.05)';
    pxChart = LC.createChart(document.getElementById('px-chart'), {
      autoSize: true,
      height: 280,
      layout: { background: { type: 'solid', color: '#0D1520' }, textColor: muted, attributionLogo: false },
      grid:   { vertLines: { color: grid, style: 1 }, horzLines: { color: grid, style: 1 } },
      crosshair: {
        mode: 0,
        vertLine: { color: accent, width: 1, style: 1, labelBackgroundColor: accent },
        horzLine: { color: accent, width: 1, style: 1, labelBackgroundColor: accent },
      },
      rightPriceScale: { borderColor: border },
      timeScale: { borderColor: border, timeVisible: true, secondsVisible: false },
      handleScroll: { mouseWheel: true },
      handleScale:  { mouseWheel: true, pinch: true },
    });
    // Area backdrop — added first so it renders behind candles
    pxAreaSeries = pxChart.addAreaSeries({
      lineColor:   'rgba(56,189,248,0.3)',
      topColor:    'rgba(56,189,248,0.08)',
      bottomColor: 'rgba(56,189,248,0)',
      lineWidth: 1,
      crosshairMarkerVisible: false,
      priceFormat: { type: 'price', precision: 2, minMove: 0.01 },
    });
    // Candlestick series on top
    pxCandleSeries = pxChart.addCandlestickSeries({
      upColor:        '#26C281',
      downColor:      '#E5494D',
      borderUpColor:  '#26C281',
      borderDownColor:'#E5494D',
      wickUpColor:    '#26C281',
      wickDownColor:  '#E5494D',
      priceFormat: { type: 'price', precision: 2, minMove: 0.01 },
    });
  }

  async function refreshChart() {
    mountChart();
    if (!pxChart || !pxCandleSeries || !pxAreaSeries) return;
    var metaEl = document.getElementById('px-chart-meta');
    var range  = RANGES[pxRange];
    try {
      var resp = await fetch('/api/market/candles?coin=HYPE&interval=' + range.interval);
      if (!resp.ok) { if (metaEl) metaEl.textContent = 'error'; return; }
      var data = await resp.json();
      if (!data.candles || !data.candles.length) { if (metaEl) metaEl.textContent = 'no data'; return; }
      pxCandleSeries.setData(data.candles);
      pxAreaSeries.setData(data.candles.map(function (c) { return { time: c.time, value: c.close }; }));
      if (range.secs) {
        var nowSec = Math.floor(Date.now() / 1000);
        pxChart.timeScale().setVisibleRange({ from: nowSec - range.secs, to: nowSec + 3600 });
      } else {
        pxChart.timeScale().fitContent();
      }
      if (metaEl) metaEl.textContent = 'mainnet · ' + new Date().toLocaleTimeString();
    } catch (_) {
      if (metaEl) metaEl.textContent = 'error';
    }
  }

  document.getElementById('px-tf-group').addEventListener('click', function (e) {
    var btn = e.target.closest('[data-range]');
    if (!btn) return;
    pxRange = btn.getAttribute('data-range');
    document.querySelectorAll('#px-tf-group .tf').forEach(function (b) {
      b.classList.toggle('active', b === btn);
    });
    refreshChart();
  });

  // ── Live feed: price/funding/spread every 4s ──────────────────────────────
  async function fetchLive() {
    try {
      var r = await fetch('/api/market/live');
      if (!r.ok) return;
      var d = await r.json();
      // Ticker update via the same updateTicker path (reuse format fns + flash)
      var liveSigs = [
        { key: 'perp_mark_px',    currentValue: d.markPx    },
        { key: 'funding_rate',    currentValue: d.funding    },
        { key: 'cvd_perp_24h',   currentValue: d.cvd24h     },
        { key: 'book_spread_bps', currentValue: d.spreadBps  },
      ];
      updateTicker(liveSigs, d.ts);
      // Fast tile in-place updates — no full re-render, flash fires through updateFastTileValue
      updateFastTileValue('perp_mark_px',  d.markPx,       fmtPrice,   false);
      updateFastTileValue('funding_rate',  d.funding,      fmtFunding, true);
      updateFastTileValue('open_interest', d.openInterest, fmtCompact, false);
    } catch (_) {}
  }

  // ── Init + 60s refresh ────────────────────────────────────────────────────
  fetchBias(activeH);
  fetchSignals();
  refreshChart();
  fetchLive();
  setInterval(function () { fetchBias(activeH); fetchSignals(); refreshChart(); }, 60000);
  setInterval(fetchLive, 4000);

})();
</script>
