  function refreshMsc3() {
    mountMsc3();
    if (!msc3) return;
    var meta = document.getElementById('ms-chart3-meta');
    fetch('/api/market/history?fields=book_bid_depth,book_ask_depth&range=' + mr3.v)
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (d) {
        if (!d.rows || !d.rows.length) { if (meta) meta.textContent = 'no data yet'; return; }
        var bidData = [], askData = [];
        d.rows.forEach(function (row) {
          var ts = Math.floor(row.ts / 1000);
          if (row.book_bid_depth !== null && row.book_bid_depth !== undefined) bidData.push({ time: ts, value: row.book_bid_depth });
          if (row.book_ask_depth !== null && row.book_ask_depth !== undefined) askData.push({ time: ts, value: row.book_ask_depth });
        });
        if (bidData.length) msc3Bid.setData(bidData);
        if (askData.length) msc3Ask.setData(askData);
        msApplyRange(msc3, mr3.v);
        if (meta) meta.textContent = new Date().toLocaleTimeString();
      })
      .catch(function () { if (meta) meta.textContent = 'error'; });
  }

  msBindTfGroup('ms-chart3-tf', mr3, refreshMsc3);

  // ── Tab activation (lazy init) ────────────────────────────────────────────
  var msInited = false;
  document.querySelector('.market-tab[data-tab="microstructure"]').addEventListener('click', function () {
    if (msInited) return;
    msInited = true;
    fetchAndRenderCards();
    setTimeout(function () { refreshMsc1(); refreshMsc2(); refreshMsc3(); }, 60);
  });

})();
</script>

<!-- ── On-chain tab ───────────────────────────────────────────────────────── -->
<script>
(function () {
  'use strict';

  // ── Format helpers ───────────────────────────────────────────────────────
  function fmtC(v) {
    if (v === null || v === undefined || !isFinite(v)) return '—';
    var abs = Math.abs(v), sign = v < 0 ? '-' : '';
    if (abs >= 1e9) return sign + (abs / 1e9).toFixed(2) + 'B';
    if (abs >= 1e6) return sign + (abs / 1e6).toFixed(1) + 'M';
    if (abs >= 1e3) return sign + Math.round(abs / 1e3) + 'K';
    return sign + Math.round(abs).toString();
  }
  function fmtSignedC(v) { return (v === null || !isFinite(v)) ? '—' : (v >= 0 ? '+' : '') + fmtC(v); }
  function fmtPct(v)     { return (v === null || !isFinite(v)) ? '—' : (v * 100).toFixed(1) + '%'; }
  function fmtPctSigned(v) { return (v === null || !isFinite(v)) ? '—' : (v >= 0 ? '+' : '') + (v * 100).toFixed(2) + '%'; }

