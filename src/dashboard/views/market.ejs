<%- include('_head', { title: 'HYPE Market' }) %>
<style>
  /* ── Market section: sub-tab strip ── */
  .market-tabs-bar {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .market-tabs-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .market-tabs-inner::-webkit-scrollbar { display: none; }
  .market-tab {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-size: 12px;
    font-family: inherit;
    font-weight: 500;
    padding: 0.6rem 0.75rem;
    cursor: pointer;
    white-space: nowrap;
    transition: color .12s;
    flex-shrink: 0;
  }
  .market-tab:hover { color: var(--text); }
  .market-tab.active { color: var(--accent); border-bottom-color: var(--accent); }

  /* ── Market toolbar (horizon selector + beginner toggle) ── */
  .market-toolbar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .horizon-label {
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .05em;
    margin-right: .25rem;
  }
  .horizon-group { display: flex; gap: 3px; }
  .hz-btn {
    background: none;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
    font-family: inherit;
    padding: 3px 8px;
    border-radius: 3px;
    cursor: pointer;
    transition: color .1s, border-color .1s;
  }
  .hz-btn:hover { color: var(--text); border-color: var(--muted); }
  .hz-btn.active { background: var(--accent-dim); border-color: var(--accent); color: var(--accent); }

  /* ── Beginner toggle ── */
  .beginner-toggle {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    cursor: pointer;
    font-size: 12px;
    color: var(--muted);
    user-select: none;
  }
  .beginner-toggle input { cursor: pointer; accent-color: var(--accent); }
  .beginner-toggle.active { color: var(--accent); }

  /* ── Bias hero ── */
  .bias-hero {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem 2rem;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .bias-label-block { flex: 0 0 auto; }
  .bias-label {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -.02em;
    line-height: 1;
  }
  .bias-label.bullish  { color: var(--up); }
  .bias-label.bearish  { color: var(--down); }
  .bias-label.neutral  { color: var(--muted); }
  .bias-label.warming  { color: var(--muted); font-size: 1.25rem; }
  .bias-score-block { flex: 1 1 160px; }
  .bias-score-bar-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: .35rem;
  }
  .bias-score-track {
    flex: 1;
    height: 6px;
    background: var(--border);
    border-radius: 3px;
    overflow: hidden;
    position: relative;
  }
  .bias-score-fill {
    position: absolute;
    height: 100%;
    border-radius: 3px;
    transition: width .3s, left .3s;
  }
  .bias-score-fill.bullish { background: var(--up); left: 50%; }
  .bias-score-fill.bearish { background: var(--down); right: 50%; }
  .bias-score-fill.neutral { background: var(--muted); left: 50%; }
  .bias-score-val {
    font-size: 11px;
    font-family: 'SFMono-Regular', Consolas, monospace;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    flex-shrink: 0;
    width: 4.5em;
    text-align: right;
  }
  .bias-counts {
    font-size: 12px;
    color: var(--muted);
  }
  .bias-counts .bc-up   { color: var(--up); }
  .bias-counts .bc-dn   { color: var(--down); }
  .bias-conf-block { flex: 0 0 auto; }
  .conf-badge {
    display: inline-block;
    padding: .2rem .55rem;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .conf-high { background: rgba(34,197,94,0.12);  color: var(--up); }
  .conf-low  { background: rgba(210,153,34,0.12); color: var(--yellow); }
  .bias-warming-note {
    font-size: 11px;
    color: var(--muted);
    margin-top: .35rem;
  }

  /* ── Category cards ── */
  .cat-section { margin-bottom: 1.25rem; }
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: .625rem;
  }
  .cat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: .625rem .875rem;
    border-left: 3px solid var(--border);
  }
  .cat-card.bullish { border-left-color: var(--up); }
  .cat-card.bearish { border-left-color: var(--down); }
  .cat-card.neutral { border-left-color: var(--muted); }
  .cat-card.warming { border-left-color: var(--border); opacity: .65; }
  .cat-name { font-size: 10px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-bottom: .25rem; }
  .cat-bias { font-size: 13px; font-weight: 600; }
  .cat-bias.bullish { color: var(--up); }
  .cat-bias.bearish { color: var(--down); }
  .cat-bias.neutral, .cat-bias.warming { color: var(--muted); }

  /* ── Signal card (headline tiles) ── */
  .tiles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: .75rem;
    margin-bottom: 1.25rem;
  }
  .signal-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: .875rem 1rem;
    transition: border-color .12s;
  }
  .signal-card:hover { border-color: var(--accent-border); }
  .sc-header {
    display: flex;
    align-items: center;
    gap: .3rem;
    margin-bottom: .35rem;
  }
  .sc-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--muted);
    font-weight: 600;
  }
  .sc-info-btn {
    background: none;
    border: none;
    color: var(--muted);
    font-size: 11px;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    transition: color .1s;
  }
  .sc-info-btn:hover { color: var(--accent); }
  .sc-value {
    font-size: 1.5rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.02em;
    line-height: 1.1;
    margin-bottom: .2rem;
  }
  .sc-value.val-pos { color: var(--up); }
  .sc-value.val-neg { color: var(--down); }
  .sc-subline { font-size: 11px; color: var(--muted); margin-bottom: .35rem; }
  .sc-read {
    font-size: 11px;
    color: var(--muted);
    font-style: italic;
    margin-bottom: .35rem;
    line-height: 1.4;
  }
  .sc-badges { display: flex; gap: .3rem; flex-wrap: wrap; }
  .sc-badge {
    display: inline-block;
    padding: .1rem .4rem;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 500;
  }
  /* kind badge colours */
  .sc-kind-level      { background: rgba(139,148,158,0.12); color: var(--muted); }
  .sc-kind-window     { background: var(--accent-dim);      color: var(--accent); }
  .sc-kind-delta-prev { background: rgba(139,92,246,0.12);  color: #a78bfa; }
  .sc-kind-ratio      { background: rgba(20,184,166,0.12);  color: #2dd4bf; }
  .sc-kind-aggregate  { background: rgba(251,146,60,0.12);  color: #fb923c; }
  .sc-kind-count      { background: rgba(139,148,158,0.10); color: var(--muted); }
  /* source badge colours */
  .sc-src-hlmarket  { background: rgba(88,166,255,0.10); color: var(--blue); }
  .sc-src-hlnative  { background: rgba(56,189,248,0.10); color: var(--accent); }
  .sc-src-onchain   { background: rgba(251,146,60,0.10); color: #fb923c; }
  .sc-src-cexagg    { background: rgba(210,153,34,0.10); color: var(--yellow); }

  /* ── Chart card wrapper ── */
  .chart-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  .chart-card-toolbar {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .45rem .875rem;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
  }
  .chart-card-title { font-weight: 600; color: var(--text); }
  .chart-card-meta  { color: var(--muted); margin-left: auto; font-size: 11px; }

  /* ── Stub tab placeholder ── */
  .tab-stub {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 13px;
  }
  .tab-stub-title { font-size: 1.1rem; font-weight: 600; color: var(--text); margin-bottom: .5rem; }

  /* ── Tooltip ── */
  #market-tip {
    position: fixed;
    pointer-events: none;
    display: none;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 11px;
    padding: .35rem .6rem;
    border-radius: 4px;
    max-width: 220px;
    line-height: 1.5;
    z-index: 9999;
    box-shadow: 0 4px 12px rgba(0,0,0,.4);
  }

  /* ── Stale / live indicator ── */
  .dot-accent {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
    animation: pulse 2s infinite;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .market-tabs-inner { padding: 0 .75rem; }
    .container { padding: 1rem .75rem; }
    .bias-hero { padding: 1rem 1.25rem; gap: 1rem; }
    .bias-label { font-size: 1.5rem; }
    .tiles-grid { grid-template-columns: 1fr 1fr; }
    .cat-grid   { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .tiles-grid { grid-template-columns: 1fr; }
    .cat-grid   { grid-template-columns: 1fr; }
  }
</style>

