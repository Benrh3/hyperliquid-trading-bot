      kind: 'aggregate', source: 'hl-native', fmt: fmtSignedC, dir: dirBullEps(50),
      read: 'upper bound of scheduled net pressure' },
    // Scored TWAP spot legs (warming — null until native indexer)
    { key: 'twap_spot_buy_hype',  label: 'TWAP SPOT BUY',  beginner: 'Scheduled spot buying',
      kind: 'window',    source: 'hl-native', fmt: fmtC,       dir: dirBullEps(0),
      read: 'scheduled accumulation = forward demand' },
    { key: 'twap_spot_sell_hype', label: 'TWAP SPOT SELL', beginner: 'Scheduled spot selling',
      kind: 'window',    source: 'hl-native', fmt: fmtC,       dir: dirBearEps(0),
      read: 'scheduled distribution = forward supply' },
    // Non-scored TWAP component legs
    { key: 'twap_perp_buy_hype',       label: 'TWAP PERP BUY',           beginner: 'Scheduled perp buying',
      kind: 'window',    source: 'hl-native', fmt: fmtC,       dir: null, read: null },
