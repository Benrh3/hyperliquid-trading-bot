    { key: 'cvd_spot_4h',   label: 'CVD SPOT 4H',   beginner: 'Aggressive buying 4h (spot)',
      kind: 'window',    source: 'hl-market', fmt: fmtSignedC, dir: dirBullEps(600),
      read: null },
    { key: 'cvd_spot_24h',  label: 'CVD SPOT 24H',  beginner: 'Aggressive buying 24h (spot)',
      kind: 'window',    source: 'hl-market', fmt: fmtSignedC, dir: dirBullEps(1500),
      read: 'daily real cash demand; vs perp = leverage vs spot led' },
    // AF
    { key: 'af_buy_hype_window', label: 'AF BUYS (HYPE)', beginner: 'Protocol buying (HYPE)',
      kind: 'window',    source: 'hl-native', fmt: fmtC,       dir: dirBullEps(0),
