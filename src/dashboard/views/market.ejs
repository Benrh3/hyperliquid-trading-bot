<!-- ── Shared: tab switching + beginner mode + tooltip ── -->
<script>
(function () {
  'use strict';

  // ── Tab switching ──────────────────────────────────────────────────────────
  var tabs = document.querySelectorAll('.market-tab');
  tabs.forEach(function (btn) {
    btn.addEventListener('click', function () {
      tabs.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var target = btn.getAttribute('data-tab');
      document.querySelectorAll('.tab-panel').forEach(function (p) {
        p.style.display = p.id === 'tab-' + target ? '' : 'none';
      });
    });
  });

  // ── Tooltip ───────────────────────────────────────────────────────────────
  var tipEl = document.getElementById('market-tip');
  function showTip(el, text) {
    tipEl.textContent = text;
    tipEl.style.display = 'block';
    var r = el.getBoundingClientRect();
    var tw = tipEl.offsetWidth;
    var th = tipEl.offsetHeight;
    var left = Math.min(r.left + r.width / 2 - tw / 2, window.innerWidth - tw - 8);
    left = Math.max(left, 8);
    var top = r.bottom + 6;
    if (top + th > window.innerHeight - 8) top = r.top - th - 6;
    tipEl.style.left = left + 'px';
    tipEl.style.top  = top  + 'px';
  }
  function hideTip() { tipEl.style.display = 'none'; }
  document.addEventListener('mouseover', function (e) {
    var btn = e.target.closest('[data-tip]');
    if (btn) showTip(btn, btn.getAttribute('data-tip'));
  });
  document.addEventListener('mouseout', function (e) {
    if (e.target.closest('[data-tip]')) hideTip();
  });

  // ── Beginner mode ─────────────────────────────────────────────────────────
  var beginnerChk = document.getElementById('beginner-chk');
  var beginnerLbl = document.getElementById('beginner-lbl');

  function applyBeginner(on) {
    beginnerLbl.classList.toggle('active', on);
    document.querySelectorAll('[data-expert]').forEach(function (el) {
      el.textContent = on ? el.getAttribute('data-beginner') : el.getAttribute('data-expert');
    });
    document.querySelectorAll('.sc-read').forEach(function (el) {
      el.style.display = on ? '' : 'none';
    });
    try { localStorage.setItem('mkt-beginner', on ? '1' : '0'); } catch (_) {}
  }

  // Restore persisted state
  try {
    var saved = localStorage.getItem('mkt-beginner');
    if (saved === '1') { beginnerChk.checked = true; applyBeginner(true); }
  } catch (_) {}

  beginnerChk.addEventListener('change', function () { applyBeginner(beginnerChk.checked); });

  // Expose globally so signal-card builder can call after injecting new cards
  window.MKT = window.MKT || {};
  window.MKT.applyBeginner = function () { applyBeginner(beginnerChk.checked); };

})();
</script>

<!-- ── Summary tab: bias + signals + chart ── -->
<script>
(function () {
  'use strict';

  // ── Horizon selector state ─────────────────────────────────────────────────
  var activeH = 24;
  document.getElementById('horizon-group').addEventListener('click', function (e) {
    var btn = e.target.closest('.hz-btn');
    if (!btn) return;
    activeH = parseInt(btn.getAttribute('data-h'), 10);
    document.querySelectorAll('.hz-btn').forEach(function (b) {
      b.classList.toggle('active', b === btn);
    });
    fetchBias(activeH);
  });

  // ── Helpers ───────────────────────────────────────────────────────────────
  function esc(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function fmtCompact(v) {
    if (v === null || v === undefined || !isFinite(v)) return '—';
    var abs = Math.abs(v);
    var sign = v < 0 ? '-' : '';
    if (abs >= 1e9) return sign + (abs / 1e9).toFixed(2) + 'B';
    if (abs >= 1e6) return sign + (abs / 1e6).toFixed(1) + 'M';
    if (abs >= 1e3) return sign + (abs / 1e3).toFixed(0) + 'K';
    return sign + abs.toFixed(2);
  }

  function fmtPrice(v) {
    if (v === null || v === undefined || !isFinite(v)) return '—';
    return '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function fmtFunding(v) {
    if (v === null || v === undefined || !isFinite(v)) return '—';
    var sign = v >= 0 ? '+' : '';
    return sign + (v * 100).toFixed(4) + '%/h';
  }

  function fmtSigned(v) {
    if (v === null || v === undefined || !isFinite(v)) return '—';
    var sign = v >= 0 ? '+' : '';
    return sign + fmtCompact(v);
  }

  // ── Headline tile definitions (key, labels, format fn) ────────────────────
  var TILES = [
    { key: 'perp_mark_px',      label: 'PRICE (FUTURES)', beginner: 'Price (futures)',
      kind: 'level', source: 'hl-market', read: null,
      fmt: fmtPrice, sign: false },
    { key: 'funding_rate',      label: 'FUNDING /H', beginner: 'Funding rate',
      kind: 'level', source: 'hl-market',
      read: 'high + = crowded longs (contrarian bearish); tiny scale',
      fmt: fmtFunding, sign: true },
    { key: 'open_interest',     label: 'PERP OI (HL)', beginner: 'Open positions (HL)',
      kind: 'level', source: 'hl-market', read: null,
      fmt: fmtCompact, sign: false },
    { key: 'cvd_perp_24h',      label: 'CVD PERP 24H', beginner: 'Aggressive buying 24h (futures)',
      kind: 'window', source: 'hl-market',
      read: 'daily aggressor pressure; px up + CVD down = distribution',
      fmt: fmtSigned, sign: true },
    { key: 'cex_net_flow_hype', label: 'CEX NET FLOW', beginner: 'Coins moving to exchanges',
      kind: 'window', source: 'on-chain',
      read: '+ = into exchanges = SELL intent (bearish); - = withdrawals (bullish)',
      fmt: fmtSigned, sign: true },
    { key: 'total_staked_hype', label: 'TOTAL STAKED', beginner: 'Coins locked (staked)',
      kind: 'level', source: 'hl-native',
      read: 'rising = float reduction (bullish)',
      fmt: fmtCompact, sign: false },
  ];

  // Source → CSS class suffix
  var SRC_CLS = {
    'hl-market': 'hlmarket',
    'hl-native': 'hlnative',
    'on-chain':  'onchain',
    'cex-agg':   'cexagg',
  };

  function signClass(v, signSensitive) {
    if (!signSensitive || v === null || !isFinite(v)) return '';
    return v > 0 ? ' val-pos' : v < 0 ? ' val-neg' : '';
  }

  function makeCard(tile, value) {
    var val = value !== null && value !== undefined ? tile.fmt(value) : '—';
    var cls = signClass(value, tile.sign);
    var srcCls = SRC_CLS[tile.source] || '';
    var infoBtn = tile.read
      ? '<button class="sc-info-btn" data-tip="' + esc(tile.read) + '" aria-label="About ' + esc(tile.label) + '">&#9432;</button>'
      : '';
    var readEl = tile.read
      ? '<div class="sc-read" style="display:none">' + esc(tile.read) + '</div>'
      : '';
    return '<div class="signal-card" data-key="' + esc(tile.key) + '">'
      + '<div class="sc-header">'
      +   '<span class="sc-label" data-expert="' + esc(tile.label) + '" data-beginner="' + esc(tile.beginner) + '">' + esc(tile.label) + '</span>'
      +   infoBtn
      + '</div>'
      + '<div class="sc-value' + cls + '">' + esc(val) + '</div>'
      + readEl
      + '<div class="sc-badges">'
      +   '<span class="sc-badge sc-kind sc-kind-' + esc(tile.kind) + '">' + esc(tile.kind) + '</span>'
      +   '<span class="sc-badge sc-source sc-src-' + esc(srcCls) + '">' + esc(tile.source) + '</span>'
      + '</div>'
      + '</div>';
  }

  // ── Category name map ──────────────────────────────────────────────────────
  var CAT_NAMES = {
    leverage:       'Leverage',
    orderflow:      'Order Flow',
    supply:         'Supply',
    onchain:        'On-chain',
    microstructure: 'Microstructure',
    liquidations:   'Liquidations',
  };
  var CAT_ORDER = ['leverage', 'orderflow', 'supply', 'onchain', 'microstructure', 'liquidations'];

  // ── Bias fetch + render ────────────────────────────────────────────────────
  async function fetchBias(h) {
    try {
      var r = await fetch('/api/market/bias?horizon=' + h);
      if (!r.ok) throw new Error('HTTP ' + r.status);
      var d = await r.json();
      renderBias(d);
    } catch (e) {
      document.getElementById('bias-label').textContent = 'Error';
      document.getElementById('bias-label').className = 'bias-label neutral';
    }
  }

  function renderBias(d) {
    var labelEl  = document.getElementById('bias-label');
    var fillEl   = document.getElementById('bias-fill');
    var scoreEl  = document.getElementById('bias-score-val');
    var countsEl = document.getElementById('bias-counts');
    var confEl   = document.getElementById('conf-badge');
    var noteEl   = document.getElementById('bias-warming-note');

    var lc = (d.label || '').toLowerCase();
    labelEl.textContent = d.label || '—';
    labelEl.className = 'bias-label ' + (lc === 'bullish' ? 'bullish' : lc === 'bearish' ? 'bearish' : 'neutral');

    var score = typeof d.score === 'number' ? d.score : 0;
    var pct   = Math.abs(score) * 100;
    scoreEl.textContent = (score >= 0 ? '+' : '') + score.toFixed(3);
    fillEl.className = 'bias-score-fill ' + (lc === 'bullish' ? 'bullish' : lc === 'bearish' ? 'bearish' : 'neutral');
    if (lc === 'bearish') {
      fillEl.style.left  = '';
      fillEl.style.right = '50%';
      fillEl.style.width = Math.min(pct / 2, 50) + '%';
    } else {
      fillEl.style.right = '';
      fillEl.style.left  = '50%';
      fillEl.style.width = Math.min(pct / 2, 50) + '%';
    }

    var up = d.bullCount || 0;
    var dn = d.bearCount || 0;
    countsEl.innerHTML = '<span class="bc-up">▲ ' + up + ' bullish</span> &middot; <span class="bc-dn">▼ ' + dn + ' bearish</span>';

    var isHigh = d.confidence === 'HIGH';
    confEl.textContent = d.confidence || 'WARMING';
    confEl.className = 'conf-badge ' + (isHigh ? 'conf-high' : 'conf-low');
    noteEl.textContent = isHigh ? '' : 'Signals still warming — IC not yet proven';

    // Category cards
    renderCatCards(d.categoryBiases || []);
  }

  function renderCatCards(biases) {
    var grid  = document.getElementById('cat-grid');
    var byKey = {};
    biases.forEach(function (b) { byKey[b.category] = b; });

    var html = CAT_ORDER.map(function (cat) {
      var b   = byKey[cat];
      var lc  = b ? (b.label || '').toLowerCase() : 'warming';
      var lbl = b ? (b.label || 'NEUTRAL') : 'WARMING';
      return '<div class="cat-card ' + lc + '">'
        + '<div class="cat-name">' + esc(CAT_NAMES[cat] || cat) + '</div>'
        + '<div class="cat-bias ' + lc + '">' + esc(lbl) + '</div>'
        + '</div>';
    }).join('');
    grid.innerHTML = html;
  }

  // ── Signals fetch + render headline tiles ─────────────────────────────────
  async function fetchSignals() {
    try {
      var r = await fetch('/api/market/signals');
      if (!r.ok) throw new Error('HTTP ' + r.status);
      var d = await r.json();
      renderTiles(d.signals || [], d.capturedAt);
    } catch (_) {
      document.getElementById('tiles-grid').innerHTML =
        '<p class="text-muted" style="font-size:13px">Could not load signals.</p>';
    }
  }

  function renderTiles(signals, capturedAt) {
    var valMap = {};
    signals.forEach(function (s) { valMap[s.key] = s.currentValue; });

    var html = TILES.map(function (tile) {
      return makeCard(tile, valMap[tile.key] !== undefined ? valMap[tile.key] : null);
    }).join('');

    document.getElementById('tiles-grid').innerHTML = html;

    // Update live-bar timestamp
    if (capturedAt) {
      var el = document.getElementById('market-captured-at');
      if (el) el.textContent = 'as of ' + new Date(capturedAt).toLocaleTimeString();
    }

    // Reapply beginner mode to newly injected cards
    if (window.MKT && window.MKT.applyBeginner) window.MKT.applyBeginner();
  }

  // ── Price chart (LightweightCharts area series) ───────────────────────────
  var pxChart = null;
  var pxSeries = null;
  var pxTf = '4h';

  function getCssVar(n) {
    return getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  }

  function mountPriceChart() {
    if (pxChart) return;
    var LC = window.LightweightCharts;
    if (!LC) return;
    pxChart = LC.createChart(document.getElementById('px-chart'), {
      height: 240,
      layout: {
        background: { type: 'solid', color: getCssVar('--surface') || '#161b22' },
        textColor:  getCssVar('--muted')  || '#8b949e',
        attributionLogo: false,
      },
      grid: {
        vertLines: { color: getCssVar('--border') || '#30363d' },
        horzLines: { color: getCssVar('--border') || '#30363d' },
      },
      crosshair: { mode: 1 },
      rightPriceScale: { borderColor: getCssVar('--border') || '#30363d' },
      timeScale:  { borderColor: getCssVar('--border') || '#30363d', timeVisible: true, secondsVisible: false },
      handleScroll: { mouseWheel: true },
      handleScale:  { mouseWheel: true, pinch: true },
    });
    pxSeries = pxChart.addAreaSeries({
      lineColor:   getCssVar('--accent') || '#38BDF8',
      topColor:    'rgba(56,189,248,0.18)',
      bottomColor: 'rgba(56,189,248,0)',
      lineWidth: 2,
      priceFormat: { type: 'price', precision: 2, minMove: 0.01 },
    });
  }

  async function refreshPriceChart() {
    mountPriceChart();
    if (!pxChart || !pxSeries) return;
    var updEl = document.getElementById('px-chart-updated');
    try {
      var url  = '/api/candles/dynamic?coin=HYPE&interval=' + pxTf;
      var resp = await fetch(url);
      if (!resp.ok) return;
      var data = await resp.json();
      if (!data.candles || !data.candles.length) return;
      var areaData = data.candles.map(function (c) { return { time: c.time, value: c.close }; });
      pxSeries.setData(areaData);
      pxChart.timeScale().fitContent();
      if (updEl) updEl.textContent = 'updated ' + new Date().toLocaleTimeString();
    } catch (_) {
      if (updEl) updEl.textContent = 'error';
    }
  }

  document.getElementById('px-tf-group').addEventListener('click', function (e) {
    var btn = e.target.closest('[data-ptf]');
    if (!btn) return;
    pxTf = btn.getAttribute('data-ptf');
    document.querySelectorAll('#px-tf-group .tf').forEach(function (b) {
      b.classList.toggle('active', b === btn);
    });
    refreshPriceChart();
  });

  // ── Init ──────────────────────────────────────────────────────────────────
  fetchBias(activeH);
  fetchSignals();
  refreshPriceChart();

  // Refresh every 60s
  setInterval(function () {
    fetchBias(activeH);
    fetchSignals();
    refreshPriceChart();
  }, 60000);

})();
</script>
