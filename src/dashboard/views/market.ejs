<%- include('_head', { title: 'HYPE Market' }) %>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

  /* ═══════════════════════════════════════════════════════
     Market page: tinted blue-black palette override
     These `:root` additions override _head.ejs defaults for
     this page only. body.light from _head.ejs still wins in
     light mode (higher specificity), so light mode stays intact.
  ═══════════════════════════════════════════════════════ */
  :root {
    --bg:       #0A0E14;
    --surface:  #0D1520;
    --surface2: #111E2D;
    --border:   rgba(56,189,248,0.09);
    --muted:    #3D5A78;

    /* Type scale */
    --t-label:    11px;
    --t-value:    26px;
    --t-value-sm: 20px;
    --t-hero:     40px;
    --t-body:     13px;

    /* Spacing: 4 / 8 / 12 / 16 / 20 / 24 */
    --sp-1: 4px;
    --sp-2: 8px;
    --sp-3: 12px;
    --sp-4: 16px;
    --sp-5: 20px;
    --sp-6: 24px;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  /* Light mode still reads from _head.ejs body.light — no override needed */

  /* ── Sub-tab strip ──────────────────────────────────────────── */
  .market-tabs-bar {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .market-tabs-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .market-tabs-inner::-webkit-scrollbar { display: none; }
  .market-tab {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-size: 12px;
    font-family: inherit;
    font-weight: 500;
    padding: 0.55rem 0.75rem;
    cursor: pointer;
    white-space: nowrap;
    transition: color .12s;
    flex-shrink: 0;
  }
  .market-tab:hover  { color: var(--text); }
  .market-tab.active { color: var(--accent); border-bottom-color: var(--accent); }

  /* ── Live ticker bar ───────────────────────────────────────── */
  .market-ticker-bar {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    font-size: 11px;
    font-family: 'SFMono-Regular', Consolas, monospace;
    font-variant-numeric: tabular-nums;
    overflow: hidden;
  }
  .market-ticker-inner {
    padding: 0 var(--sp-6);
    height: 32px;
    display: flex;
    align-items: center;
    gap: 0;
  }
  .tk-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0 0.75rem;
    border-right: 1px solid var(--border);
    height: 100%;
    flex-shrink: 0;
  }
  .tk-item:first-child { padding-left: 0; }
  .tk-label {
    color: var(--muted);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: .07em;
  }
  .tk-val  { color: var(--text); }
  .tk-unit { color: var(--muted); font-size: 10px; }
  .tk-up   { color: var(--up); }
  .tk-dn   { color: var(--down); }
  .tk-live {
    margin-left: auto;
    padding-right: 0;
    border-right: none;
    color: var(--muted);
    gap: 0.35rem;
  }
  .dot-accent {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
    animation: pulse 2s infinite;
  }

  /* ── Layout — full-width, edge-to-edge ────────────────────── */
  .container {
    max-width: none;
    margin: 0;
    padding: var(--sp-4) var(--sp-6);
  }

  /* ── Main row: chart (left) + tiles (right) ─────────────── */
  .mkt-main-row {
    display: flex;
    gap: var(--sp-4);
    align-items: stretch;
    margin-bottom: var(--sp-4);
  }
  .mkt-chart-col {
    flex: 0 0 62%;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .mkt-chart-col .chart-card { flex: 1; display: flex; flex-direction: column; }
  .mkt-chart-col .chart-card-toolbar { flex-shrink: 0; }
  .mkt-chart-col #px-chart { flex: 1; }
  .mkt-tiles-col {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  /* ── Market toolbar ────────────────────────────────────────── */
  .market-toolbar {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
    flex-wrap: wrap;
  }
  .horizon-label {
    font-size: var(--t-label);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .08em;
    font-weight: 600;
  }
  .horizon-group { display: flex; gap: 2px; }
  .hz-btn {
    background: none;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
    font-family: inherit;
    padding: 2px 7px;
    border-radius: 3px;
    cursor: pointer;
    transition: color .1s, border-color .1s, background .1s;
  }
  .hz-btn:hover { color: var(--text); border-color: rgba(56,189,248,0.3); }
  .hz-btn.active {
    background: var(--accent-dim);
    border-color: var(--accent-border);
    color: var(--accent);
  }
  .beginner-toggle {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: auto;
    cursor: pointer;
    font-size: 11px;
    color: var(--muted);
    user-select: none;
  }
  .beginner-toggle input { cursor: pointer; accent-color: var(--accent); }
  .beginner-toggle.active { color: var(--accent); }

  /* ── Bias hero — two-column ────────────────────────────────── */
  .bias-hero {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--accent-border);
    border-radius: 0 0 8px 8px;
    padding: 0;
    margin-bottom: var(--sp-4);
    box-shadow: 0 2px 12px rgba(0,0,0,0.35);
    display: flex;
    align-items: stretch;
    min-height: 120px;
  }
  .bias-left {
    flex: 0 0 30%;
    min-width: 0;
    padding: var(--sp-5) var(--sp-6);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    justify-content: center;
  }
  .bias-right {
    flex: 1 1 0;
    min-width: 0;
    padding: var(--sp-5) var(--sp-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .bias-hero-top {
    display: flex;
    align-items: baseline;
    gap: .75rem;
    flex-wrap: wrap;
  }
  .bias-label {
    font-family: Georgia, 'Palatino Linotype', serif;
    font-size: var(--t-hero);
    font-weight: normal;
    letter-spacing: -.02em;
    line-height: 1;
    flex: 1;
  }
  .bias-label.bullish { color: var(--up);   }
  .bias-label.bearish { color: var(--down); }
  .bias-label.neutral { color: var(--muted); }
  .bias-label.warming { color: var(--muted); font-size: 28px; }
  .conf-badge {
    display: inline-block;
    padding: .2rem .55rem;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    flex-shrink: 0;
    align-self: center;
  }
  .conf-high { background: rgba(34,197,94,0.15);  color: var(--up);     }
  .conf-low  { background: rgba(56,189,248,0.10); color: var(--muted);  }

  /* Split bar */
  .bias-bar-row {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-2);
  }
  .bias-bar-wrap {
    position: relative;
    flex: 1;
    height: 8px;
    border-radius: 4px;
    background: rgba(56,189,248,0.06);
    overflow: hidden;
  }
  .bias-bar-bull {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    background: var(--up);
    transition: width .5s ease;
  }
  .bias-bar-bear {
    position: absolute;
    right: 0; top: 0; bottom: 0;
    background: var(--down);
    transition: width .5s ease;
  }
  .bias-bar-center {
    position: absolute;
    left: 50%;
    top: -1px; bottom: -1px;
    width: 2px;
    background: rgba(255,255,255,0.22);
    transform: translateX(-50%);
    z-index: 2;
  }
  .bias-score-val {
    font-size: var(--t-label);
    font-family: 'SFMono-Regular', Consolas, monospace;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    flex-shrink: 0;
    width: 4.5em;
    text-align: right;
  }
  .bias-counts {
    font-size: var(--t-label);
    color: var(--muted);
    margin-bottom: var(--sp-2);
  }
  .bias-counts .bc-up { color: var(--up);   }
  .bias-counts .bc-dn { color: var(--down); }
  .bias-warming-note {
    font-size: var(--t-label);
    color: var(--muted);
    font-style: italic;
    margin-bottom: var(--sp-2);
  }
  /* ── Driver panel (bias hero right column) ── */
  .bias-drivers-panel {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    height: 100%;
    justify-content: center;
  }
  .bias-drivers-empty {
    font-size: 11px;
    color: var(--muted);
    font-style: italic;
  }
  .bias-driver-group { display: flex; flex-direction: column; gap: .25rem; }
  .bias-driver-group-label {
    font-size: var(--t-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
    margin-bottom: var(--sp-1);
  }
  .bias-driver-group-label.bull { color: var(--up);   }
  .bias-driver-group-label.bear { color: var(--down); }
  .bias-driver-chips { display: flex; flex-wrap: wrap; gap: .25rem; }
  .driver-chip {
    display: inline-block;
    padding: .12rem .4rem;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 600;
  }
  .driver-chip.bull { background: rgba(34,197,94,0.13);  color: var(--up);   }
  .driver-chip.bear { background: rgba(239,68,68,0.13);  color: var(--down); }

  /* ── Category cards — 6-col full-width row ─────────────── */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--sp-2);
    margin-bottom: 0;
  }
  .cat-card {
    background: var(--surface);
    border: none;
    border-left: 3px solid rgba(56,189,248,0.15);
    border-radius: 0 5px 5px 0;
    padding: var(--sp-3) var(--sp-4);
    box-shadow: 0 1px 4px rgba(0,0,0,0.3);
    transition: border-left-color .15s;
  }
  .cat-card.bullish { border-left-color: var(--up);   }
  .cat-card.bearish { border-left-color: var(--down); }
  .cat-card.neutral { border-left-color: var(--muted); }
  .cat-card.warming { border-left-color: rgba(56,189,248,0.12); opacity: .7; }
  .cat-name { font-size: var(--t-label); font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: var(--sp-1); }
  .cat-bias { font-size: var(--t-body); font-weight: 600; }
  .cat-bias.bullish { color: var(--up);   }
  .cat-bias.bearish { color: var(--down); }
  .cat-bias.neutral, .cat-bias.warming { color: var(--muted); }

  /* ── Headline tiles — fixed 2-col inside the side column ── */
  .tiles-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-2);
    flex: 1;
    align-content: start;
  }
  .signal-card {
    background: var(--surface);
    border: none;
    border-radius: 6px;
    padding: var(--sp-5);
    min-height: 120px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    transition: box-shadow .15s;
  }
  .signal-card:hover {
    box-shadow: 0 4px 16px rgba(56,189,248,0.1);
  }
  .sc-header {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    margin-bottom: var(--sp-2);
  }
  .sc-label {
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--muted);
    font-weight: 600;
  }
  .sc-info-btn {
    background: none;
    border: none;
    color: var(--muted);
    font-size: var(--t-label);
    cursor: pointer;
    padding: 0;
    line-height: 1;
    transition: color .1s;
    opacity: .65;
  }
  .sc-info-btn:hover { color: var(--accent); opacity: 1; }
  .sc-value {
    font-size: var(--t-value);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.02em;
    line-height: 1;
    margin-bottom: var(--sp-2);
  }
  .sc-value.val-pos { color: var(--up);   }
  .sc-value.val-neg { color: var(--down); }
  .sc-subline {
    font-size: var(--t-body);
    color: var(--muted);
    margin-bottom: var(--sp-2);
  }
  .sc-read {
    font-size: var(--t-label);
    color: var(--muted);
    font-style: italic;
    margin-bottom: var(--sp-2);
    line-height: 1.5;
  }
  .sc-badges { display: flex; gap: var(--sp-1); flex-wrap: wrap; margin-top: auto; }
  .sc-badge {
    display: inline-block;
    padding: .08rem .35rem;
    border-radius: 20px;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .03em;
  }
  /* kind badges — color coded per spec */
  .sc-kind-level      { background: rgba(56,189,248,0.14);  color: #38BDF8; }
  .sc-kind-window     { background: rgba(245,158,11,0.14);  color: #F59E0B; }
  .sc-kind-delta-prev { background: rgba(139,92,246,0.14);  color: #A78BFA; }
  .sc-kind-ratio      { background: rgba(236,72,153,0.14);  color: #F472B6; }
  .sc-kind-aggregate  { background: rgba(34,211,238,0.14);  color: #22D3EE; }
  .sc-kind-count      { background: rgba(56,189,248,0.07);  color: var(--muted); }
  /* source badges — muted uniform pill */
  .sc-source {
    background: rgba(56,189,248,0.06);
    color: var(--muted);
  }

  /* ── Chart card ──────────────────────────────────────────── */
  .chart-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 1px 6px rgba(0,0,0,0.25);
  }
  .chart-card-toolbar {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-4);
    border-bottom: 1px solid var(--border);
    font-size: var(--t-label);
  }
  .chart-card-title { font-weight: 600; color: var(--text); }
  .chart-card-meta  { color: var(--muted); margin-left: auto; font-size: var(--t-label); }
  .tf-group { display: flex; gap: 2px; }
  .tf {
    background: none;
    border: none;
    color: var(--muted);
    font-size: 10px;
    font-family: inherit;
    padding: 2px 8px;
    border-radius: 20px;
    cursor: pointer;
    transition: color .1s, background .1s;
  }
  .tf:hover  { color: var(--text); background: rgba(56,189,248,0.07); }
  .tf.active { background: rgba(56,189,248,0.15); color: var(--accent); }

  /* ── Section label ───────────────────────────────────────── */
  .mkt-section-label {
    font-size: var(--t-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--muted);
    margin-bottom: var(--sp-2);
  }

  /* ── Stub tab placeholder ─────────────────────────────────── */
  .tab-stub {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 13px;
  }
  .tab-stub-title {
    font-family: Georgia, serif;
    font-size: 1.25rem;
    font-weight: normal;
    color: var(--text);
    margin-bottom: .5rem;
  }

  /* ── Tooltip ─────────────────────────────────────────────── */
  #market-tip {
    position: fixed;
    pointer-events: none;
    display: none;
    background: var(--surface2);
    border: 1px solid var(--accent-border);
    color: var(--text);
    font-size: 11px;
    padding: .4rem .65rem;
    border-radius: 5px;
    max-width: 220px;
    line-height: 1.5;
    z-index: 9999;
    box-shadow: 0 6px 20px rgba(0,0,0,.5);
  }

  /* ── Value-change flash ─────────────────────────────────── */
  @keyframes mkt-flash-up {
    from { background-color: rgba(34,197,94,0.22); }
    to   { background-color: transparent; }
  }
  @keyframes mkt-flash-down {
    from { background-color: rgba(239,68,68,0.22); }
    to   { background-color: transparent; }
  }
  .flash-up   { border-radius: 3px; animation: mkt-flash-up   700ms ease-out forwards; }
  .flash-down { border-radius: 3px; animation: mkt-flash-down 700ms ease-out forwards; }
  @media (prefers-reduced-motion: reduce) {
    .flash-up, .flash-down { animation: none !important; }
  }

  /* ── Responsive breakdowns ───────────────────────────────── */
  @media (max-width: 1100px) {
    .mkt-chart-col { flex-basis: 58%; }
  }
  @media (max-width: 900px) {
    .mkt-main-row  { flex-direction: column; }
    .mkt-chart-col, .mkt-tiles-col { flex: none; }
    .tiles-grid    { grid-template-columns: repeat(3, 1fr); align-content: start; }
    .cat-grid      { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 768px) {
    .market-tabs-inner   { padding: 0 .75rem; }
    .market-ticker-inner { padding: 0 .75rem; }
    .container           { padding: .75rem; }
    .bias-hero           { flex-direction: column; min-height: 0; }
    .bias-left           { flex: none; border-right: none; border-bottom: 1px solid var(--border); }
    .bias-right          { flex: none; }
    .bias-label          { font-size: 28px; }
    .tiles-grid          { grid-template-columns: 1fr 1fr; }
    .cat-grid            { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .cat-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<!-- ── Top nav: Bots | Market ── -->
<nav class="nav">
  <a href="/" class="nav-brand">HL Bot</a>
  <button class="hamburger" id="nav-hamburger" aria-label="Menu">&#9776;</button>
  <div class="nav-links" id="nav-links">
    <a href="/" class="nav-link">Bots</a>
    <a href="/market" class="nav-link active">Market</a>
  </div>
  <div class="nav-right">
    <span class="dot-accent"></span>
    <span class="badge badge-net"><%= network %></span>
    <% if (isAdmin) { %><a href="/logout" class="nav-link">Logout</a><% } else if (authConfigured) { %><a href="/login" class="nav-link">Login</a><% } %>
    <button class="theme-btn" id="theme-toggle" title="Toggle theme">&#9790;</button>
  </div>
</nav>

<!-- ── Sub-tab strip ── -->
<div class="market-tabs-bar">
  <div class="market-tabs-inner" id="market-tab-strip">
    <button class="market-tab active" data-tab="summary">Summary</button>
    <button class="market-tab" data-tab="timemachine">Time Machine</button>
    <button class="market-tab" data-tab="orderflow">Order Flow</button>
    <button class="market-tab" data-tab="leverage">Leverage</button>
    <button class="market-tab" data-tab="supply">Supply</button>
    <button class="market-tab" data-tab="onchain">On-chain</button>
    <button class="market-tab" data-tab="microstructure">Microstructure</button>
    <button class="market-tab" data-tab="liquidations">Liquidations</button>
    <button class="market-tab" data-tab="signals">Signals</button>
    <button class="market-tab" data-tab="data">Data</button>
    <button class="market-tab" data-tab="glossary">Glossary</button>
  </div>
</div>

<!-- ── Live ticker bar ── -->
<div class="market-ticker-bar">
  <div class="market-ticker-inner">
    <div class="tk-item">
      <span class="tk-label">HYPE</span>
      <span class="tk-val" id="tk-price">—</span>
      <span class="tk-val" id="tk-dir"></span>
    </div>
    <div class="tk-item">
      <span class="tk-label">FUNDING</span>
      <span class="tk-val" id="tk-funding">—</span>
    </div>
    <div class="tk-item">
      <span class="tk-label">CVD 24H</span>
      <span class="tk-val" id="tk-cvd">—</span>
    </div>
    <div class="tk-item">
      <span class="tk-label">SPREAD</span>
      <span class="tk-val" id="tk-spread">—</span>
      <span class="tk-unit">bps</span>
    </div>
    <div class="tk-item tk-live">
      <span class="dot-accent"></span>
      <span id="tk-upd">0</span>
      <span class="tk-unit">upd/min</span>
      <span class="tk-unit" id="market-captured-at" style="margin-left:.35rem"></span>
    </div>
  </div>
</div>

<!-- ── Tooltip ── -->
<div id="market-tip" role="tooltip"></div>

<!-- ── Page content ── -->
<div class="container" id="market-main">

  <!-- ════ SUMMARY ════ -->
  <div id="tab-summary" class="tab-panel">

    <!-- Toolbar -->
    <div class="market-toolbar">
      <span class="horizon-label">Horizon</span>
      <div class="horizon-group" id="horizon-group">
        <button class="hz-btn" data-h="4">4h</button>
        <button class="hz-btn active" data-h="24">24h</button>
        <button class="hz-btn" data-h="72">72h</button>
