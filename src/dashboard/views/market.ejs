      kind: 'aggregate', source: 'hl-native', fmt: fmtC,       dir: null, read: null },
    { key: 'twap_perp_buy_full_hype',  label: 'TWAP PERP BUY (FULL)',   beginner: 'Scheduled perp buying (full)',
      kind: 'aggregate', source: 'hl-native', fmt: fmtC,       dir: null, read: null },
