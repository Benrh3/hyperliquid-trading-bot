      kind: 'aggregate', source: 'hl-native', fmt: fmtC,       dir: null, read: null },
    // Counts + volume
    { key: 'spot_day_ntl_vlm',    label: 'SPOT VOLUME 24H',    beginner: 'Spot volume (24h)',
      kind: 'level',     source: 'hl-market', fmt: fmtC,       dir: null, read: null },
    { key: 'cvd_perp_trades_24h', label: 'FUTURES TRADES 24H', beginner: 'Futures trades (24h)',
      kind: 'count',     source: 'hl-market', fmt: fmtC,       dir: null, read: null },
    { key: 'cvd_spot_trades_24h', label: 'SPOT TRADES 24H',    beginner: 'Spot trades (24h)',
      kind: 'count',     source: 'hl-market', fmt: fmtC,       dir: null, read: null },
    { key: 'af_buy_usdc_window',  label: 'AF BUYS (USDC)',      beginner: 'Protocol buying (USDC)',
      kind: 'window',    source: 'hl-native', fmt: fmtC,       dir: null,
      read: 'USDC-denominated counterpart to HYPE leg — do not double-count for direction' },
    { key: 'af_buy_fills',        label: 'AF BUY FILLS',        beginner: 'Protocol buy fills',
      kind: 'count',     source: 'hl-native', fmt: fmtC,       dir: null, read: null },
    { key: 'twap_active_count',   label: 'ACTIVE TWAPS',        beginner: 'Active TWAPs',
      kind: 'count',     source: 'hl-native', fmt: fmtC,       dir: null, read: null },
  ];

  // ── Card builder ──────────────────────────────────────────────────────────
  function makeCard(tile, value) {
    var val     = (value !== null && value !== undefined) ? tile.fmt(value) : '—';
    var dirInfo = (tile.dir && value !== null && value !== undefined) ? tile.dir(value) : null;
    var valCls  = dirInfo && dirInfo.cls ? ' ' + dirInfo.cls : '';
    var dirCls  = dirInfo ? (dirInfo.cls ? ' sc-dir-' + dirInfo.cls.replace('val-', '') : ' sc-dir-neutral') : '';
    var srcCls  = SRC_CLS[tile.source] || '';
