<%- include('_head', { title: 'Dashboard' }) %>
<style>
  /* ── Chart panel ── */
  .chart-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  .chart-toolbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--border);
  }
  .chart-toolbar-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--text);
    margin-right: 0.25rem;
  }
  .tf-group { display: flex; gap: 3px; }
  .tf {
    background: none;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
    font-family: inherit;
    padding: 2px 7px;
    border-radius: 3px;
    cursor: pointer;
    transition: color .1s, border-color .1s;
  }
  .tf:hover:not(.active):not(:disabled) { color: var(--text); border-color: #8b949e; }
  .tf.active { background: rgba(88,166,255,0.12); border-color: var(--blue); color: var(--blue); }
  .tf:disabled { opacity: 0.4; cursor: default; }
  .chart-updated { margin-left: auto; font-size: 11px; color: var(--muted); }

  /* ── Chart rows ── */
  .chart-row { position: relative; }
  .chart-row-label {
    position: absolute;
    top: 5px; left: 10px;
    font-size: 10px;
    color: var(--muted);
    pointer-events: none;
    z-index: 2;
    letter-spacing: .04em;
  }
  #chart-candles { height: 450px; }
  #chart-volume  { height: 120px; border-top: 1px solid var(--border); }
  #chart-rsi     { height: 150px; border-top: 1px solid var(--border); }

  /* ── OHLC legend ── */
  #ohlc-legend {
    position: absolute;
    top: 8px; left: 10px;
    z-index: 3;
    font-size: 11px;
    font-family: 'SFMono-Regular', Consolas, monospace;
    color: var(--text);
    background: rgba(22,27,34,0.85);
    padding: 5px 10px;
    border-radius: 4px;
    pointer-events: none;
    line-height: 1.7;
    backdrop-filter: blur(2px);
  }
  #ohlc-legend .lbl { color: var(--muted); margin-right: 2px; }

  /* Hide TradingView attribution */
  .tv-lightweight-charts > table > tbody > tr:last-child { display: none !important; }

  /* ── Funding rate card ── */
  .card-funding { grid-column: span 2; }
  .funding-row { display: flex; gap: 1.5rem; margin-top: 0.35rem; flex-wrap: wrap; }
  .funding-item { display: flex; flex-direction: column; }
  .funding-item .fi-label { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
  .funding-item .fi-value { font-size: 13px; font-family: 'SFMono-Regular', Consolas, monospace; font-variant-numeric: tabular-nums; margin-top: 1px; }

  /* ── Equity chart panel ── */
  #chart-equity { height: 100px; border-top: 1px solid var(--border); }

  .chart-empty {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 13px;
  }

  /* ── Depth chart + order book ── */
  .ob-panel {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 768px) {
    .ob-panel { grid-template-columns: 1fr; }
  }
  .depth-card, .ob-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }
  .ob-header {
    padding: 0.4rem 0.875rem;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    font-weight: 600;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  #depth-canvas { display: block; width: 100%; height: 180px; }
  #ob-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
    font-family: 'SFMono-Regular', Consolas, monospace;
  }
  #ob-table th {
    padding: 3px 8px;
    font-size: 10px;
    color: var(--muted);
    font-weight: 500;
    text-align: right;
    border-bottom: 1px solid var(--border);
  }
  #ob-table th:first-child { text-align: left; }
  #ob-table td { padding: 2px 8px; text-align: right; }
  #ob-table td:first-child { text-align: left; }
  .ob-ask { color: #f85149; background: rgba(248,81,73,0.05); }
  .ob-bid { color: #3fb950; background: rgba(63,185,80,0.05); }
  .ob-spread { color: var(--muted); text-align: center !important; font-size: 10px; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
</style>

<nav class="nav">
  <a href="/" class="nav-brand">HL Bot</a>
  <button class="hamburger" id="nav-hamburger" aria-label="Menu">&#9776;</button>
  <div class="nav-links" id="nav-links">
    <a href="/" class="nav-link active">Overview</a>
    <a href="/strategies" class="nav-link">Strategies</a>
    <a href="/trades" class="nav-link">Trades</a>
    <a href="/backtest" class="nav-link">Backtest</a>
  </div>
  <div class="nav-right">
    <span class="dot"></span>
    <span class="badge badge-net"><%= network %></span>
    <span class="text-muted"><%= coin %> &middot; <%= strategy %> &middot; <span id="nav-interval"><%= interval %></span></span>
    <button class="theme-btn" id="theme-toggle" title="Toggle theme">&#9790;</button>
  </div>
</nav>

<div class="container">

  <!-- Stat cards -->
  <div class="grid">
    <!-- Per-coin price cards -->
    <% for (const c of coins) { %>
    <% const cp = state.lastPrices[c] || { mid: 0, bid: 0, ask: 0 }; %>
    <div class="card" id="card-<%= c %>">
      <div class="card-label"><%= c %> Price</div>
      <div class="card-value mono" id="stat-price-<%= c %>" style="font-size:1.3rem">
        <% if (cp.mid > 0) { %>
          $<%= cp.mid.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) %>
        <% } else { %><span class="text-muted">—</span><% } %>
      </div>
      <div class="card-sub" id="stat-bidask-<%= c %>">
        <% if (cp.bid > 0) { %>
          bid $<%= cp.bid.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) %> / ask $<%= cp.ask.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) %>
        <% } else { %>awaiting feed…<% } %>
      </div>
    </div>
    <% } %>

    <div class="card">
      <div class="card-label">Spread (<%= coin %>)</div>
      <div class="card-value mono" style="font-size:1.3rem" id="stat-spread">
        <% if (primaryPrice.bid > 0) { %>
          $<%= (primaryPrice.ask - primaryPrice.bid).toFixed(2) %>
        <% } else { %><span class="text-muted">—</span><% } %>
      </div>
      <div class="card-sub" id="stat-spread-pct">
        <% if (primaryPrice.bid > 0) { %>
          <%= ((primaryPrice.ask - primaryPrice.bid) / primaryPrice.bid * 100).toFixed(4) %>%
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-label">Signals</div>
      <div class="card-value" id="stat-signals"><%= state.signalCount %></div>
      <div class="card-sub">generated this session</div>
    </div>

    <div class="card">
      <div class="card-label">Trades</div>
      <div class="card-value" id="stat-trades"><%= tradeCount %></div>
      <div class="card-sub">total recorded</div>
    </div>

    <div class="card">
      <div class="card-label">Uptime</div>
      <div class="card-value mono" style="font-size:1.2rem;padding-top:4px" id="stat-uptime"><%= uptime %></div>
      <div class="card-sub" id="stat-lastupdate">
        <% if (state.lastUpdate) { %>last tick <%= state.lastUpdate.toLocaleTimeString() %><% } else { %>no ticks yet<% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-label">P&amp;L</div>
      <div class="card-value mono" style="font-size:1.2rem" id="stat-upnl"><span class="text-muted">—</span></div>
      <div class="card-sub mono" id="stat-rpnl"><span class="text-muted">Realised: —</span></div>
    </div>

    <!-- Funding rate card — wider -->
    <div class="card card-funding">
      <div class="card-label">Funding Rate &nbsp;<span class="text-muted" style="font-weight:400;text-transform:none;letter-spacing:0" id="fr-countdown"></span></div>
      <div class="funding-row">
        <div class="funding-item">
          <span class="fi-label">Current</span>
          <span class="fi-value" id="fr-current"><span class="text-muted">—</span></span>
        </div>
        <div class="funding-item">
          <span class="fi-label">Predicted</span>
          <span class="fi-value" id="fr-predicted"><span class="text-muted">—</span></span>
        </div>
        <div class="funding-item">
          <span class="fi-label">Annualized</span>
          <span class="fi-value" id="fr-annualized"><span class="text-muted">—</span></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Depth chart + order book -->
  <div class="ob-panel">
    <div class="depth-card">
      <div class="ob-header">
        Market Depth
        <span class="text-muted" id="depth-coin-label" style="font-weight:400;font-size:11px"><%= coin %>/USDT</span>
      </div>
      <canvas id="depth-canvas"></canvas>
    </div>
    <div class="ob-card">
      <div class="ob-header">Order Book <span class="text-muted" style="font-weight:400;font-size:11px">(top 10)</span></div>
      <table id="ob-table">
        <thead>
          <tr>
            <th>Price</th>
            <th>Size</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody id="ob-tbody"></tbody>
      </table>
    </div>
  </div>

  <!-- Chart panel -->
  <div class="chart-panel">
    <div class="chart-toolbar">
      <span class="chart-toolbar-title" id="chart-coin-label"><%= coin %>/USDT</span>
      <select id="chart-coin-select" style="background:var(--surface);border:1px solid var(--border);color:var(--text);font-size:11px;padding:3px 6px;border-radius:3px;cursor:pointer;margin-right:4px">
        <% for (const c of coins) { %>
          <option value="<%= c %>" <%= c === coin ? 'selected' : '' %>><%= c %></option>
        <% } %>
      </select>
      <div class="tf-group">
        <button class="tf <%= interval === '1m'  ? 'active' : '' %>" data-tf="1m">1m</button>
        <button class="tf <%= interval === '5m'  ? 'active' : '' %>" data-tf="5m">5m</button>
        <button class="tf <%= interval === '15m' ? 'active' : '' %>" data-tf="15m">15m</button>
        <button class="tf <%= interval === '1h'  ? 'active' : '' %>" data-tf="1h">1h</button>
        <button class="tf <%= interval === '4h'  ? 'active' : '' %>" data-tf="4h">4h</button>
      </div>
      <span class="chart-updated" id="chart-updated"></span>
    </div>

    <div class="chart-row">
      <div class="chart-row-label">Candles</div>
      <div id="chart-candles">
        <div id="ohlc-legend"></div>
      </div>
    </div>

    <div class="chart-row">
      <div class="chart-row-label">Volume &nbsp;<span style="color:#d29922;font-size:9px">· spread</span></div>
      <div id="chart-volume"></div>
    </div>

    <div class="chart-row">
      <div class="chart-row-label">RSI 14</div>
      <div id="chart-rsi"></div>
    </div>

    <div class="chart-row">
      <div class="chart-row-label">Equity</div>
      <div id="chart-equity"></div>
    </div>
  </div>

  <!-- Recent events -->
  <p class="section-title">Recent Events</p>
  <div class="table-wrap">
    <% if (events.length === 0) { %>
      <p class="empty" id="events-empty">No events yet — start the bot to see activity.</p>
    <% } else { %>
      <table>
        <thead>
          <tr><th>Time</th><th>Module</th><th>Level</th><th>Message</th></tr>
        </thead>
        <tbody id="events-tbody">
          <% for (const ev of events) { %>
            <tr>
              <td class="mono text-muted" style="white-space:nowrap"><%= ev.created_at %></td>
              <td><%= ev.module %></td>
              <td><span class="badge badge-<%= ev.level %>"><%= ev.level %></span></td>
              <td><%= ev.message %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </div>

</div>

<script src="https://unpkg.com/lightweight-charts@4/dist/lightweight-charts.standalone.production.js"></script>
<script>
(function () {
  const LC = LightweightCharts;

  // ── Shared chart options ────────────────────────────────────────────────
  function getCssVar(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }
  function chartOpts() {
    return {
      layout: {
        background: { type: 'solid', color: getCssVar('--surface') || '#161b22' },
        textColor:  getCssVar('--muted')  || '#8b949e',
        attributionLogo: false,
      },
      grid: {
        vertLines: { color: getCssVar('--border') || '#21262d' },
        horzLines: { color: getCssVar('--border') || '#21262d' },
      },
      crosshair: { mode: 1 },
      rightPriceScale: { borderColor: getCssVar('--border') || '#30363d' },
      handleScroll: { mouseWheel: true, pressedMouseMove: true },
      handleScale: { mouseWheel: true, pinch: true },
    };
  }
  const commonOpts = chartOpts();

  const timeScaleOpts = { borderColor: '#30363d', timeVisible: true, secondsVisible: false };

  // ── Three chart instances ───────────────────────────────────────────────
  const candleChart = LC.createChart(document.getElementById('chart-candles'), {
    ...commonOpts,
    height: 450,
    timeScale: { ...timeScaleOpts, visible: false },
  });

  const volChart = LC.createChart(document.getElementById('chart-volume'), {
    ...commonOpts,
    height: 120,
    timeScale: { ...timeScaleOpts, visible: false },
  });

  const rsiChart = LC.createChart(document.getElementById('chart-rsi'), {
    ...commonOpts,
    height: 150,
    timeScale: { ...timeScaleOpts, visible: false },
  });

  const equityChart = LC.createChart(document.getElementById('chart-equity'), {
    ...commonOpts,
    height: 100,
    timeScale: timeScaleOpts,
  });

  // ── Candlestick series ──────────────────────────────────────────────────
  const candleSeries = candleChart.addCandlestickSeries({
    upColor:         '#3fb950',
    downColor:       '#f85149',
    borderUpColor:   '#3fb950',
    borderDownColor: '#f85149',
    wickUpColor:     '#3fb950',
    wickDownColor:   '#f85149',
  });

  // ── Volume histogram ────────────────────────────────────────────────────
  const volSeries = volChart.addHistogramSeries({
    priceFormat:  { type: 'volume' },
    priceScaleId: '',
  });
  volChart.priceScale('').applyOptions({ scaleMargins: { top: 0.05, bottom: 0.2 } });

  // ── Spread line (secondary, hidden scale) ───────────────────────────────
  const spreadSeries = volChart.addLineSeries({
    color:        '#d29922',
    lineWidth:    1,
    priceScaleId: 'spread',
  });
  volChart.priceScale('spread').applyOptions({
    scaleMargins: { top: 0.6, bottom: 0 },
    visible: false,
  });

  // ── RSI line ────────────────────────────────────────────────────────────
  const rsiSeries = rsiChart.addLineSeries({ color: '#58a6ff', lineWidth: 1 });
  rsiChart.priceScale('right').applyOptions({ scaleMargins: { top: 0.1, bottom: 0.1 } });
  rsiSeries.createPriceLine({ price: 70, color: '#f85149', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: '70' });
  rsiSeries.createPriceLine({ price: 30, color: '#3fb950', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: '30' });

  // ── Equity curve line ───────────────────────────────────────────────────
  const equitySeries = equityChart.addAreaSeries({
    lineColor:      '#58a6ff',
    topColor:       'rgba(88,166,255,0.2)',
    bottomColor:    'rgba(88,166,255,0)',
    lineWidth:      1,
    priceFormat:    { type: 'price', precision: 2, minMove: 0.01 },
  });
  equityChart.priceScale('right').applyOptions({ scaleMargins: { top: 0.1, bottom: 0.1 } });

  // ── Time-scale sync ─────────────────────────────────────────────────────
  let syncing = false;
  function syncFrom(src, targets) {
    src.timeScale().subscribeVisibleLogicalRangeChange((range) => {
      if (syncing || !range) return;
      syncing = true;
      targets.forEach((t) => t.timeScale().setVisibleLogicalRange(range));
      syncing = false;
    });
  }
  syncFrom(candleChart, [volChart, rsiChart]);
  syncFrom(volChart,    [candleChart, rsiChart]);
  syncFrom(rsiChart,    [candleChart, volChart]);

  // ── Crosshair sync ──────────────────────────────────────────────────────
  // Maps from time (seconds) → data value, for look-up in crosshair handlers
  const volMap = new Map();
  const rsiMap = new Map();

  let crossSyncing = false;

  candleChart.subscribeCrosshairMove((param) => {
    if (crossSyncing) return;
    crossSyncing = true;
    if (!param.point || !param.time) {
      volChart.clearCrosshairPosition();
      rsiChart.clearCrosshairPosition();
    } else {
      const t = param.time;
      volChart.setCrosshairPosition(volMap.get(t) ?? 0, t, volSeries);
      rsiChart.setCrosshairPosition(rsiMap.get(t) ?? 50, t, rsiSeries);
    }
    crossSyncing = false;
  });

  volChart.subscribeCrosshairMove((param) => {
    if (crossSyncing) return;
    crossSyncing = true;
    if (!param.point || !param.time) {
      candleChart.clearCrosshairPosition();
      rsiChart.clearCrosshairPosition();
    } else {
      rsiChart.setCrosshairPosition(rsiMap.get(param.time) ?? 50, param.time, rsiSeries);
    }
    crossSyncing = false;
  });

  rsiChart.subscribeCrosshairMove((param) => {
    if (crossSyncing) return;
    crossSyncing = true;
    if (!param.point || !param.time) {
      candleChart.clearCrosshairPosition();
      volChart.clearCrosshairPosition();
    } else {
      volChart.setCrosshairPosition(volMap.get(param.time) ?? 0, param.time, volSeries);
    }
    crossSyncing = false;
  });

  // ── OHLC legend ─────────────────────────────────────────────────────────
  const legend = document.getElementById('ohlc-legend');
  let latestCandle = null;

  function renderLegend(bar) {
    if (!bar || !legend) return;
    const pct = ((bar.close - bar.open) / bar.open * 100);
    const col = pct >= 0 ? '#3fb950' : '#f85149';
    legend.innerHTML =
      '<span class="lbl">O</span>' + bar.open.toFixed(1) + '&nbsp;&nbsp;' +
      '<span class="lbl">H</span>' + bar.high.toFixed(1) + '&nbsp;&nbsp;' +
      '<span class="lbl">L</span>' + bar.low.toFixed(1)  + '&nbsp;&nbsp;' +
      '<span class="lbl">C</span>' + bar.close.toFixed(1) + '&nbsp;&nbsp;' +
      '<span style="color:' + col + '">' + (pct >= 0 ? '+' : '') + pct.toFixed(2) + '%</span>';
  }

  candleChart.subscribeCrosshairMove((param) => {
    if (param.time && param.seriesData && param.seriesData.size > 0) {
      const bar = param.seriesData.get(candleSeries);
      if (bar) renderLegend(bar);
    } else if (latestCandle) {
      renderLegend(latestCandle);
    }
  });

  // ── fitAll ──────────────────────────────────────────────────────────────
  function fitAll() {
    candleChart.timeScale().fitContent();
    // volChart and rsiChart follow via sync
  }

  // ── Chart data refresh ──────────────────────────────────────────────────
  let firstLoad = true;
  let chartCoin = document.getElementById('chart-coin-select')?.value || '';

  async function refreshChart() {
    const coinParam = document.getElementById('chart-coin-select')?.value || chartCoin;
    try {
      const data = await fetch('/api/candles?coin=' + coinParam).then((r) => r.json());
      if (!data.candles || data.candles.length === 0) return;

      candleSeries.setData(data.candles);
      candleSeries.setMarkers(data.markers || []);
      volSeries.setData(data.volume);
      if (data.rsi && data.rsi.length > 0) rsiSeries.setData(data.rsi);
      if (data.spread && data.spread.length > 0) spreadSeries.setData(data.spread);

      // Rebuild lookup maps for crosshair sync
      volMap.clear();
      (data.volume || []).forEach((d) => volMap.set(d.time, d.value));
      rsiMap.clear();
      (data.rsi || []).forEach((d) => rsiMap.set(d.time, d.value));

      if (firstLoad) { fitAll(); firstLoad = false; }

      // Update OHLC legend with latest candle
      latestCandle = data.candles[data.candles.length - 1];
      renderLegend(latestCandle);

      const el = document.getElementById('chart-updated');
      if (el) el.textContent = 'updated ' + new Date().toLocaleTimeString();
    } catch (e) {
      console.warn('Chart refresh failed:', e);
    }
  }

  refreshChart();
  setInterval(refreshChart, 10000);

  // Coin selector → reload chart
  document.getElementById('chart-coin-select')?.addEventListener('change', (e) => {
    chartCoin = e.target.value;
    const labelEl = document.getElementById('chart-coin-label');
    if (labelEl) labelEl.textContent = chartCoin + '/USDT';
    firstLoad = true;
    refreshChart();
  });

  // ── Stats refresh (no page reload) ─────────────────────────────────────
  function fmtPrice(p) {
    return '$' + p.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  }

  async function refreshStatus() {
    try {
      const d = await fetch('/api/status').then((r) => r.json());

      // Per-coin price cards
      if (d.prices) {
        for (const [c, cp] of Object.entries(d.prices)) {
          const priceEl = document.getElementById('stat-price-' + c);
          if (priceEl && cp.mid > 0) priceEl.textContent = fmtPrice(cp.mid);
          const baEl = document.getElementById('stat-bidask-' + c);
          if (baEl && cp.bid > 0) baEl.textContent = 'bid ' + fmtPrice(cp.bid) + ' / ask ' + fmtPrice(cp.ask);
        }
      }

      if (d.bid > 0) {
        const sEl = document.getElementById('stat-spread');
        if (sEl) sEl.textContent = '$' + d.spread.toFixed(2);
        const spEl = document.getElementById('stat-spread-pct');
        if (spEl) spEl.textContent = d.spreadPct.toFixed(4) + '%';
      }

      const sigEl = document.getElementById('stat-signals');
      if (sigEl) sigEl.textContent = d.signalCount;
      const trEl = document.getElementById('stat-trades');
      if (trEl) trEl.textContent = d.tradeCount;
      const upEl = document.getElementById('stat-uptime');
      if (upEl) upEl.textContent = d.uptime;
      const luEl = document.getElementById('stat-lastupdate');
      if (luEl) luEl.textContent = d.lastUpdate ? 'last tick ' + new Date(d.lastUpdate).toLocaleTimeString() : 'no ticks yet';

      // Update nav interval label
      const navEl = document.getElementById('nav-interval');
      if (navEl && d.interval) navEl.textContent = d.interval;
    } catch (_) {}
  }

  refreshStatus();
  setInterval(refreshStatus, 3000);

  // ── Events table refresh ────────────────────────────────────────────────
  const badgeClass = { info: 'badge-info', warn: 'badge-warn', error: 'badge-error', debug: 'badge-info' };

  async function refreshEvents() {
    try {
      const events = await fetch('/api/events').then((r) => r.json());
      const tbody = document.getElementById('events-tbody');
      if (!tbody) {
        // First load rendered a static empty state — create table dynamically if needed
        return;
      }
      tbody.innerHTML = events.map((ev) =>
        '<tr>' +
        '<td class="mono text-muted" style="white-space:nowrap">' + ev.created_at + '</td>' +
        '<td>' + ev.module + '</td>' +
        '<td><span class="badge ' + (badgeClass[ev.level] || 'badge-info') + '">' + ev.level + '</span></td>' +
        '<td>' + ev.message + '</td>' +
        '</tr>'
      ).join('');
    } catch (_) {}
  }

  refreshEvents();
  setInterval(refreshEvents, 10000);

  // ── Funding rate card ───────────────────────────────────────────────────
  let nextFundingTs = null;

  async function refreshFunding() {
    try {
      const d = await fetch('/api/funding-rate').then((r) => r.json());
      if (d.error) return;

      function rateHtml(rate) {
        if (rate === null || rate === undefined) return '<span class="text-muted">—</span>';
        const pct = (rate * 100).toFixed(4);
        const col = rate > 0.0003 ? '#f85149' : rate < 0 ? '#3fb950' : '#e6edf3';
        return '<span style="color:' + col + '">' + pct + '%/hr</span>';
      }

      const curEl = document.getElementById('fr-current');
      if (curEl) curEl.innerHTML = rateHtml(d.currentRate);

      const predEl = document.getElementById('fr-predicted');
      if (predEl) predEl.innerHTML = rateHtml(d.predictedRate);

      const annEl = document.getElementById('fr-annualized');
      if (annEl && d.annualizedPct !== null) {
        const col = d.annualizedPct > 10 ? '#f85149' : d.annualizedPct < 0 ? '#3fb950' : '#e6edf3';
        annEl.innerHTML = '<span style="color:' + col + '">' + Number(d.annualizedPct).toFixed(1) + '%/yr</span>';
      }

      if (d.nextFundingTime) nextFundingTs = d.nextFundingTime;
    } catch (_) {}
  }

  refreshFunding();
  setInterval(refreshFunding, 60000);

  // Countdown timer (1s resolution)
  function tickFundingCountdown() {
    const el = document.getElementById('fr-countdown');
    if (!el) return;
    if (!nextFundingTs) { el.textContent = ''; return; }
    const diff = nextFundingTs - Date.now();
    if (diff <= 0) { el.textContent = 'settling…'; refreshFunding(); return; }
    const h = Math.floor(diff / 3_600_000);
    const m = Math.floor((diff % 3_600_000) / 60_000);
    const s = Math.floor((diff % 60_000) / 1_000);
    el.textContent = 'next in ' + h + 'h ' + m + 'm ' + (s < 10 ? '0' : '') + s + 's';
  }
  setInterval(tickFundingCountdown, 1000);

  // ── P&L and equity refresh ──────────────────────────────────────────────
  let equityFirstLoad = true;

  async function refreshPnl() {
    try {
      const d = await fetch('/api/pnl').then((r) => r.json());

      const upnlEl = document.getElementById('stat-upnl');
      if (upnlEl) {
        if (d.unrealisedPnl !== null && d.unrealisedPnl !== undefined) {
          const pct = d.unrealisedPnlPercent != null ? ' (' + (d.unrealisedPnlPercent >= 0 ? '+' : '') + d.unrealisedPnlPercent.toFixed(2) + '%)' : '';
          const col = d.unrealisedPnl >= 0 ? '#3fb950' : '#f85149';
          upnlEl.innerHTML = '<span style="color:' + col + '">' + (d.unrealisedPnl >= 0 ? '+' : '') + '$' + Math.abs(d.unrealisedPnl).toFixed(2) + pct + '</span>';
        } else {
          upnlEl.innerHTML = '<span class="text-muted">No position</span>';
        }
      }

      const rpnlEl = document.getElementById('stat-rpnl');
      if (rpnlEl && d.realisedPnl !== null && d.realisedPnl !== undefined) {
        const col = d.realisedPnl >= 0 ? '#3fb950' : '#f85149';
        rpnlEl.innerHTML = 'Realised: <span style="color:' + col + '">' + (d.realisedPnl >= 0 ? '+' : '') + '$' + d.realisedPnl.toFixed(2) + '</span>';
      }

      if (d.equityHistory && d.equityHistory.length > 0) {
        const eq = d.equityHistory.map((p) => ({
          time:  Math.floor(p.time / 1000),
          value: p.equity,
        }));
        equitySeries.setData(eq);
        if (equityFirstLoad) { equityChart.timeScale().fitContent(); equityFirstLoad = false; }
      }
    } catch (_) {}
  }

  refreshPnl();
  setInterval(refreshPnl, 10000);

  // ── Depth chart + order book ────────────────────────────────────────────
  const depthCanvas = document.getElementById('depth-canvas');

  function drawDepth(ob) {
    if (!depthCanvas) return;
    // Sync canvas buffer size to CSS size
    const cssW = depthCanvas.offsetWidth;
    const cssH = depthCanvas.offsetHeight;
    if (cssW === 0 || cssH === 0) return;
    if (depthCanvas.width !== cssW || depthCanvas.height !== cssH) {
      depthCanvas.width  = cssW;
      depthCanvas.height = cssH;
    }
    const ctx = depthCanvas.getContext('2d');
    if (!ctx) return;
    const W = cssW, H = cssH;
    ctx.clearRect(0, 0, W, H);

    const bids = ob.bids || [];
    const asks = ob.asks || [];
    if (bids.length === 0 || asks.length === 0) {
      ctx.fillStyle = getCssVar('--muted') || '#8b949e';
      ctx.font = '12px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Awaiting order book data…', W / 2, H / 2);
      return;
    }

    const minPrice  = bids[bids.length - 1].price;
    const maxPrice  = asks[asks.length - 1].price;
    const midPrice  = (bids[0].price + asks[0].price) / 2;
    const priceSpan = maxPrice - minPrice;
    if (priceSpan <= 0) return;

    const maxCum = Math.max(bids[bids.length - 1].total, asks[asks.length - 1].total);
    if (maxCum <= 0) return;

    const PAD_TOP = 0.08, PAD_BOT = 0.15;
    const toX = (p) => ((p - minPrice) / priceSpan) * W;
    const toY = (s) => H * (1 - PAD_BOT) - (s / maxCum) * H * (1 - PAD_TOP - PAD_BOT);
    const midX = toX(midPrice);

    // ── Bids fill ──
    ctx.beginPath();
    ctx.moveTo(toX(minPrice), H);
    ctx.lineTo(toX(minPrice), toY(bids[bids.length - 1].total));
    for (let i = bids.length - 1; i >= 0; i--) {
      const nP = i > 0 ? bids[i - 1].price : midPrice;
      const nT = i > 0 ? bids[i - 1].total : 0;
      ctx.lineTo(toX(nP), toY(bids[i].total));
      ctx.lineTo(toX(nP), toY(nT));
    }
    ctx.lineTo(midX, H);
    ctx.closePath();
    ctx.fillStyle = 'rgba(63,185,80,0.15)';
    ctx.fill();

    // ── Bids outline ──
    ctx.beginPath();
    ctx.moveTo(toX(minPrice), toY(bids[bids.length - 1].total));
    for (let i = bids.length - 1; i >= 0; i--) {
      const nP = i > 0 ? bids[i - 1].price : midPrice;
      const nT = i > 0 ? bids[i - 1].total : 0;
      ctx.lineTo(toX(nP), toY(bids[i].total));
      ctx.lineTo(toX(nP), toY(nT));
    }
    ctx.strokeStyle = '#3fb950';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // ── Asks fill ──
    ctx.beginPath();
    ctx.moveTo(midX, H);
    ctx.lineTo(midX, toY(0));
    for (let i = 0; i < asks.length; i++) {
      const pT = i > 0 ? asks[i - 1].total : 0;
      ctx.lineTo(toX(asks[i].price), toY(pT));
      ctx.lineTo(toX(asks[i].price), toY(asks[i].total));
    }
    ctx.lineTo(W, toY(asks[asks.length - 1].total));
    ctx.lineTo(W, H);
    ctx.closePath();
    ctx.fillStyle = 'rgba(248,81,73,0.15)';
    ctx.fill();

    // ── Asks outline ──
    ctx.beginPath();
    ctx.moveTo(midX, toY(0));
    for (let i = 0; i < asks.length; i++) {
      const pT = i > 0 ? asks[i - 1].total : 0;
      ctx.lineTo(toX(asks[i].price), toY(pT));
      ctx.lineTo(toX(asks[i].price), toY(asks[i].total));
    }
    ctx.lineTo(W, toY(asks[asks.length - 1].total));
    ctx.strokeStyle = '#f85149';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // ── Mid price dashed line ──
    ctx.beginPath();
    ctx.setLineDash([4, 4]);
    ctx.strokeStyle = 'rgba(139,148,158,0.4)';
    ctx.lineWidth = 1;
    ctx.moveTo(midX, 0);
    ctx.lineTo(midX, H * (1 - PAD_BOT));
    ctx.stroke();
    ctx.setLineDash([]);

    // ── X axis price labels ──
    const fmtP = (p) => p >= 10000 ? p.toFixed(0) : p >= 100 ? p.toFixed(1) : p.toFixed(2);
    ctx.fillStyle = 'rgba(139,148,158,0.8)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'left';
    ctx.fillText(fmtP(minPrice), 4, H - 3);
    ctx.textAlign = 'center';
    ctx.fillText(fmtP(midPrice), midX, H - 3);
    ctx.textAlign = 'right';
    ctx.fillText(fmtP(maxPrice), W - 4, H - 3);
  }

  function updateObTable(ob) {
    const tbody = document.getElementById('ob-tbody');
    if (!tbody) return;
    const bids = (ob.bids || []).slice(0, 10);
    const asks = (ob.asks || []).slice(0, 10);
    const spread = bids.length > 0 && asks.length > 0 ? asks[0].price - bids[0].price : null;
    const fmtP = (p) => p >= 10000 ? p.toFixed(1) : p.toFixed(2);
    const fmtS = (s) => s >= 100 ? s.toFixed(1) : s >= 10 ? s.toFixed(2) : s.toFixed(3);
    let rows = '';
    // Asks: worst → best (so best ask sits adjacent to spread row)
    for (const a of [...asks].reverse()) {
      rows += `<tr class="ob-ask"><td>${fmtP(a.price)}</td><td>${fmtS(a.size)}</td><td>${fmtS(a.total)}</td></tr>`;
    }
    const spreadTxt = spread !== null ? '$' + spread.toFixed(2) + ' spread' : '— spread —';
    rows += `<tr class="ob-spread"><td colspan="3" style="padding:3px 8px">${spreadTxt}</td></tr>`;
    // Bids: best → worst
    for (const b of bids) {
      rows += `<tr class="ob-bid"><td>${fmtP(b.price)}</td><td>${fmtS(b.size)}</td><td>${fmtS(b.total)}</td></tr>`;
    }
    tbody.innerHTML = rows;
  }

  async function refreshOrderbook() {
    const coinParam = document.getElementById('chart-coin-select')?.value || '';
    try {
      const ob = await fetch('/api/orderbook?coin=' + coinParam).then((r) => r.json());
      const labelEl = document.getElementById('depth-coin-label');
      if (labelEl) labelEl.textContent = coinParam + '/USDT';
      drawDepth(ob);
      updateObTable(ob);
    } catch (_) {}
  }

  refreshOrderbook();
  setInterval(refreshOrderbook, 2000);

  // Coin selector also clears + refetches order book
  document.getElementById('chart-coin-select')?.addEventListener('change', () => {
    void refreshOrderbook();
  });

  // ── Timeframe buttons ───────────────────────────────────────────────────
  document.querySelectorAll('.tf').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const interval = btn.dataset.tf;
      if (!interval) return;

      document.querySelectorAll('.tf').forEach((b) => { b.classList.remove('active'); b.disabled = false; });
      btn.classList.add('active');
      btn.disabled = true;

      try {
        const res = await fetch('/api/interval', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ interval }),
        });
        if (res.ok) {
          firstLoad = true; // re-fit after new data loads
          await refreshChart();
        } else {
          console.warn('Interval change failed:', await res.text());
        }
      } catch (e) {
        console.warn('Interval change error:', e);
      } finally {
        btn.disabled = false;
      }
    });
  });

  // ── Resize observer ─────────────────────────────────────────────────────
  if (typeof ResizeObserver !== 'undefined') {
    const ro = new ResizeObserver(() => {
      [candleChart, volChart, rsiChart, equityChart].forEach((c) => c.applyOptions({ width: 0 }));
    });
    ro.observe(document.querySelector('.chart-panel'));
  }

})();
</script>
</body>
</html>
