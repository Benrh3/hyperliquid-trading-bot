<!-- ── Shared number-formatting utility (window.FMT) ── -->
<script>
(function () {
  'use strict';
  var HOURS_PER_YEAR = 8760;

  window.FMT = {
    /** Compact USD with sign: +$12.34 / -$2.50 / — */
    pnl: function (v) {
      if (v == null || !isFinite(v)) return '—';
      var abs  = Math.abs(v);
      var sign = v < 0 ? '-' : '+';
      return sign + '$' + abs.toFixed(2);
    },
    /** Compact USD no sign, SI suffix: $1.2B / $34.5M / $1.2K / $99 */
    oi: function (v) {
      if (v == null || !isFinite(v) || v === 0) return '—';
      var abs = Math.abs(v);
      if (abs >= 1e9) return '$' + (abs / 1e9).toFixed(2) + 'B';
      if (abs >= 1e6) return '$' + (abs / 1e6).toFixed(1) + 'M';
      if (abs >= 1e3) return '$' + (abs / 1e3).toFixed(0) + 'K';
      return '$' + abs.toFixed(0);
    },
    /** Full USD for the equity chart tooltip: $1,234.56 */
    usd: function (v) {
      if (v == null || !isFinite(v)) return '—';
      return '$' + Math.abs(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    },
    /** Hourly funding rate with sign: +0.0042% */
    rate: function (r) {
      if (r == null || !isFinite(r)) return null;
      var sign = r >= 0 ? '+' : '';
      return sign + (r * 100).toFixed(4) + '%';
    },
    /** Annualized rate: +36.8%/yr — capped at ±300%/yr (winsorised) */
    ann: function (r) {
      if (r == null || !isFinite(r)) return null;
      var pct = r * HOURS_PER_YEAR * 100;
      if (!isFinite(pct)) return null;
      // Client-side cap mirrors server-side clampAnnRate so junk values never render
      var ANN_CAP = 300;
      var capped  = Math.max(-ANN_CAP, Math.min(ANN_CAP, pct));
      var sign    = capped >= 0 ? '+' : '';
      var suffix  = Math.abs(pct) > ANN_CAP ? '>' : '';
      return suffix + sign + (Math.abs(capped) >= 100 ? capped.toFixed(0) : capped.toFixed(1)) + '%/yr';
    },
    /** Spread magnitude (no sign): 0.0006% */
    spread: function (r) {
      if (r == null || !isFinite(r)) return null;
      return (r * 100).toFixed(4) + '%';
    },
  };
})();
</script>

<!-- ── Funding matrix heatmap ── -->
<script>
(function () {
  'use strict';

  // ── Constants ────────────────────────────────────────────────────────────
  var REFRESH_MS   = 45_000;
  var STALE_AFTER  = 90_000;  // mark stale if updatedAt older than this
  var HOURS_PER_YEAR = 8760;
  // Full intensity at 0.1%/hr (0.001 decimal); caps at 0.55 opacity for readability
  var OI_FULL_RATE = 0.001;
  var MAX_ALPHA    = 0.55;

  // ── State ────────────────────────────────────────────────────────────────
  var matrixData    = null;
  var countdownSec  = Math.round(REFRESH_MS / 1000);
  var countdownTimer = null;
  var refreshTimer  = null;
  var topSpreadCoin = null;

  // ── DOM refs ─────────────────────────────────────────────────────────────
  var grid       = document.getElementById('fm-grid');
  var body       = document.getElementById('fm-body');
  var updatedEl  = document.getElementById('fm-updated');
  var staleEl    = document.getElementById('fm-stale');
  var countEl    = document.getElementById('fm-countdown');
  var errorPanel = document.getElementById('fm-error');
  var errorMsg   = document.getElementById('fm-error-msg');
  var tipEl      = document.getElementById('fm-tip');

  // ── Tooltip ──────────────────────────────────────────────────────────────
  function showTip(el, text) {
    tipEl.textContent = text;
    tipEl.style.display = 'block';
    positionTip(el);
  }
  function hideTip() { tipEl.style.display = 'none'; }
  function positionTip(el) {
    var r  = el.getBoundingClientRect();
    var tw = tipEl.offsetWidth;
    var th = tipEl.offsetHeight;
    var vw = window.innerWidth;
    var vh = window.innerHeight;
    var left = Math.min(r.left + r.width / 2 - tw / 2, vw - tw - 8);
    left = Math.max(left, 8);
    var top = r.bottom + 6;
    if (top + th > vh - 8) top = r.top - th - 6;
    tipEl.style.left = left + 'px';
    tipEl.style.top  = top  + 'px';
  }
  document.querySelectorAll('.fm-info-btn').forEach(function (btn) {
    var tip = btn.getAttribute('data-tip');
    btn.addEventListener('mouseenter', function () { showTip(btn, tip); });
    btn.addEventListener('mouseleave', hideTip);
    btn.addEventListener('focus',      function () { showTip(btn, tip); });
    btn.addEventListener('blur',       hideTip);
  });

  // ── Formatting helpers — delegate to window.FMT for consistency ──────────
  var FMT = window.FMT;
  function fmtRate(r) { return FMT.rate(r); }
  function fmtAnn(r)  { return FMT.ann(r);  }
  function fmtOi(usd) { return FMT.oi(usd); }

  // ── Color scale ──────────────────────────────────────────────────────────
  // Diverging: green for positive (longs pay shorts), red for negative.
  // Near-zero = transparent → surface background shows through.
  function rateColor(r) {
    if (r === null || !isFinite(r)) return '';
    var alpha = Math.min(Math.abs(r) / OI_FULL_RATE, 1) * MAX_ALPHA;
    if (alpha < 0.02) return '';
    if (r > 0) return 'rgba(63,185,80,'  + alpha.toFixed(3) + ')';
    return            'rgba(248,81,73,' + alpha.toFixed(3) + ')';
  }
  function rateCls(r) {
    if (r === null || !isFinite(r)) return 'fm-rate-nil';
    if (r > 0) return 'fm-rate-pos';
    if (r < 0) return 'fm-rate-neg';
    return 'fm-rate-nil';
  }

  // ── Skeleton rows ────────────────────────────────────────────────────────
  function renderSkeleton() {
    errorPanel.style.display = 'none';
    var html = '';
    for (var i = 0; i < 12; i++) {
      html += '<div class="fm-row fm-skeleton">';
      html += '<div class="fm-coin"><div class="fm-coin-name">&nbsp;</div><div class="fm-coin-oi">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</div></div>';
      html += '<div class="fm-cell"><div class="fm-rate">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</div><div class="fm-ann">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</div></div>';
      html += '<div class="fm-cell"><div class="fm-rate">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</div><div class="fm-ann">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</div></div>';
      html += '<div class="fm-cell"><div class="fm-rate">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</div><div class="fm-ann">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</div></div>';
      html += '</div>';
    }
    body.innerHTML = html;
  }

  // ── Render matrix rows ───────────────────────────────────────────────────
  function renderMatrix(data) {
    if (!data || !Array.isArray(data.coins)) return;
    errorPanel.style.display = 'none';

    // Find widest spread for highlight
    topSpreadCoin = null;
    var maxSpread = -1;
    data.coins.forEach(function (entry) {
      if (entry.spread !== null && isFinite(entry.spread) && entry.spread > maxSpread) {
        maxSpread = entry.spread;
        topSpreadCoin = entry.coin;
      }
    });

    var html = '';
    data.coins.forEach(function (entry) {
      var isTop = entry.coin === topSpreadCoin;
      var hlRate   = (entry.rates && entry.rates.hyperliquid !== null && isFinite(entry.rates.hyperliquid))
                      ? entry.rates.hyperliquid : null;
      var dydxRate = (entry.rates && entry.rates.dydx !== null && isFinite(entry.rates.dydx))
                      ? entry.rates.dydx : null;
      var spread   = (entry.spread !== null && isFinite(entry.spread)) ? entry.spread : null;

      var hlFmt   = fmtRate(hlRate);
      var dydxFmt = fmtRate(dydxRate);
      var spFmt   = fmtRate(spread);
      var hlAnn   = fmtAnn(hlRate);
      var dydxAnn = fmtAnn(dydxRate);
      var spAnn   = fmtAnn(spread);

      var hlColor   = rateColor(hlRate);
      var dydxColor = rateColor(dydxRate);

      // Best-pair arrow
      var pairArrow = '';
      if (entry.bestPair === 'hyperliquid_short_dydx_long')  pairArrow = ' <span title="Short HL / Long dYdX" style="color:var(--blue);font-size:10px">→dYdX</span>';
      if (entry.bestPair === 'dydx_short_hyperliquid_long')  pairArrow = ' <span title="Short dYdX / Long HL" style="color:var(--blue);font-size:10px">→HL</span>';

      html += '<div class="fm-row' + (isTop ? ' fm-row-top-spread' : '') + '">';

      // Coin cell
      html += '<div class="fm-coin"><div class="fm-coin-name">' + esc(entry.coin) + '</div>';
      html += '<div class="fm-coin-oi">' + fmtOi(entry.oiUsd) + '</div></div>';

      // HL rate cell
      html += '<div class="fm-cell" style="background:' + hlColor + '">';
      html += '<div class="fm-rate ' + rateCls(hlRate) + '">' + (hlFmt || '<span class="text-muted">—</span>') + '</div>';
      if (hlAnn) html += '<div class="fm-ann">' + hlAnn + '</div>';
      html += '</div>';

      // dYdX rate cell
      html += '<div class="fm-cell" style="background:' + dydxColor + '">';
      html += '<div class="fm-rate ' + rateCls(dydxRate) + '">' + (dydxFmt || '<span class="text-muted">—</span>') + '</div>';
      if (dydxAnn) html += '<div class="fm-ann">' + dydxAnn + '</div>';
      html += '</div>';

      // Spread cell
      html += '<div class="fm-cell' + (isTop ? ' fm-spread-cell-top' : '') + '">';
      html += '<div class="fm-rate ' + (spread !== null ? 'fm-rate-pos' : 'fm-rate-nil') + '">' + (spFmt ? spFmt.replace('+', '') : '<span class="text-muted">—</span>') + pairArrow + '</div>';
      if (spAnn) html += '<div class="fm-ann">' + spAnn.replace('+', '') + '</div>';
      html += '</div>';

      html += '</div>'; // /fm-row
    });

    body.innerHTML = html;
    updateMeta(data);
  }

  // ── Metadata bar ─────────────────────────────────────────────────────────
  function updateMeta(data) {
    if (!data) return;
    var at = data.updatedAt ? new Date(data.updatedAt) : null;
    if (at && isFinite(at.getTime())) {
      var ageMs = Date.now() - at.getTime();
      updatedEl.textContent = 'updated ' + formatAge(ageMs);
      staleEl.classList.toggle('visible', data.stale || ageMs > STALE_AFTER);
    } else {
      updatedEl.textContent = 'not yet updated';
      staleEl.classList.add('visible');
    }
    // Data-source label — transparent that rates may come from mainnet while trading testnet
    var dsEl = document.getElementById('fm-data-source');
    if (dsEl && data.dataNetwork) {
      dsEl.textContent = 'funding: ' + data.dataNetwork + ' · read-only';
      dsEl.style.display = 'inline';
      dsEl.title = data.dataNetwork === 'mainnet'
        ? 'Funding rates sourced from mainnet public indexers — no wallet, no orders. Set FUNDING_DATA_NETWORK=testnet to override.'
        : 'Funding rates sourced from testnet indexers (rates may be zero on thin markets).';
    }
  }
  function formatAge(ms) {
    var s = Math.round(ms / 1000);
    if (s < 60)  return s + 's ago';
    var m = Math.round(s / 60);
    if (m < 60)  return m + 'm ago';
    return Math.round(m / 60) + 'h ago';
  }

  // ── Error state ──────────────────────────────────────────────────────────
  function renderError(msg) {
    body.innerHTML = '';
    errorMsg.textContent = msg;
    errorPanel.style.display = 'block';
    staleEl.classList.add('visible');
  }

  // ── Countdown ────────────────────────────────────────────────────────────
  function startCountdown() {
    countdownSec = Math.round(REFRESH_MS / 1000);
    clearInterval(countdownTimer);
    countdownTimer = setInterval(function () {
      countdownSec = Math.max(0, countdownSec - 1);
      if (countEl) countEl.textContent = countdownSec;
    }, 1000);
  }

  // ── Fetch ────────────────────────────────────────────────────────────────
  async function fetchMatrix() {
    try {
      var resp = await fetch('/api/funding-matrix');
      if (!resp.ok) throw new Error('HTTP ' + resp.status);
      var data = await resp.json();
      matrixData = data;
      renderMatrix(data);
    } catch (e) {
      renderError(e.message);
    }
    startCountdown();
  }

  // ── Periodic metadata update (age ticks while countdown runs) ────────────
  setInterval(function () {
    if (matrixData) updateMeta(matrixData);
  }, 10_000);

  // ── Escape helper ─────────────────────────────────────────────────────────
  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  // ── Init ──────────────────────────────────────────────────────────────────
  renderSkeleton();
  fetchMatrix();
  clearInterval(refreshTimer);
  refreshTimer = setInterval(fetchMatrix, REFRESH_MS);

})();
</script>

<script>
(function () {
  const LC = LightweightCharts;

  // ── Shared chart options ────────────────────────────────────────────────
  function getCssVar(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }
  function chartOpts() {
    return {
      layout: {
        background: { type: 'solid', color: getCssVar('--surface') || '#161b22' },
        textColor:  getCssVar('--muted')  || '#8b949e',
        attributionLogo: false,
      },
      grid: {
        vertLines: { color: getCssVar('--border') || '#21262d' },
        horzLines: { color: getCssVar('--border') || '#21262d' },
      },
      crosshair: { mode: 1 },
      rightPriceScale: { borderColor: getCssVar('--border') || '#30363d' },
      handleScroll: { mouseWheel: true, pressedMouseMove: true },
      handleScale: { mouseWheel: true, pinch: true },
    };
  }
  // ── Mutable chart refs (nulled on dispose, recreated on mount) ───────────
  let candleChart = null, volChart = null, rsiChart = null;
  let candleSeries = null, volSeries = null, spreadSeries = null, rsiSeries = null;
  let volMap = new Map(), rsiMap = new Map();
  let latestCandle = null;
  const legend = document.getElementById('ohlc-legend');

  const timeScaleOpts = { borderColor: '#30363d', timeVisible: true, secondsVisible: false };

  // ── Equity chart stays always mounted (separate row, no tab dependency) ──
  const equityChart = LC.createChart(document.getElementById('chart-equity'), {
    ...chartOpts(), height: 100, timeScale: timeScaleOpts,
  });
  const equitySeries = equityChart.addAreaSeries({
    lineColor: '#58a6ff', topColor: 'rgba(88,166,255,0.2)', bottomColor: 'rgba(88,166,255,0)',
    lineWidth: 1, priceFormat: { type: 'price', precision: 2, minMove: 0.01 },
  });
  equityChart.priceScale('right').applyOptions({ scaleMargins: { top: 0.1, bottom: 0.1 } });

  // ── Mount / dispose candlestick+volume+RSI charts ─────────────────────
  function mountCharts() {
    if (candleChart) return; // already mounted

    candleChart = LC.createChart(document.getElementById('chart-candles'), {
      ...chartOpts(), height: 450, timeScale: { ...timeScaleOpts, visible: false },
    });
    volChart = LC.createChart(document.getElementById('chart-volume'), {
      ...chartOpts(), height: 120, timeScale: { ...timeScaleOpts, visible: false },
    });
    rsiChart = LC.createChart(document.getElementById('chart-rsi'), {
      ...chartOpts(), height: 150, timeScale: { ...timeScaleOpts, visible: false },
    });

    candleSeries = candleChart.addCandlestickSeries({
      upColor: '#3fb950', downColor: '#f85149',
      borderUpColor: '#3fb950', borderDownColor: '#f85149',
      wickUpColor: '#3fb950', wickDownColor: '#f85149',
    });
    volSeries = volChart.addHistogramSeries({ priceFormat: { type: 'volume' }, priceScaleId: '' });
    volChart.priceScale('').applyOptions({ scaleMargins: { top: 0.05, bottom: 0.2 } });
    spreadSeries = volChart.addLineSeries({ color: '#d29922', lineWidth: 1, priceScaleId: 'spread' });
    volChart.priceScale('spread').applyOptions({ scaleMargins: { top: 0.6, bottom: 0 }, visible: false });
    rsiSeries = rsiChart.addLineSeries({ color: '#58a6ff', lineWidth: 1 });
    rsiChart.priceScale('right').applyOptions({ scaleMargins: { top: 0.1, bottom: 0.1 } });
    rsiSeries.createPriceLine({ price: 70, color: '#f85149', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: '70' });
    rsiSeries.createPriceLine({ price: 30, color: '#3fb950', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: '30' });

    // Time-scale sync
    let syncing = false;
    function syncFrom(src, targets) {
      src.timeScale().subscribeVisibleLogicalRangeChange((range) => {
        if (syncing || !range) return;
        syncing = true;
        targets.forEach((t) => t.timeScale().setVisibleLogicalRange(range));
        syncing = false;
      });
    }
    syncFrom(candleChart, [volChart, rsiChart]);
    syncFrom(volChart,    [candleChart, rsiChart]);
    syncFrom(rsiChart,    [candleChart, volChart]);

    // Crosshair sync
    let crossSyncing = false;
    candleChart.subscribeCrosshairMove((param) => {
      if (crossSyncing) return; crossSyncing = true;
      if (!param.point || !param.time) {
        volChart.clearCrosshairPosition(); rsiChart.clearCrosshairPosition();
      } else {
        const t = param.time;
        volChart.setCrosshairPosition(volMap.get(t) ?? 0, t, volSeries);
        rsiChart.setCrosshairPosition(rsiMap.get(t) ?? 50, t, rsiSeries);
      }
      crossSyncing = false;
    });
    volChart.subscribeCrosshairMove((param) => {
      if (crossSyncing) return; crossSyncing = true;
      if (!param.point || !param.time) {
        candleChart.clearCrosshairPosition(); rsiChart.clearCrosshairPosition();
      } else {
        rsiChart.setCrosshairPosition(rsiMap.get(param.time) ?? 50, param.time, rsiSeries);
      }
      crossSyncing = false;
    });
    rsiChart.subscribeCrosshairMove((param) => {
      if (crossSyncing) return; crossSyncing = true;
      if (!param.point || !param.time) {
        candleChart.clearCrosshairPosition(); volChart.clearCrosshairPosition();
      } else {
        volChart.setCrosshairPosition(volMap.get(param.time) ?? 0, param.time, volSeries);
      }
      crossSyncing = false;
    });

    // OHLC legend — updates on crosshair, falls back to latest candle
    candleChart.subscribeCrosshairMove((param) => {
      if (param.time && param.seriesData && param.seriesData.size > 0) {
        const bar = param.seriesData.get(candleSeries);
        if (bar) renderLegend(bar);
      } else if (latestCandle) { renderLegend(latestCandle); }
    });

    if (latestCandle) renderLegend(latestCandle);
  }

  function disposeCharts() {
    [candleChart, volChart, rsiChart].forEach((c) => { if (c) c.remove(); });
    candleChart = volChart = rsiChart = null;
    candleSeries = volSeries = spreadSeries = rsiSeries = null;
    volMap.clear(); rsiMap.clear();
  }

  // ── OHLC legend ─────────────────────────────────────────────────────────
  function renderLegend(bar) {
    if (!bar || !legend) return;
    const dp  = bar.close >= 1000 ? 1 : bar.close >= 10 ? 2 : 4;
    const pct = ((bar.close - bar.open) / bar.open * 100);
    const col = pct >= 0 ? getCssVar('--green') || '#3fb950' : getCssVar('--red') || '#f85149';
    legend.innerHTML =
      '<span class="lbl">O</span>' + bar.open.toFixed(dp) + '&nbsp;' +
      '<span class="lbl">H</span>' + bar.high.toFixed(dp) + '&nbsp;' +
      '<span class="lbl">L</span>' + bar.low.toFixed(dp)  + '&nbsp;' +
      '<span class="lbl">C</span>' + bar.close.toFixed(dp) + '&nbsp;&nbsp;' +
      '<span style="color:' + col + ';font-variant-numeric:tabular-nums">' +
      (pct >= 0 ? '+' : '') + pct.toFixed(2) + '%</span>';
  }

  // ── Chart / Depth tab toggle ─────────────────────────────────────────────
  let activeTab = 'chart';
  const chartView = document.getElementById('chart-view');
  const depthView = document.getElementById('depth-view');
  const tabChart  = document.getElementById('panel-tab-chart');
  const tabDepth  = document.getElementById('panel-tab-depth');

  function activateTab(tab) {
    if (tab === activeTab) return;
    activeTab = tab;
    if (tab === 'chart') {
      depthView.style.display = 'none';
      chartView.style.display = '';
      tabChart.classList.add('active');    tabChart.setAttribute('aria-pressed', 'true');
      tabDepth.classList.remove('active'); tabDepth.setAttribute('aria-pressed', 'false');
      mountCharts();
      refreshChart();
    } else {
      chartView.style.display = 'none';
      depthView.style.display = '';
      tabDepth.classList.add('active');    tabDepth.setAttribute('aria-pressed', 'true');
      tabChart.classList.remove('active'); tabChart.setAttribute('aria-pressed', 'false');
      disposeCharts();
    }
  }
  if (tabChart) tabChart.addEventListener('click', () => activateTab('chart'));
  if (tabDepth) tabDepth.addEventListener('click', () => activateTab('depth'));

  // ── Coin state + timeframe ───────────────────────────────────────────────
  let chartCoin = '<%= coin %>';
  let chartTf   = '1h';
  let firstLoad = true;

  // Populate coin datalist from /api/funding-matrix (single source of truth)
  fetch('/api/funding-matrix')
    .then((r) => r.ok ? r.json() : null)
    .then((data) => {
      if (!data || !Array.isArray(data.coins)) return;
      const dl = document.getElementById('chart-coin-list');
      if (dl) dl.innerHTML = data.coins.map((c) => `<option value="${c.coin}">`).join('');
    })
    .catch(() => {});

  // Coin input handler — fires on Enter or blur when value changed
  const coinInput = document.getElementById('chart-coin-input');
  function applyCoinChange() {
    const v = (coinInput?.value || '').toUpperCase().trim();
    if (!v || v === chartCoin) return;
    chartCoin = v;
    const lbl = document.getElementById('chart-coin-label');
    if (lbl) lbl.textContent = chartCoin + '/USDT';
    const depthLbl = document.getElementById('depth-coin-label');
    if (depthLbl) depthLbl.textContent = chartCoin + '/USDT';
    firstLoad = true;
    if (activeTab === 'chart') refreshChart();
  }
  if (coinInput) {
    coinInput.addEventListener('change',  applyCoinChange); // datalist pick
    coinInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { coinInput.blur(); applyCoinChange(); } });
  }

  // Timeframe buttons
  document.getElementById('chart-tf-group')?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-tf]');
    if (!btn) return;
    chartTf = btn.dataset.tf;
    document.querySelectorAll('#chart-tf-group .tf').forEach((b) => b.classList.toggle('active', b === btn));
    firstLoad = true;
    if (activeTab === 'chart') refreshChart();
  });

  // ── Chart data refresh ──────────────────────────────────────────────────
  async function refreshChart() {
    if (!candleChart) mountCharts(); // ensure charts are mounted
    const updEl = document.getElementById('chart-updated');
    try {
      const url  = `/api/candles/dynamic?coin=${encodeURIComponent(chartCoin)}&interval=${chartTf}`;
      const resp = await fetch(url);
      const data = await resp.json();

      if (!resp.ok) {
        // Unknown coin or no data — show inline error in legend
        if (legend) legend.innerHTML = '<span style="color:var(--muted)">' + (data.error || 'No data') + '</span>';
        if (updEl) updEl.textContent = 'error';
        return;
      }
      if (!data.candles || data.candles.length === 0) {
        if (legend) legend.innerHTML = '<span style="color:var(--muted)">No candle data for ' + chartCoin + '</span>';
        return;
      }

      candleSeries.setData(data.candles);
      candleSeries.setMarkers(data.markers || []);
      volSeries.setData(data.volume);
      if (data.rsi && data.rsi.length > 0) rsiSeries.setData(data.rsi);
      if (data.spread && data.spread.length > 0) spreadSeries.setData(data.spread);

      volMap.clear(); (data.volume || []).forEach((d) => volMap.set(d.time, d.value));
      rsiMap.clear(); (data.rsi    || []).forEach((d) => rsiMap.set(d.time, d.value));

      if (firstLoad) { candleChart.timeScale().fitContent(); firstLoad = false; }

      latestCandle = data.candles[data.candles.length - 1];
      renderLegend(latestCandle);
      if (updEl) updEl.textContent = 'updated ' + new Date().toLocaleTimeString();
    } catch (e) {
      console.warn('Chart refresh failed:', e);
      if (updEl) updEl.textContent = 'error';
    }
  }

  // Initial mount and fetch
  mountCharts();
  refreshChart();
  setInterval(() => { if (activeTab === 'chart') refreshChart(); }, 10000);

  // ── Stats refresh (no page reload) ─────────────────────────────────────
  function fmtPrice(p) {
    return '$' + p.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  }

  async function refreshStatus() {
    try {
      const d = await fetch('/api/status').then((r) => r.json());

      // Per-coin price cards
      if (d.prices) {
        for (const [c, cp] of Object.entries(d.prices)) {
          const priceEl = document.getElementById('stat-price-' + c);
          if (priceEl && cp.mid > 0) priceEl.textContent = fmtPrice(cp.mid);
          const baEl = document.getElementById('stat-bidask-' + c);
          if (baEl && cp.bid > 0) baEl.textContent = 'bid ' + fmtPrice(cp.bid) + ' / ask ' + fmtPrice(cp.ask);
        }
      }

      if (d.bid > 0) {
        const sEl = document.getElementById('stat-spread');
        if (sEl) sEl.textContent = '$' + d.spread.toFixed(2);
        const spEl = document.getElementById('stat-spread-pct');
        if (spEl) spEl.textContent = d.spreadPct.toFixed(4) + '%';
      }

      const sigEl = document.getElementById('stat-signals');
      if (sigEl) sigEl.textContent = d.signalCount;
      const trEl = document.getElementById('stat-trades');
      if (trEl) trEl.textContent = d.tradeCount;
      const upEl = document.getElementById('stat-uptime');
      if (upEl) upEl.textContent = d.uptime;
      const luEl = document.getElementById('stat-lastupdate');
      if (luEl) luEl.textContent = d.lastUpdate ? 'last tick ' + new Date(d.lastUpdate).toLocaleTimeString() : 'no ticks yet';

      // Update nav interval label
      const navEl = document.getElementById('nav-interval');
      if (navEl && d.interval) navEl.textContent = d.interval;
    } catch (_) {}
  }

  refreshStatus();
  setInterval(refreshStatus, 3000);

  // ── Events table refresh ────────────────────────────────────────────────
  const badgeClass = { info: 'badge-info', warn: 'badge-warn', error: 'badge-error', debug: 'badge-info' };

  async function refreshEvents() {
    try {
      const events = await fetch('/api/events').then((r) => r.json());
      const tbody = document.getElementById('events-tbody');
      if (!tbody) {
        // First load rendered a static empty state — create table dynamically if needed
        return;
      }
      tbody.innerHTML = events.map((ev) =>
        '<tr>' +
        '<td class="mono text-muted" style="white-space:nowrap">' + ev.created_at + '</td>' +
        '<td>' + ev.module + '</td>' +
        '<td><span class="badge ' + (badgeClass[ev.level] || 'badge-info') + '">' + ev.level + '</span></td>' +
        '<td>' + ev.message + '</td>' +
        '</tr>'
      ).join('');
    } catch (_) {}
  }

  refreshEvents();
  setInterval(refreshEvents, 10000);

  // ── Funding rate card ───────────────────────────────────────────────────
  let nextFundingTs = null;

  async function refreshFunding() {
    try {
      const d = await fetch('/api/funding-rate').then((r) => r.json());
      if (d.error) return;

      function rateHtml(rate) {
        if (rate === null || rate === undefined) return '<span class="text-muted">—</span>';
        const pct = (rate * 100).toFixed(4);
        const col = rate > 0.0003 ? '#f85149' : rate < 0 ? '#3fb950' : '#e6edf3';
        return '<span style="color:' + col + '">' + pct + '%/hr</span>';
      }

      const curEl = document.getElementById('fr-current');
      if (curEl) curEl.innerHTML = rateHtml(d.currentRate);

      const predEl = document.getElementById('fr-predicted');
      if (predEl) predEl.innerHTML = rateHtml(d.predictedRate);

      const annEl = document.getElementById('fr-annualized');
      if (annEl && d.annualizedPct !== null) {
        const col = d.annualizedPct > 10 ? '#f85149' : d.annualizedPct < 0 ? '#3fb950' : '#e6edf3';
        annEl.innerHTML = '<span style="color:' + col + '">' + Number(d.annualizedPct).toFixed(1) + '%/yr</span>';
      }

      if (d.nextFundingTime) nextFundingTs = d.nextFundingTime;
    } catch (_) {}
  }

  refreshFunding();
  setInterval(refreshFunding, 60000);

  // Countdown timer (1s resolution)
  function tickFundingCountdown() {
    const el = document.getElementById('fr-countdown');
    if (!el) return;
    if (!nextFundingTs) { el.textContent = ''; return; }
    const diff = nextFundingTs - Date.now();
    if (diff <= 0) { el.textContent = 'settling…'; refreshFunding(); return; }
    const h = Math.floor(diff / 3_600_000);
    const m = Math.floor((diff % 3_600_000) / 60_000);
    const s = Math.floor((diff % 60_000) / 1_000);
    el.textContent = 'next in ' + h + 'h ' + m + 'm ' + (s < 10 ? '0' : '') + s + 's';
  }
  setInterval(tickFundingCountdown, 1000);

  // ── P&L and equity refresh ──────────────────────────────────────────────
  let equityFirstLoad = true;

  async function refreshPnl() {
    try {
      const d = await fetch('/api/pnl').then((r) => r.json());

      const upnlEl = document.getElementById('stat-upnl');
      if (upnlEl) {
        if (d.unrealisedPnl !== null && d.unrealisedPnl !== undefined) {
          const pct = d.unrealisedPnlPercent != null ? ' (' + (d.unrealisedPnlPercent >= 0 ? '+' : '') + d.unrealisedPnlPercent.toFixed(2) + '%)' : '';
          const col = d.unrealisedPnl >= 0 ? '#3fb950' : '#f85149';
          upnlEl.innerHTML = '<span style="color:' + col + '">' + (d.unrealisedPnl >= 0 ? '+' : '') + '$' + Math.abs(d.unrealisedPnl).toFixed(2) + pct + '</span>';
        } else {
          upnlEl.innerHTML = '<span class="text-muted">No position</span>';
        }
      }

      const rpnlEl = document.getElementById('stat-rpnl');
      if (rpnlEl && d.realisedPnl !== null && d.realisedPnl !== undefined) {
        const col = d.realisedPnl >= 0 ? '#3fb950' : '#f85149';
        rpnlEl.innerHTML = 'Realised: <span style="color:' + col + '">' + (d.realisedPnl >= 0 ? '+' : '') + '$' + d.realisedPnl.toFixed(2) + '</span>';
      }

      if (d.equityHistory && d.equityHistory.length > 0) {
        const eq = d.equityHistory.map((p) => ({
          time:  Math.floor(p.time / 1000),
          value: p.equity,
        }));
        equitySeries.setData(eq);
        if (equityFirstLoad) { equityChart.timeScale().fitContent(); equityFirstLoad = false; }
      }
    } catch (_) {}
  }

  refreshPnl();
  setInterval(refreshPnl, 10000);

  // ── Depth chart + order book ────────────────────────────────────────────
  const depthCanvas = document.getElementById('depth-canvas');

  function drawDepth(ob) {
    if (!depthCanvas) return;
    // Sync canvas buffer size to CSS size
    const cssW = depthCanvas.offsetWidth;
    const cssH = depthCanvas.offsetHeight;
    if (cssW === 0 || cssH === 0) return;
    if (depthCanvas.width !== cssW || depthCanvas.height !== cssH) {
      depthCanvas.width  = cssW;
      depthCanvas.height = cssH;
    }
    const ctx = depthCanvas.getContext('2d');
    if (!ctx) return;
    const W = cssW, H = cssH;
    ctx.clearRect(0, 0, W, H);

    const bids = ob.bids || [];
    const asks = ob.asks || [];
    if (bids.length === 0 || asks.length === 0) {
      ctx.fillStyle = getCssVar('--muted') || '#8b949e';
      ctx.font = '12px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Awaiting order book data…', W / 2, H / 2);
      return;
    }

    const minPrice  = bids[bids.length - 1].price;
    const maxPrice  = asks[asks.length - 1].price;
    const midPrice  = (bids[0].price + asks[0].price) / 2;
    const priceSpan = maxPrice - minPrice;
    if (priceSpan <= 0) return;

    const maxCum = Math.max(bids[bids.length - 1].total, asks[asks.length - 1].total);
    if (maxCum <= 0) return;

    const PAD_TOP = 0.08, PAD_BOT = 0.15;
    const toX = (p) => ((p - minPrice) / priceSpan) * W;
    const toY = (s) => H * (1 - PAD_BOT) - (s / maxCum) * H * (1 - PAD_TOP - PAD_BOT);
    const midX = toX(midPrice);

    // ── Bids fill ──
    ctx.beginPath();
    ctx.moveTo(toX(minPrice), H);
    ctx.lineTo(toX(minPrice), toY(bids[bids.length - 1].total));
    for (let i = bids.length - 1; i >= 0; i--) {
      const nP = i > 0 ? bids[i - 1].price : midPrice;
      const nT = i > 0 ? bids[i - 1].total : 0;
      ctx.lineTo(toX(nP), toY(bids[i].total));
      ctx.lineTo(toX(nP), toY(nT));
    }
    ctx.lineTo(midX, H);
    ctx.closePath();
    ctx.fillStyle = 'rgba(63,185,80,0.15)';
    ctx.fill();

    // ── Bids outline ──
    ctx.beginPath();
    ctx.moveTo(toX(minPrice), toY(bids[bids.length - 1].total));
    for (let i = bids.length - 1; i >= 0; i--) {
      const nP = i > 0 ? bids[i - 1].price : midPrice;
      const nT = i > 0 ? bids[i - 1].total : 0;
      ctx.lineTo(toX(nP), toY(bids[i].total));
      ctx.lineTo(toX(nP), toY(nT));
    }
    ctx.strokeStyle = '#3fb950';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // ── Asks fill ──
    ctx.beginPath();
    ctx.moveTo(midX, H);
    ctx.lineTo(midX, toY(0));
    for (let i = 0; i < asks.length; i++) {
      const pT = i > 0 ? asks[i - 1].total : 0;
      ctx.lineTo(toX(asks[i].price), toY(pT));
      ctx.lineTo(toX(asks[i].price), toY(asks[i].total));
    }
    ctx.lineTo(W, toY(asks[asks.length - 1].total));
    ctx.lineTo(W, H);
    ctx.closePath();
    ctx.fillStyle = 'rgba(248,81,73,0.15)';
    ctx.fill();

    // ── Asks outline ──
    ctx.beginPath();
    ctx.moveTo(midX, toY(0));
    for (let i = 0; i < asks.length; i++) {
      const pT = i > 0 ? asks[i - 1].total : 0;
      ctx.lineTo(toX(asks[i].price), toY(pT));
      ctx.lineTo(toX(asks[i].price), toY(asks[i].total));
    }
    ctx.lineTo(W, toY(asks[asks.length - 1].total));
    ctx.strokeStyle = '#f85149';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // ── Mid price dashed line ──
    ctx.beginPath();
    ctx.setLineDash([4, 4]);
    ctx.strokeStyle = 'rgba(139,148,158,0.4)';
    ctx.lineWidth = 1;
    ctx.moveTo(midX, 0);
    ctx.lineTo(midX, H * (1 - PAD_BOT));
    ctx.stroke();
    ctx.setLineDash([]);

    // ── X axis price labels ──
    const fmtP = (p) => p >= 10000 ? p.toFixed(0) : p >= 100 ? p.toFixed(1) : p.toFixed(2);
    ctx.fillStyle = 'rgba(139,148,158,0.8)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'left';
    ctx.fillText(fmtP(minPrice), 4, H - 3);
    ctx.textAlign = 'center';
    ctx.fillText(fmtP(midPrice), midX, H - 3);
    ctx.textAlign = 'right';
    ctx.fillText(fmtP(maxPrice), W - 4, H - 3);
  }

  function updateObTable(ob) {
    const tbody = document.getElementById('ob-tbody');
    if (!tbody) return;
    const bids = (ob.bids || []).slice(0, 10);
    const asks = (ob.asks || []).slice(0, 10);
    const spread = bids.length > 0 && asks.length > 0 ? asks[0].price - bids[0].price : null;
    const fmtP = (p) => p >= 10000 ? p.toFixed(1) : p.toFixed(2);
    const fmtS = (s) => s >= 100 ? s.toFixed(1) : s >= 10 ? s.toFixed(2) : s.toFixed(3);
    let rows = '';
    // Asks: worst → best (so best ask sits adjacent to spread row)
    for (const a of [...asks].reverse()) {
      rows += `<tr class="ob-ask"><td>${fmtP(a.price)}</td><td>${fmtS(a.size)}</td><td>${fmtS(a.total)}</td></tr>`;
    }
    const spreadTxt = spread !== null ? '$' + spread.toFixed(2) + ' spread' : '— spread —';
    rows += `<tr class="ob-spread"><td colspan="3" style="padding:3px 8px">${spreadTxt}</td></tr>`;
    // Bids: best → worst
    for (const b of bids) {
      rows += `<tr class="ob-bid"><td>${fmtP(b.price)}</td><td>${fmtS(b.size)}</td><td>${fmtS(b.total)}</td></tr>`;
    }
    tbody.innerHTML = rows;
  }

  async function refreshOrderbook() {
    const coinParam = document.getElementById('chart-coin-select')?.value || '';
    try {
      const ob = await fetch('/api/orderbook?coin=' + coinParam).then((r) => r.json());
      const labelEl = document.getElementById('depth-coin-label');
      if (labelEl) labelEl.textContent = coinParam + '/USDT';
      drawDepth(ob);
      updateObTable(ob);
    } catch (_) {}
  }

  refreshOrderbook();
  setInterval(refreshOrderbook, 2000);

  // Coin selector also clears + refetches order book
  document.getElementById('chart-coin-select')?.addEventListener('change', () => {
    void refreshOrderbook();
  });

  // Timeframe buttons are handled by the scoped #chart-tf-group listener above.

  // ── Bots teaser (count badge) ─────────────────────────────────────────────
  async function refreshBotsTeaser() {
    try {
      const bots  = await fetch('/api/bots').then((r) => r.json());
      const count = bots.filter((b) => b.status === 'running').length;
      const el    = document.getElementById('bots-teaser-count');
      if (el) el.textContent = count;
    } catch { /* ignore */ }
  }

  refreshBotsTeaser();
  setInterval(refreshBotsTeaser, 4000);

  // ── Resize observer ─────────────────────────────────────────────────────
  if (typeof ResizeObserver !== 'undefined') {
    const ro = new ResizeObserver(() => {
      // Guard against null — charts may be disposed when depth tab is active
      [candleChart, volChart, rsiChart, equityChart]
        .filter(Boolean)
        .forEach((c) => c.applyOptions({ width: 0 }));
    });
    const panel = document.querySelector('.chart-panel');
    if (panel) ro.observe(panel);
  }

})();
</script>
<!-- ── Analytics charts: equity curve, funding history, bot P&L ── -->
<script>
(function () {
  'use strict';

  var LC  = window.LightweightCharts;
  var FMT = window.FMT;
  var HOURS_PER_YEAR = 8760;

  // ── Shared helpers ────────────────────────────────────────────────────────

  function getCssVar(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }

  /** Base chart options matching the existing candle chart style. */
  function baseChartOpts(height) {
    return {
      width:  0,  // auto via applyOptions after attach
      height: height,
      layout: {
        background: { type: 'solid', color: getCssVar('--surface') || '#161b22' },
        textColor:  getCssVar('--muted')  || '#8b949e',
        fontSize:   11,
      },
      grid: {
        vertLines:  { color: getCssVar('--border') || '#30363d', style: 1 },
        horzLines:  { color: getCssVar('--border') || '#30363d', style: 1 },
      },
      crosshair: { mode: 1 },
      rightPriceScale: { borderColor: getCssVar('--border') || '#30363d' },
      timeScale:       { borderColor: getCssVar('--border') || '#30363d', timeVisible: true },
      handleScroll: true,
      handleScale:  true,
    };
  }

  /** Show a state overlay inside a container, hiding the chart. */
  function showState(container, kind, text) {
    // Remove old state overlay
    var old = container.querySelector('.an-state-overlay');
    if (old) old.remove();
    var div = document.createElement('div');
    div.className = 'an-state' + (kind === 'error' ? ' an-state-err' : '') + ' an-state-overlay';
    div.style.cssText = 'position:absolute;inset:0;background:' + (getCssVar('--surface') || '#161b22');
    var icon = kind === 'empty' ? '📭' : kind === 'error' ? '⚠' : '';
    div.innerHTML = (icon ? '<span class="an-state-icon">' + icon + '</span>' : '') +
                    '<span>' + text + '</span>';
    container.style.position = 'relative';
    container.appendChild(div);
  }

  function clearState(container) {
    var old = container.querySelector('.an-state-overlay');
    if (old) old.remove();
  }

  /** Mark a range button active, deactivate siblings. */
  function activateRange(group, value, attr) {
    group.querySelectorAll('.tf').forEach(function (b) {
      b.classList.toggle('active', b.getAttribute(attr) === value);
    });
  }

  /** Format epoch-ms as a time label for the toolbar. */
  function timeAgo(iso) {
    if (!iso) return '';
    var ms = Date.now() - new Date(iso).getTime();
    var s  = Math.round(ms / 1000);
    if (s < 60)  return s + 's ago';
    var m = Math.round(s / 60);
    if (m < 60)  return m + 'm ago';
    return Math.round(m / 60) + 'h ago';
  }

  /** Uniform downsample: keep first, last, and evenly-spaced intermediates. */
  function downsample(rows, maxPts) {
    if (rows.length <= maxPts || maxPts < 2) return rows;
    var out  = [];
    var step = (rows.length - 1) / (maxPts - 1);
    for (var i = 0; i < maxPts; i++) {
      out.push(rows[Math.min(Math.round(i * step), rows.length - 1)]);
    }
    out[out.length - 1] = rows[rows.length - 1];
    return out;
  }

  // ── 1. Equity Curve ───────────────────────────────────────────────────────

  (function setupEquityChart() {
    var container  = document.getElementById('eq-chart');
    var rangeGroup = document.getElementById('eq-range-group');
    var updatedEl  = document.getElementById('eq-updated');
    var chart = null;
    var series = null;

    function initChart() {
      if (chart) { try { chart.remove(); } catch (_) {} chart = null; }
      var opts   = baseChartOpts(200);
      opts.rightPriceScale.mode = 0;
      chart  = LC.createChart(container, opts);
      chart.applyOptions({ width: container.clientWidth });
      series = chart.addAreaSeries({
        lineColor:   getCssVar('--blue')  || '#58a6ff',
        topColor:    'rgba(88,166,255,0.2)',
        bottomColor: 'rgba(88,166,255,0)',
        lineWidth:   2,
        priceFormat: { type: 'custom', formatter: function (v) { return FMT.usd(v); } },
      });
    }

    async function load(range) {
      clearState(container);
      container.innerHTML = '<div class="an-skel an-state-overlay" style="position:absolute;inset:0"></div>';

      try {
        var resp = await fetch('/api/equity-history?range=' + range);
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        var rows = await resp.json();

        clearState(container);
        container.querySelectorAll('.an-state-overlay').forEach(function (e) { e.remove(); });

        if (!Array.isArray(rows) || rows.length === 0) {
          if (chart) { try { chart.remove(); } catch (_) {} chart = null; }
          showState(container, 'empty', 'No equity history yet. Once the bot starts trading, snapshots appear here (60 s interval).');
          if (updatedEl) updatedEl.textContent = '';
          return;
        }

        if (!chart) initChart();
        var pts = downsample(rows, 500).map(function (r) {
          return { time: Math.floor(r.ts / 1000), value: isFinite(r.equity_usd) ? r.equity_usd : 0 };
        });
        series.setData(pts);
        chart.timeScale().fitContent();
        if (updatedEl) updatedEl.textContent = rows.length + ' pts';
      } catch (e) {
        clearState(container);
        container.querySelectorAll('.an-state-overlay').forEach(function (el) { el.remove(); });
        showState(container, 'error', 'Failed to load equity history: ' + e.message);
      }
    }

    if (rangeGroup) {
      rangeGroup.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-eq]');
        if (!btn) return;
        activateRange(rangeGroup, btn.dataset.eq, 'data-eq');
        load(btn.dataset.eq);
      });
    }

    // Resize
    if (typeof ResizeObserver !== 'undefined' && container) {
      new ResizeObserver(function () {
        if (chart) chart.applyOptions({ width: container.clientWidth });
      }).observe(container);
    }

    load('24h');
  })();

  // ── 2. Funding-rate history ───────────────────────────────────────────────

  (function setupFundingHistory() {
    var container  = document.getElementById('fh-chart');
    var coinSel    = document.getElementById('fh-coin-sel');
    var rangeGroup = document.getElementById('fh-range-group');
    var updatedEl  = document.getElementById('fh-updated');
    var chart = null;
    var hlSeries = null, dydxSeries = null, spreadSeries = null;

    // Populate coin dropdown from matrix data once it loads
    function populateCoinSel(coins) {
      if (!coinSel || !Array.isArray(coins) || !coins.length) return;
      var current = coinSel.value;
      coinSel.innerHTML = coins.map(function (c) {
        return '<option value="' + c.coin + '"' + (c.coin === current ? ' selected' : '') + '>' + c.coin + '</option>';
      }).join('');
    }

    function initChart() {
      if (chart) { try { chart.remove(); } catch (_) {} chart = null; }
      chart = LC.createChart(container, baseChartOpts(180));
      chart.applyOptions({ width: container.clientWidth });
      hlSeries = chart.addLineSeries({
        color: getCssVar('--green') || '#3fb950', lineWidth: 2, title: 'HL',
        priceFormat: { type: 'custom', formatter: function (v) { return FMT.rate(v) || '—'; } },
      });
      dydxSeries = chart.addLineSeries({
        color: getCssVar('--blue') || '#58a6ff', lineWidth: 2, title: 'dYdX',
        priceFormat: { type: 'custom', formatter: function (v) { return FMT.rate(v) || '—'; } },
      });
      spreadSeries = chart.addHistogramSeries({
        color: 'rgba(88,166,255,0.18)', priceScaleId: 'spread',
        priceFormat: { type: 'custom', formatter: function (v) { return FMT.spread(v) || '—'; } },
      });
      chart.priceScale('spread').applyOptions({ scaleMargins: { top: 0.8, bottom: 0 } });
    }

    // alignRows is no longer duplicated here.
    // The /api/funding-history endpoint now returns pre-aligned
    // [{ ts, hl, dydx, spread }] rows using the single tested implementation
    // in chart-utils.ts (server-side).  The browser consumes the result directly.

    async function load(coin, range) {
      clearState(container);
      container.querySelectorAll('.an-state-overlay').forEach(function (e) { e.remove(); });
      container.insertAdjacentHTML('beforeend', '<div class="an-skel an-state-overlay" style="position:absolute;inset:0"></div>');

      try {
        var resp = await fetch('/api/funding-history?coin=' + encodeURIComponent(coin) + '&range=' + range);
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        // Server returns pre-aligned rows: [{ ts, hl, dydx, spread }]
        var aligned = await resp.json();

        container.querySelectorAll('.an-state-overlay').forEach(function (e) { e.remove(); });

        if (!Array.isArray(aligned) || aligned.length === 0) {
          if (chart) { try { chart.remove(); } catch (_) {} chart = null; }
          showState(container, 'empty', 'No funding rate history for ' + coin + ' yet. History builds as polls run (45 s interval).');
          if (updatedEl) updatedEl.textContent = '';
          return;
        }

        if (!chart) initChart();

        var toSec = function (b) { return Math.floor(b / 1000); };
        hlSeries.setData(
          downsample(aligned.filter(function (r) { return r.hl !== null; }), 500)
            .map(function (r) { return { time: toSec(r.ts), value: r.hl }; })
        );
        dydxSeries.setData(
          downsample(aligned.filter(function (r) { return r.dydx !== null; }), 500)
            .map(function (r) { return { time: toSec(r.ts), value: r.dydx }; })
        );
        spreadSeries.setData(
          downsample(aligned.filter(function (r) { return r.spread !== null; }), 500)
            .map(function (r) { return { time: toSec(r.ts), value: r.spread }; })
        );
        chart.timeScale().fitContent();
        if (updatedEl) updatedEl.textContent = aligned.length + ' buckets';
      } catch (e) {
        container.querySelectorAll('.an-state-overlay').forEach(function (el) { el.remove(); });
        showState(container, 'error', 'Failed to load funding history: ' + e.message);
      }
    }

    function currentCoin()  { return coinSel  ? coinSel.value  : 'BTC'; }
    function currentRange() {
      var active = rangeGroup ? rangeGroup.querySelector('.tf.active') : null;
      return active ? active.dataset.fh : '24h';
    }

    if (coinSel)    coinSel.addEventListener('change', function ()  { load(currentCoin(), currentRange()); });
    if (rangeGroup) rangeGroup.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-fh]');
      if (!btn) return;
      activateRange(rangeGroup, btn.dataset.fh, 'data-fh');
      load(currentCoin(), currentRange());
    });

    if (typeof ResizeObserver !== 'undefined' && container) {
      new ResizeObserver(function () {
        if (chart) chart.applyOptions({ width: container.clientWidth });
      }).observe(container);
    }

    // Populate coin selector directly from /api/funding-matrix — no dependency
    // on the heatmap DOM having rendered.
    fetch('/api/funding-matrix')
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (data && Array.isArray(data.coins) && data.coins.length > 0) {
          populateCoinSel(data.coins);
        }
      })
      .catch(function () { /* leave BTC as the fallback default */ });

    load('BTC', '24h');
  })();

  // ── 3. Per-bot P&L ────────────────────────────────────────────────────────

  (function setupBotPnl() {
    var wrap      = document.getElementById('pnl-wrap');
    var updatedEl = document.getElementById('pnl-updated');

    function pnlCls(v)  { return !isFinite(v) ? 'pnl-nil' : v > 0 ? 'pnl-pos' : v < 0 ? 'pnl-neg' : 'pnl-nil'; }
    function pnlStr(v)  { return isFinite(v) ? FMT.pnl(v) : '—'; }

    /** Draw a mini proportional bar (width capped at 60px) */
    function bar(v, maxAbs) {
      if (!isFinite(v) || maxAbs === 0) return '';
      var w   = Math.min(Math.round(Math.abs(v) / maxAbs * 60), 60);
      var col = v >= 0 ? 'var(--green)' : 'var(--red)';
      return '<span class="pnl-bar" style="width:' + w + 'px;background:' + col + '"></span>';
    }

    async function load() {
      try {
        var resp = await fetch('/api/bot-pnl');
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        var data = await resp.json();

        var bots    = data.bots   || [];
        var totals  = data.totals || { realizedPnl: 0, unrealizedPnl: 0, totalPnl: 0 };

        if (bots.length === 0) {
          wrap.innerHTML = '<div class="an-state"><span class="an-state-icon">🤖</span><span>No bots are running. <a href="/bots" style="color:var(--blue)">Start one →</a></span></div>';
          if (updatedEl) updatedEl.textContent = '';
          return;
        }

        // Find max absolute total for bar scaling
        var maxAbs = bots.reduce(function (m, b) { return Math.max(m, Math.abs(b.totalPnl || 0)); }, 0.01);

        var rows = bots.map(function (b) {
          return '<tr>' +
            '<td><div class="pnl-bot-name">' + b.id + '</div>' +
                 '<div class="pnl-bot-sub">' + (b.strategyId || '') + ' · ' + (b.coin || '') +
                 (b.timeframe && b.timeframe !== '—' ? ' · ' + b.timeframe : '') + '</div></td>' +
            '<td class="' + pnlCls(b.realizedPnl)   + '">' + pnlStr(b.realizedPnl)   + '</td>' +
            '<td class="' + pnlCls(b.unrealizedPnl) + '">' + pnlStr(b.unrealizedPnl) + '</td>' +
            '<td class="' + pnlCls(b.totalPnl)      + '"><span class="pnl-bar-wrap">' +
              bar(b.totalPnl, maxAbs) + pnlStr(b.totalPnl) + '</span></td>' +
            '<td class="text-muted">' + (Number.isInteger(b.tradeCount) ? b.tradeCount : '—') + '</td>' +
          '</tr>';
        }).join('');

        var html =
          '<table class="pnl-table">' +
          '<thead><tr><th>Bot</th><th>Realised</th><th>Unrealised</th><th>Total</th><th>Trades</th></tr></thead>' +
          '<tbody>' + rows + '</tbody>' +
          '<tfoot><tr>' +
            '<td>Portfolio</td>' +
            '<td class="' + pnlCls(totals.realizedPnl)   + '">' + pnlStr(totals.realizedPnl)   + '</td>' +
            '<td class="' + pnlCls(totals.unrealizedPnl) + '">' + pnlStr(totals.unrealizedPnl) + '</td>' +
            '<td class="' + pnlCls(totals.totalPnl)      + '">' + pnlStr(totals.totalPnl)      + '</td>' +
            '<td class="text-muted">' + bots.reduce(function (s, b) { return s + (b.tradeCount || 0); }, 0) + '</td>' +
          '</tr></tfoot>' +
          '</table>';

        wrap.innerHTML = html;
        if (updatedEl) updatedEl.textContent = 'updated just now';
      } catch (e) {
        wrap.innerHTML = '<div class="an-state an-state-err"><span class="an-state-icon">⚠</span><span>Failed to load P&amp;L: ' + e.message + '</span></div>';
      }
    }

    load();
    setInterval(load, 4000);
  })();

})();
</script>
</body>
</html>
