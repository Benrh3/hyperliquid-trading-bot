<%- include('_head', { title: 'Overview' }) %>
<style>
  /* ── Onboarding card ── */
  .onboard-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
    padding: var(--sp-4) var(--sp-5);
    margin-bottom: var(--sp-4);
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
  }
  .onboard-body { flex: 1; font-size: var(--t-body); color: var(--muted); line-height: 1.6; }
  .onboard-body strong { color: var(--text); }
  .onboard-body a { color: var(--accent); text-decoration: none; }
  .onboard-body a:hover { text-decoration: underline; }
  .onboard-dismiss {
    background: none; border: none; color: var(--muted); font-size: 18px; line-height: 1;
    cursor: pointer; padding: 0; flex-shrink: 0; margin-top: -2px;
    transition: color .1s;
  }
  .onboard-dismiss:hover { color: var(--text); }

  /* ── Coin search input ── */
  .coin-search {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 11px;
    font-family: inherit;
    padding: 2px 6px;
    border-radius: 3px;
    width: 70px;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    transition: border-color .1s;
  }
  .coin-search:focus { outline: none; border-color: var(--accent); }
  .coin-search::placeholder { text-transform: none; color: var(--muted); }

  /* ── Stat tile grid (6 signal-cards) ── */
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }

  /* Tile link wrapper — makes whole tile clickable without nesting <a> in block */
  .stat-tile-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  /* Shadow badge inside Bots tile */
  .shadow-badge {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 10px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .04em;
    background: rgba(129,140,248,0.15);
    color: var(--accent);
    margin-left: var(--sp-2);
    vertical-align: middle;
  }

  /* ── HYPE funding strip (replaces full matrix) ── */
  .hype-strip {
    background: var(--surface);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: var(--sp-5);
  }
  .hype-strip-toolbar {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-3) var(--sp-5);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .hype-strip-title {
    font-size: var(--t-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--muted);
    white-space: nowrap;
  }
  .hype-strip-body {
    display: flex;
    align-items: center;
    gap: 0;
    padding: var(--sp-3) var(--sp-5);
    flex-wrap: wrap;
    gap: var(--sp-5);
  }
  .hs-item { display: flex; flex-direction: column; gap: 2px; }
  .hs-label { font-size: var(--t-label); color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
  .hs-value {
    font-size: 14px;
    font-family: 'SFMono-Regular', Consolas, monospace;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    white-space: nowrap;
  }
  .hs-rate-pos { color: var(--up); }
  .hs-rate-neg { color: var(--down); }
  .hs-rate-nil { color: var(--muted); }
  .hs-sparkline { width: 120px; height: 36px; flex-shrink: 0; }
  .hs-link {
    margin-left: auto;
    font-size: var(--t-body);
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    font-weight: 500;
  }
  .hs-link:hover { text-decoration: underline; }
  @media (max-width: 600px) { .hs-sparkline { display: none; } .hs-link { margin-left: 0; } }

  /* ── Chart panel ── */
  #depth-view { display: none; }
  #depth-view-inner { display: grid; grid-template-columns: 1fr 280px; }
  @media (max-width: 768px) { #depth-view-inner { grid-template-columns: 1fr; } }
  #depth-view .ob-header {
    padding: 0.4rem 0.875rem;
    border-bottom: 1px solid var(--border);
    font-size: 12px; font-weight: 600; color: var(--text);
    display: flex; align-items: center; gap: 0.5rem;
    border-left: 1px solid var(--border);
  }
  #depth-view .ob-table-wrap { border-left: 1px solid var(--border); }
  #ohlc-legend { font-variant-numeric: tabular-nums; }
  .tf:disabled { opacity: 0.4; cursor: default; }
  .chart-row { position: relative; }
  .chart-row-label {
    position: absolute; top: 5px; left: 10px;
    font-size: 10px; color: var(--muted);
    pointer-events: none; z-index: 2; letter-spacing: .04em;
  }
  #chart-candles { height: 450px; }
  #chart-volume  { height: 120px; border-top: 1px solid var(--border); }
  #chart-rsi     { height: 150px; border-top: 1px solid var(--border); }
  #ohlc-legend {
    position: absolute; top: 8px; left: 10px; z-index: 3;
    font-size: 11px; font-family: 'SFMono-Regular', Consolas, monospace;
    color: var(--text); background: rgba(22,27,34,0.85);
    padding: 5px 10px; border-radius: 4px;
    pointer-events: none; line-height: 1.7; backdrop-filter: blur(2px);
  }
  #ohlc-legend .lbl { color: var(--muted); margin-right: 2px; }
  .tv-lightweight-charts > table > tbody > tr:last-child { display: none !important; }
  #chart-equity { height: 100px; border-top: 1px solid var(--border); }
  .chart-empty { height: 100%; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 13px; }

  /* Depth / order-book */
  .ob-panel { display: grid; grid-template-columns: 1fr 280px; gap: var(--sp-4); margin-bottom: var(--sp-5); }
  @media (max-width: 768px) { .ob-panel { grid-template-columns: 1fr; } }
  .depth-card, .ob-card { background: var(--surface); border-radius: 8px; overflow: hidden; }
  .ob-header { padding: var(--sp-3) var(--sp-4); border-bottom: 1px solid var(--border); font-size: var(--t-label); font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); display: flex; align-items: center; gap: var(--sp-2); }
  #depth-canvas { display: block; width: 100%; height: 180px; }
  #ob-table { width: 100%; border-collapse: collapse; font-size: var(--t-label); font-family: 'SFMono-Regular', Consolas, monospace; }
  #ob-table th { padding: var(--sp-1) var(--sp-2); font-size: var(--t-label); color: var(--muted); font-weight: 600; text-align: right; border-bottom: 1px solid var(--border); }
  #ob-table th:first-child { text-align: left; }
  #ob-table td { padding: var(--sp-1) var(--sp-2); text-align: right; }
  #ob-table td:first-child { text-align: left; }
  .ob-ask { color: var(--red); background: rgba(248,81,73,0.05); }
  .ob-bid { color: var(--green); background: rgba(63,185,80,0.05); }
  .ob-spread { color: var(--muted); text-align: center !important; font-size: var(--t-label); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

  /* ── Analytics panels ── */
  .an-coin-sel { background: var(--surface); border: 1px solid var(--border); color: var(--text); font-size: 11px; padding: 3px 6px; border-radius: 3px; cursor: pointer; }
  .an-coin-sel:focus { outline: 1px solid var(--accent); }
  .an-state { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.35rem; height: 100%; min-height: 60px; padding: 1.5rem; color: var(--muted); font-size: 13px; text-align: center; }
  .an-state-err { color: var(--red); }
  .an-state-icon { font-size: 1.4rem; line-height: 1; }
  @keyframes an-shimmer { 0%, 100% { opacity: 0.45; } 50% { opacity: 0.9; } }
  .an-skel { background: var(--border); border-radius: 3px; animation: an-shimmer 1.5s ease-in-out infinite; }

  /* ── Events log filter bar ── */
  .ev-filter-bar {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-2);
    flex-wrap: wrap;
  }
  .ev-filter-label { font-size: var(--t-label); color: var(--muted); text-transform: uppercase; letter-spacing: .06em; font-weight: 600; }
  .ev-level-btn {
    background: none;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--t-label);
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 10px;
    cursor: pointer;
    transition: border-color .1s, color .1s, background .1s;
    line-height: 1.4;
  }
  .ev-level-btn.active { border-color: var(--accent); color: var(--accent); background: var(--accent-dim); }
  .ev-mod-select {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: var(--t-label);
    padding: 2px 6px;
    border-radius: 3px;
    cursor: pointer;
  }
  .ev-mod-select:focus { outline: none; border-color: var(--accent); }
  /* Duplicate-count badge on collapsed rows */
  .ev-count {
    display: inline-block;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 10px;
    font-weight: 600;
    color: var(--muted);
    padding: 0 5px;
    margin-left: 6px;
    vertical-align: middle;
    font-variant-numeric: tabular-nums;
  }
</style>

<%- include('_nav') %>

<div class="container">

  <!-- ── Onboarding card (non-admin, dismissible via cookie) ── -->
  <% if (!locals.isAdmin) { %>
  <div class="onboard-card" id="onboard-card">
    <div class="onboard-body">
      <strong>Howbrook Quant</strong> is a signal-driven perpetuals research platform — strategies are
      walk-forward validated on Hyperliquid HYPE before running paper or live on testnet.
      Each signal's information coefficient is tracked before it is wired to execution.
      <a href="/backtest">See the evidence →</a>
    </div>
    <button class="onboard-dismiss" id="onboard-dismiss" title="Dismiss">&times;</button>
  </div>
  <% } %>

  <!-- ── Six stat tiles ── -->
  <div class="stat-grid">

    <!-- 1. HYPE -->
    <div class="signal-card" id="tile-hype">
      <div class="sc-header"><span class="sc-label">HYPE</span></div>
      <div class="sc-value" id="tile-hype-price"><span style="color:var(--muted)">—</span></div>
      <div class="sc-subline" id="tile-hype-rate"><span style="color:var(--muted)">loading…</span></div>
      <div class="sc-badges"><span class="sc-badge sc-kind-level" id="tile-hype-xdef" style="display:none"></span></div>
    </div>

    <!-- 2. Bots -->
    <a class="stat-tile-link" href="/bots">
      <div class="signal-card" id="tile-bots">
        <div class="sc-header"><span class="sc-label">Bots</span></div>
        <div class="sc-value" id="tile-bots-value"><span style="color:var(--muted)">—</span></div>
        <div class="sc-subline" id="tile-bots-sub"></div>
        <div class="sc-badges" id="tile-bots-badges"></div>
      </div>
    </a>

    <!-- 3. Portfolio P&L -->
    <div class="signal-card" id="tile-pnl">
      <div class="sc-header"><span class="sc-label">Portfolio P&amp;L</span></div>
      <div class="sc-value" id="tile-pnl-session"><span style="color:var(--muted)">—</span></div>
      <div class="sc-subline" id="tile-pnl-alltime"></div>
      <div class="sc-badges">
        <a href="/bots" class="sc-badge sc-source" style="text-decoration:none">View bots →</a>
      </div>
    </div>

    <!-- 4. Best Strategy -->
    <a class="stat-tile-link" href="/backtest">
      <div class="signal-card" id="tile-strategy">
        <div class="sc-header"><span class="sc-label">Best Strategy</span></div>
        <div class="sc-value" id="tile-strategy-value"><span style="color:var(--muted)">—</span></div>
        <div class="sc-subline" id="tile-strategy-sub" style="font-style:italic">Run a walk-forward to populate</div>
        <div class="sc-badges"><span class="sc-badge sc-source">Backtest →</span></div>
      </div>
    </a>

    <!-- 5. Signal Health -->
    <div class="signal-card" id="tile-signals">
      <div class="sc-header"><span class="sc-label">Signal Health</span></div>
      <div class="sc-value" id="tile-signals-value"><span style="color:var(--muted)">—</span></div>
      <div class="sc-subline" id="tile-signals-sub"></div>
      <div class="sc-badges" id="tile-signals-badges"></div>
    </div>

    <!-- 6. Shadow Status -->
    <div class="signal-card" id="tile-shadow">
      <div class="sc-header"><span class="sc-label">Shadow Bot</span></div>
      <div class="sc-value" id="tile-shadow-value"><span style="color:var(--muted)">—</span></div>
      <div class="sc-subline" id="tile-shadow-sub"></div>
      <div class="sc-badges" id="tile-shadow-badges"></div>
    </div>

  </div><!-- /stat-grid -->

  <!-- ── HYPE funding strip ── -->
  <div class="hype-strip">
    <div class="hype-strip-toolbar">
      <span class="hype-strip-title">HYPE Funding</span>
      <span id="hs-updated" style="font-size:var(--t-label);color:var(--muted)"></span>
    </div>
    <div class="hype-strip-body">
      <div class="hs-item">
        <span class="hs-label">HL Rate</span>
        <span class="hs-value" id="hs-hl-rate"><span style="color:var(--muted)">—</span></span>
      </div>
      <div class="hs-item">
        <span class="hs-label">dYdX Rate</span>
        <span class="hs-value" id="hs-dydx-rate"><span style="color:var(--muted)">—</span></span>
      </div>
      <div class="hs-item">
        <span class="hs-label">Spread</span>
        <span class="hs-value" id="hs-spread"><span style="color:var(--muted)">—</span></span>
      </div>
      <div class="hs-item">
        <span class="hs-label">× Default</span>
        <span class="hs-value" id="hs-xdef"><span style="color:var(--muted)">—</span></span>
      </div>
      <canvas class="hs-sparkline" id="hs-sparkline" title="HYPE HL funding rate 24h"></canvas>
      <a class="hs-link" href="/funding">Full matrix →</a>
    </div>
  </div>

  <!-- Chart + Depth combined panel -->
  <div class="chart-card" style="margin:0 0 var(--sp-5)">
    <div class="chart-card-toolbar">
      <div class="tf-group" style="margin-right:0.5rem">
        <button class="tf active" id="panel-tab-chart" aria-pressed="true">Chart</button>
        <button class="tf"        id="panel-tab-depth" aria-pressed="false">Depth</button>
      </div>
      <input class="coin-search" id="chart-coin-input" type="text"
             list="chart-coin-list" value="HYPE"
             placeholder="Coin" autocomplete="off" spellcheck="false"
             title="Type or pick a coin symbol">
      <datalist id="chart-coin-list">
        <% for (const c of coins) { %><option value="<%= c %>"><% } %>
      </datalist>
      <div class="tf-group" id="chart-tf-group">
        <button class="tf" data-tf="1m">1m</button>
        <button class="tf" data-tf="5m">5m</button>
        <button class="tf" data-tf="15m">15m</button>
        <button class="tf active" data-tf="1h">1h</button>
        <button class="tf" data-tf="4h">4h</button>
      </div>
      <span id="chart-coin-label" class="text-muted" style="font-size:11px;margin-left:4px">HYPE/USDT</span>
      <span class="chart-updated" id="chart-updated"></span>
    </div>

    <div id="chart-view">
      <div class="chart-row">
        <div class="chart-row-label">Candles</div>
        <div id="chart-candles"><div id="ohlc-legend"></div></div>
      </div>
      <div class="chart-row">
        <div class="chart-row-label">Volume &nbsp;<span style="color:#d29922;font-size:9px">· spread</span></div>
        <div id="chart-volume"></div>
      </div>
      <div class="chart-row">
        <div class="chart-row-label">RSI 14</div>
        <div id="chart-rsi"></div>
      </div>
      <div class="chart-row">
        <div class="chart-row-label">Equity</div>
        <div id="chart-equity"></div>
      </div>
    </div>

    <div id="depth-view">
      <div id="depth-view-inner">
        <div>
          <div class="ob-header">
            Market Depth
            <span class="text-muted" id="depth-coin-label" style="font-weight:400;font-size:11px">HYPE/USDT</span>
          </div>
          <canvas id="depth-canvas"></canvas>
        </div>
        <div class="ob-table-wrap">
          <div class="ob-header">Order Book <span class="text-muted" style="font-weight:400;font-size:11px">(top 10)</span></div>
          <table id="ob-table">
            <thead><tr><th>Price</th><th>Size</th><th>Total</th></tr></thead>
            <tbody id="ob-tbody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Equity curve ── -->
  <div class="chart-card" id="eq-panel" style="margin:0 0 var(--sp-5)">
    <div class="chart-card-toolbar">
      <span class="chart-card-title">Equity Curve</span>
      <div class="tf-group" id="eq-range-group">
        <button class="tf active" data-eq="24h">24h</button>
        <button class="tf"        data-eq="7d">7d</button>
        <button class="tf"        data-eq="30d">30d</button>
      </div>
      <span class="chart-card-meta" id="eq-updated"></span>
    </div>
    <div id="eq-chart" style="height:200px;position:relative"></div>
  </div>

  <!-- ── Funding rate history ── -->
  <div class="chart-card" id="fh-panel" style="margin:0 0 var(--sp-5)">
    <div class="chart-card-toolbar">
      <span class="chart-card-title">Funding Rate History</span>
      <select class="an-coin-sel" id="fh-coin-sel"><option value="HYPE">HYPE</option></select>
      <div class="tf-group" id="fh-range-group">
        <button class="tf active" data-fh="24h">24h</button>
        <button class="tf"        data-fh="7d">7d</button>
      </div>
      <span style="font-size:var(--t-label);color:var(--muted);display:flex;align-items:center;gap:var(--sp-2);margin-left:var(--sp-2)">
        <span style="display:inline-block;width:10px;height:2px;background:var(--green);border-radius:1px"></span>HL
        <span style="display:inline-block;width:10px;height:2px;background:var(--accent);border-radius:1px"></span>dYdX
        <span style="display:inline-block;width:10px;height:6px;background:var(--accent-dim);border-radius:1px"></span>Spread
      </span>
      <span class="chart-card-meta" id="fh-updated"></span>
    </div>
    <div id="fh-chart" style="height:180px;position:relative"></div>
  </div>

  <!-- ── Events log ── -->
  <div style="display:flex;align-items:baseline;gap:var(--sp-3);margin-bottom:var(--sp-2)">
    <p class="section-title" style="margin:0">Recent Events</p>
  </div>
  <div class="ev-filter-bar">
    <span class="ev-filter-label">Level</span>
    <button class="ev-level-btn" data-level="debug">debug</button>
    <button class="ev-level-btn" data-level="info">info</button>
    <button class="ev-level-btn active" data-level="warn">warn</button>
    <button class="ev-level-btn active" data-level="error">error</button>
    <span class="ev-filter-label" style="margin-left:var(--sp-2)">Module</span>
    <select class="ev-mod-select" id="ev-mod-select"><option value="">All</option></select>
  </div>
  <div class="table-wrap">
    <table style="width:100%;border-collapse:collapse">
      <thead>
        <tr><th style="text-align:left;padding:4px 8px;font-size:10px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid var(--border)">Time</th>
            <th style="text-align:left;padding:4px 8px;font-size:10px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid var(--border)">Module</th>
            <th style="text-align:left;padding:4px 8px;font-size:10px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid var(--border)">Level</th>
            <th style="text-align:left;padding:4px 8px;font-size:10px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid var(--border)">Message</th></tr>
      </thead>
      <tbody id="events-tbody">
        <tr><td colspan="4" style="padding:1.5rem;text-align:center;color:var(--muted);font-size:13px">Loading…</td></tr>
      </tbody>
    </table>
  </div>

</div><!-- /container -->

<script src="https://unpkg.com/lightweight-charts@4/dist/lightweight-charts.standalone.production.js"></script>

<!-- ── Shared formatting ── -->
<script>
(function () {
  'use strict';
  var HOURS_PER_YEAR = 8760;
  window.FMT = {
    pnl: function (v) {
      if (v == null || !isFinite(v)) return '—';
      var abs = Math.abs(v), sign = v < 0 ? '-' : '+';
      return sign + '$' + abs.toFixed(2);
    },
    oi: function (v) {
      if (v == null || !isFinite(v) || v === 0) return '—';
      var abs = Math.abs(v);
      if (abs >= 1e9) return '$' + (abs / 1e9).toFixed(2) + 'B';
      if (abs >= 1e6) return '$' + (abs / 1e6).toFixed(1) + 'M';
      if (abs >= 1e3) return '$' + (abs / 1e3).toFixed(0) + 'K';
      return '$' + abs.toFixed(0);
    },
    usd: function (v) {
      if (v == null || !isFinite(v)) return '—';
      return '$' + Math.abs(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    },
    rate: function (r) {
      if (r == null || !isFinite(r)) return null;
      return (r >= 0 ? '+' : '') + (r * 100).toFixed(4) + '%';
    },
    ann: function (r) {
      if (r == null || !isFinite(r)) return null;
      var pct = r * HOURS_PER_YEAR * 100, ANN_CAP = 300;
      if (!isFinite(pct)) return null;
      var capped = Math.max(-ANN_CAP, Math.min(ANN_CAP, pct));
      return (Math.abs(pct) > ANN_CAP ? '>' : '') + (capped >= 0 ? '+' : '') +
             (Math.abs(capped) >= 100 ? capped.toFixed(0) : capped.toFixed(1)) + '%/yr';
    },
    spread: function (r) {
      if (r == null || !isFinite(r)) return null;
      return (r * 100).toFixed(4) + '%';
    },
    age: function (ms) {
      if (ms == null || !isFinite(ms)) return '—';
      var s = Math.round(ms / 1000);
      if (s < 60)  return s + 's ago';
      var m = Math.round(s / 60);
      if (m < 60)  return m + 'm ago';
      return Math.round(m / 60) + 'h ago';
    },
  };
})();
</script>

<!-- ── Onboarding dismiss (cookie) ── -->
<script>
(function () {
  'use strict';
  var card = document.getElementById('onboard-card');
  if (!card) return;
  var COOKIE = 'ov_intro_dismissed=1';
  if (document.cookie.indexOf('ov_intro_dismissed=1') !== -1) {
    card.style.display = 'none';
    return;
  }
  var btn = document.getElementById('onboard-dismiss');
  if (btn) btn.addEventListener('click', function () {
    var exp = new Date(Date.now() + 30 * 86400000).toUTCString();
    document.cookie = COOKIE + '; path=/; expires=' + exp + '; SameSite=Lax';
    card.style.display = 'none';
  });
})();
</script>

<!-- ── Overview tiles ── -->
<script>
(function () {
  'use strict';
  var FMT = window.FMT;

  function rateCls(r) {
    if (r === null || !isFinite(r)) return 'hs-rate-nil';
    return r > 0 ? 'hs-rate-pos' : r < 0 ? 'hs-rate-neg' : 'hs-rate-nil';
  }

  function pnlSpan(v) {
    if (v == null || !isFinite(v)) return '<span style="color:var(--muted)">—</span>';
    var col = v > 0 ? 'var(--up)' : v < 0 ? 'var(--down)' : 'var(--muted)';
    return '<span style="color:' + col + '">' + FMT.pnl(v) + '</span>';
  }

  async function refreshOverview() {
    try {
      var d = await fetch('/api/overview').then(function (r) { return r.json(); });

      /* ── 1. HYPE tile ── */
      var priceEl = document.getElementById('tile-hype-price');
      if (priceEl) {
        priceEl.innerHTML = d.hype.price != null
          ? '$' + Number(d.hype.price).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 })
          : '<span style="color:var(--muted)">—</span>';
      }
      var rateEl = document.getElementById('tile-hype-rate');
      if (rateEl) {
        var rFmt = d.hype.hlRate != null ? FMT.rate(d.hype.hlRate) : null;
        if (rFmt) {
          var col = d.hype.hlRate > 0 ? 'var(--up)' : d.hype.hlRate < 0 ? 'var(--down)' : 'var(--muted)';
          rateEl.innerHTML = '<span style="color:' + col + '">' + rFmt + '/hr HL</span>';
        } else {
          rateEl.innerHTML = '<span style="color:var(--muted)">no funding data</span>';
        }
      }
      var xdefEl = document.getElementById('tile-hype-xdef');
      if (xdefEl && d.hype.xDefault != null) {
        var x = d.hype.xDefault;
        xdefEl.textContent = (x >= 0 ? '+' : '') + x.toFixed(1) + '× default';
        xdefEl.style.display = 'inline-block';
      }

      /* ── 2. Bots tile ── */
      var botsValEl = document.getElementById('tile-bots-value');
      var botsSubEl = document.getElementById('tile-bots-sub');
      var botsBadgesEl = document.getElementById('tile-bots-badges');
      var b = d.bots;
      if (botsValEl) {
        botsValEl.textContent = b.running + ' live';
        if (b.hasShadow) botsValEl.innerHTML += '<span class="shadow-badge">SHADOW</span>';
      }
      if (botsSubEl) botsSubEl.textContent = b.paper + ' paper running';
      if (botsBadgesEl) {
        botsBadgesEl.innerHTML = b.running + b.paper === 0
          ? '<span class="sc-badge sc-source">None running</span>'
          : '<a href="/bots" class="sc-badge sc-source" style="text-decoration:none">View bots →</a>';
      }

      /* ── 3. Portfolio P&L tile ── */
      var pnlSessEl = document.getElementById('tile-pnl-session');
      var pnlAllEl  = document.getElementById('tile-pnl-alltime');
      if (pnlSessEl) pnlSessEl.innerHTML = pnlSpan(d.portfolio.sessionPnl);
      if (pnlAllEl)  pnlAllEl.innerHTML  = 'All-time: ' + pnlSpan(d.portfolio.allTimePnl);

      /* ── 4. Best Strategy tile ── */
      var stratValEl = document.getElementById('tile-strategy-value');
      var stratSubEl = document.getElementById('tile-strategy-sub');
      if (d.bestStrategy) {
        var wf = d.bestStrategy;
        if (stratValEl) stratValEl.textContent = wf.strategyName || wf.strategyId;
        if (stratSubEl) {
          var sharpeCol = wf.meanOosSharpe >= 1 ? 'var(--up)' : wf.meanOosSharpe >= 0 ? 'var(--muted)' : 'var(--down)';
          stratSubEl.innerHTML =
            'OOS Sharpe <span style="color:' + sharpeCol + '">' + wf.meanOosSharpe.toFixed(2) + '</span>' +
            ' · ' + wf.pctBeatBH.toFixed(0) + '% beat B&H' +
            ' · ' + wf.coin;
          stratSubEl.style.fontStyle = 'normal';
        }
      }

      /* ── 5. Signal Health tile ── */
      var sigValEl = document.getElementById('tile-signals-value');
      var sigSubEl = document.getElementById('tile-signals-sub');
      var sigBadgesEl = document.getElementById('tile-signals-badges');
      var sh = d.signalHealth;
      if (sigValEl) {
        sigValEl.textContent = sh.warmSignalCount > 0
          ? sh.warmSignalCount + ' warm'
          : '—';
      }
      if (sigSubEl) {
        sigSubEl.textContent = sh.latestSnapshotAgeMs != null
          ? 'Last snapshot ' + FMT.age(sh.latestSnapshotAgeMs)
          : 'No snapshots yet';
      }
      if (sigBadgesEl) {
        var stale = sh.latestSnapshotAgeMs == null || sh.latestSnapshotAgeMs > 600000;
        sigBadgesEl.innerHTML = stale
          ? '<span class="sc-badge" style="background:rgba(210,153,34,.12);color:#d29922">STALE</span>'
          : '<span class="sc-badge sc-kind-level">LIVE</span>';
      }

      /* ── 6. Shadow Status tile ── */
      var shadValEl  = document.getElementById('tile-shadow-value');
      var shadSubEl  = document.getElementById('tile-shadow-sub');
      var shadBadges = document.getElementById('tile-shadow-badges');
      if (b.hasShadow) {
        var stance = b.shadowStance || 'neutral';
        var stanceCol = stance === 'long' ? 'var(--up)' : stance === 'short' ? 'var(--down)' : 'var(--muted)';
        if (shadValEl) shadValEl.innerHTML = '<span style="color:' + stanceCol + '">' + stance.toUpperCase() + '</span>';
        if (shadSubEl) {
          shadSubEl.textContent = b.shadowSignalAgeMs != null
            ? 'Signal ' + FMT.age(b.shadowSignalAgeMs)
            : 'No signal yet';
        }
        if (shadBadges) shadBadges.innerHTML = '<span class="sc-badge sc-kind-level">SHADOW ACTIVE</span>';
      } else {
        if (shadValEl) shadValEl.innerHTML = '<span style="color:var(--muted)">No shadow bot</span>';
        if (shadSubEl) shadSubEl.textContent = 'Add a signal-driven paper bot';
        if (shadBadges) shadBadges.innerHTML = '';
      }

      /* ── HYPE strip ── */
      var hsHl  = document.getElementById('hs-hl-rate');
      var hsDy  = document.getElementById('hs-dydx-rate');
      var hsSp  = document.getElementById('hs-spread');
      var hsXd  = document.getElementById('hs-xdef');
      var hsUp  = document.getElementById('hs-updated');
      function rateHtml(r) {
        if (r == null) return '<span style="color:var(--muted)">—</span>';
        var cls = rateCls(r);
        return '<span class="' + cls + '">' + (FMT.rate(r) || '—') + '/hr</span>';
      }
      if (hsHl)  hsHl.innerHTML  = rateHtml(d.hype.hlRate);
      if (hsDy)  hsDy.innerHTML  = rateHtml(d.hype.dydxRate);
      if (hsSp)  hsSp.innerHTML  = d.hype.spread != null
        ? '<span>' + (FMT.spread(d.hype.spread) || '—') + '</span>' : '<span style="color:var(--muted)">—</span>';
      if (hsXd)  hsXd.textContent = d.hype.xDefault != null
        ? (d.hype.xDefault >= 0 ? '+' : '') + d.hype.xDefault.toFixed(1) + '×' : '—';
      if (hsUp)  hsUp.textContent = 'updated just now';

    } catch (e) {
      console.warn('Overview refresh failed:', e);
    }
  }

  refreshOverview();
  setInterval(refreshOverview, 10000);

  /* ── HYPE sparkline (24h HL funding history) ── */
  (function () {
    var canvas = document.getElementById('hs-sparkline');
    if (!canvas) return;

    function drawSparkline(points) {
      var dpr = window.devicePixelRatio || 1;
      var w = canvas.offsetWidth, h = canvas.offsetHeight;
      if (w === 0 || h === 0) return;
      canvas.width  = w * dpr;
      canvas.height = h * dpr;
      var ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);

      if (!points || points.length < 2) {
        ctx.fillStyle = 'var(--muted)';
        ctx.font = '9px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('no data', w / 2, h / 2 + 4);
        return;
      }

      var vals = points.map(function (p) { return p.v; });
      var min = Math.min.apply(null, vals);
      var max = Math.max.apply(null, vals);
      var range = max - min || 1e-9;
      var PAD = 3;
      var toX = function (i) { return PAD + (i / (points.length - 1)) * (w - PAD * 2); };
      var toY = function (v) { return h - PAD - ((v - min) / range) * (h - PAD * 2); };

      // zero line
      var zy = toY(0);
      if (zy >= 0 && zy <= h) {
        ctx.beginPath();
        ctx.setLineDash([3, 3]);
        ctx.strokeStyle = 'rgba(139,148,158,0.3)';
        ctx.lineWidth = 1;
        ctx.moveTo(0, zy); ctx.lineTo(w, zy);
        ctx.stroke();
        ctx.setLineDash([]);
      }

      // positive/negative coloured segments
      var posCol  = getComputedStyle(document.documentElement).getPropertyValue('--up').trim()   || '#3fb950';
      var negCol  = getComputedStyle(document.documentElement).getPropertyValue('--down').trim() || '#f85149';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      points.forEach(function (p, i) {
        if (i === 0) ctx.moveTo(toX(i), toY(p.v));
        else         ctx.lineTo(toX(i), toY(p.v));
      });
      // single colour: positive if latest > 0, negative if latest < 0
      var latest = vals[vals.length - 1];
      ctx.strokeStyle = latest >= 0 ? posCol : negCol;
      ctx.stroke();
    }

    async function loadSparkline() {
      try {
        var rows = await fetch('/api/funding-history?coin=HYPE&range=24h').then(function (r) { return r.json(); });
        if (!Array.isArray(rows) || rows.length === 0) { drawSparkline(null); return; }
        var pts = rows
          .filter(function (r) { return r.hl !== null; })
          .map(function (r) { return { v: r.hl }; });
        drawSparkline(pts);
      } catch (e) { drawSparkline(null); }
    }

    loadSparkline();
    setInterval(loadSparkline, 60000);
  })();

})();
</script>

<!-- ── Candle chart ── -->
<script>
(function () {
  const LC = LightweightCharts;

  function getCssVar(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }
  function chartOpts() {
    return {
      layout: {
        background: { type: 'solid', color: getCssVar('--surface') || '#161b22' },
        textColor:  getCssVar('--muted')  || '#8b949e',
        attributionLogo: false,
      },
      grid: {
        vertLines: { color: getCssVar('--border') || '#21262d' },
        horzLines: { color: getCssVar('--border') || '#21262d' },
      },
      crosshair: { mode: 1 },
      rightPriceScale: { borderColor: getCssVar('--border') || '#30363d' },
      handleScroll: { mouseWheel: true, pressedMouseMove: true },
      handleScale: { mouseWheel: true, pinch: true },
    };
  }

  let candleChart = null, volChart = null, rsiChart = null;
  let candleSeries = null, volSeries = null, spreadSeries = null, rsiSeries = null;
  let volMap = new Map(), rsiMap = new Map();
  let latestCandle = null;
  const legend = document.getElementById('ohlc-legend');
  const timeScaleOpts = { borderColor: '#30363d', timeVisible: true, secondsVisible: false };

  const equityChart = LC.createChart(document.getElementById('chart-equity'), {
    ...chartOpts(), height: 100, timeScale: timeScaleOpts,
  });
  const equitySeries = equityChart.addAreaSeries({
    lineColor: '#58a6ff', topColor: 'rgba(88,166,255,0.2)', bottomColor: 'rgba(88,166,255,0)',
    lineWidth: 1, priceFormat: { type: 'price', precision: 2, minMove: 0.01 },
  });
  equityChart.priceScale('right').applyOptions({ scaleMargins: { top: 0.1, bottom: 0.1 } });

  function mountCharts() {
    if (candleChart) return;
    candleChart = LC.createChart(document.getElementById('chart-candles'), {
      ...chartOpts(), height: 450, timeScale: { ...timeScaleOpts, visible: false },
    });
    volChart = LC.createChart(document.getElementById('chart-volume'), {
      ...chartOpts(), height: 120, timeScale: { ...timeScaleOpts, visible: false },
    });
    rsiChart = LC.createChart(document.getElementById('chart-rsi'), {
      ...chartOpts(), height: 150, timeScale: { ...timeScaleOpts, visible: false },
    });
    candleSeries = candleChart.addCandlestickSeries({
      upColor: '#3fb950', downColor: '#f85149',
      borderUpColor: '#3fb950', borderDownColor: '#f85149',
      wickUpColor: '#3fb950', wickDownColor: '#f85149',
    });
    volSeries = volChart.addHistogramSeries({ priceFormat: { type: 'volume' }, priceScaleId: '' });
    volChart.priceScale('').applyOptions({ scaleMargins: { top: 0.05, bottom: 0.2 } });
    spreadSeries = volChart.addLineSeries({ color: '#d29922', lineWidth: 1, priceScaleId: 'spread' });
    volChart.priceScale('spread').applyOptions({ scaleMargins: { top: 0.6, bottom: 0 }, visible: false });
    rsiSeries = rsiChart.addLineSeries({ color: '#58a6ff', lineWidth: 1 });
    rsiChart.priceScale('right').applyOptions({ scaleMargins: { top: 0.1, bottom: 0.1 } });
    rsiSeries.createPriceLine({ price: 70, color: '#f85149', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: '70' });
    rsiSeries.createPriceLine({ price: 30, color: '#3fb950', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: '30' });

    let syncing = false;
    function syncFrom(src, targets) {
      src.timeScale().subscribeVisibleLogicalRangeChange((range) => {
        if (syncing || !range) return;
        syncing = true;
        targets.forEach((t) => t.timeScale().setVisibleLogicalRange(range));
        syncing = false;
      });
    }
    syncFrom(candleChart, [volChart, rsiChart]);
    syncFrom(volChart,    [candleChart, rsiChart]);
    syncFrom(rsiChart,    [candleChart, volChart]);

    let crossSyncing = false;
    candleChart.subscribeCrosshairMove((param) => {
      if (crossSyncing) return; crossSyncing = true;
      if (!param.point || !param.time) {
        volChart.clearCrosshairPosition(); rsiChart.clearCrosshairPosition();
      } else {
        const t = param.time;
        volChart.setCrosshairPosition(volMap.get(t) ?? 0, t, volSeries);
        rsiChart.setCrosshairPosition(rsiMap.get(t) ?? 50, t, rsiSeries);
      }
      crossSyncing = false;
    });
    volChart.subscribeCrosshairMove((param) => {
      if (crossSyncing) return; crossSyncing = true;
      if (!param.point || !param.time) {
        candleChart.clearCrosshairPosition(); rsiChart.clearCrosshairPosition();
      } else {
        rsiChart.setCrosshairPosition(rsiMap.get(param.time) ?? 50, param.time, rsiSeries);
      }
      crossSyncing = false;
    });
    rsiChart.subscribeCrosshairMove((param) => {
      if (crossSyncing) return; crossSyncing = true;
      if (!param.point || !param.time) {
        candleChart.clearCrosshairPosition(); volChart.clearCrosshairPosition();
      } else {
        volChart.setCrosshairPosition(volMap.get(param.time) ?? 0, param.time, volSeries);
      }
      crossSyncing = false;
    });
    candleChart.subscribeCrosshairMove((param) => {
      if (param.time && param.seriesData && param.seriesData.size > 0) {
        const bar = param.seriesData.get(candleSeries);
        if (bar) renderLegend(bar);
      } else if (latestCandle) { renderLegend(latestCandle); }
    });
    if (latestCandle) renderLegend(latestCandle);
  }

  function disposeCharts() {
    [candleChart, volChart, rsiChart].forEach((c) => { if (c) c.remove(); });
    candleChart = volChart = rsiChart = null;
    candleSeries = volSeries = spreadSeries = rsiSeries = null;
    volMap.clear(); rsiMap.clear();
  }

  function renderLegend(bar) {
    if (!bar || !legend) return;
    const dp  = bar.close >= 1000 ? 1 : bar.close >= 10 ? 2 : 4;
    const pct = ((bar.close - bar.open) / bar.open * 100);
    const col = pct >= 0 ? getCssVar('--green') || '#3fb950' : getCssVar('--red') || '#f85149';
    legend.innerHTML =
      '<span class="lbl">O</span>' + bar.open.toFixed(dp) + '&nbsp;' +
      '<span class="lbl">H</span>' + bar.high.toFixed(dp) + '&nbsp;' +
      '<span class="lbl">L</span>' + bar.low.toFixed(dp)  + '&nbsp;' +
      '<span class="lbl">C</span>' + bar.close.toFixed(dp) + '&nbsp;&nbsp;' +
      '<span style="color:' + col + ';font-variant-numeric:tabular-nums">' +
      (pct >= 0 ? '+' : '') + pct.toFixed(2) + '%</span>';
  }

  let activeTab = 'chart';
  const chartView = document.getElementById('chart-view');
  const depthView = document.getElementById('depth-view');
  const tabChart  = document.getElementById('panel-tab-chart');
  const tabDepth  = document.getElementById('panel-tab-depth');

  function activateTab(tab) {
    if (tab === activeTab) return;
    activeTab = tab;
    if (tab === 'chart') {
      depthView.style.display = 'none'; chartView.style.display = '';
      tabChart.classList.add('active');    tabChart.setAttribute('aria-pressed', 'true');
      tabDepth.classList.remove('active'); tabDepth.setAttribute('aria-pressed', 'false');
      mountCharts(); refreshChart();
    } else {
      chartView.style.display = 'none'; depthView.style.display = '';
      tabDepth.classList.add('active');    tabDepth.setAttribute('aria-pressed', 'true');
      tabChart.classList.remove('active'); tabChart.setAttribute('aria-pressed', 'false');
      disposeCharts();
    }
  }
  if (tabChart) tabChart.addEventListener('click', () => activateTab('chart'));
  if (tabDepth) tabDepth.addEventListener('click', () => activateTab('depth'));

  let chartCoin = 'HYPE';
  let chartTf   = '1h';
  let firstLoad = true;

  fetch('/api/funding-matrix')
    .then((r) => r.ok ? r.json() : null)
    .then((data) => {
      if (!data || !Array.isArray(data.coins)) return;
      const dl = document.getElementById('chart-coin-list');
      if (dl) dl.innerHTML = data.coins.map((c) => `<option value="${c.coin}">`).join('');
    })
    .catch(() => {});

  const coinInput = document.getElementById('chart-coin-input');
  function applyCoinChange() {
    const v = (coinInput?.value || '').toUpperCase().trim();
    if (!v || v === chartCoin) return;
    chartCoin = v;
    const lbl = document.getElementById('chart-coin-label');
    if (lbl) lbl.textContent = chartCoin + '/USDT';
    const depthLbl = document.getElementById('depth-coin-label');
    if (depthLbl) depthLbl.textContent = chartCoin + '/USDT';
    firstLoad = true;
    if (activeTab === 'chart') refreshChart();
  }
  if (coinInput) {
    coinInput.addEventListener('change', applyCoinChange);
    coinInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { coinInput.blur(); applyCoinChange(); } });
  }

  document.getElementById('chart-tf-group')?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-tf]');
    if (!btn) return;
    chartTf = btn.dataset.tf;
    document.querySelectorAll('#chart-tf-group .tf').forEach((b) => b.classList.toggle('active', b === btn));
    firstLoad = true;
    if (activeTab === 'chart') refreshChart();
  });

  async function refreshChart() {
    if (!candleChart) mountCharts();
    const updEl = document.getElementById('chart-updated');
    try {
      const url  = `/api/candles/dynamic?coin=${encodeURIComponent(chartCoin)}&interval=${chartTf}`;
      const resp = await fetch(url);
      const data = await resp.json();
      if (!resp.ok) {
        if (legend) legend.innerHTML = '<span style="color:var(--muted)">' + (data.error || 'No data') + '</span>';
        if (updEl) updEl.textContent = 'error';
        return;
      }
      if (!data.candles || data.candles.length === 0) {
        if (legend) legend.innerHTML = '<span style="color:var(--muted)">No candle data for ' + chartCoin + '</span>';
        return;
      }
      candleSeries.setData(data.candles);
      candleSeries.setMarkers(data.markers || []);
      volSeries.setData(data.volume);
      if (data.rsi && data.rsi.length > 0) rsiSeries.setData(data.rsi);
      if (data.spread && data.spread.length > 0) spreadSeries.setData(data.spread);
      volMap.clear(); (data.volume || []).forEach((d) => volMap.set(d.time, d.value));
      rsiMap.clear(); (data.rsi    || []).forEach((d) => rsiMap.set(d.time, d.value));
      if (firstLoad) { candleChart.timeScale().fitContent(); firstLoad = false; }
      latestCandle = data.candles[data.candles.length - 1];
      renderLegend(latestCandle);
      if (updEl) updEl.textContent = 'updated ' + new Date().toLocaleTimeString();
    } catch (e) {
      console.warn('Chart refresh failed:', e);
      if (updEl) updEl.textContent = 'error';
    }
  }

  mountCharts();
  refreshChart();
  setInterval(() => { if (activeTab === 'chart') refreshChart(); }, 10000);

  // PnL / equity refresh (for the equity row inside the chart panel)
  let equityFirstLoad = true;
  async function refreshPnl() {
    try {
      const d = await fetch('/api/pnl').then((r) => r.json());
      if (d.equityHistory && d.equityHistory.length > 0) {
        const eq = d.equityHistory.map((p) => ({ time: Math.floor(p.time / 1000), value: p.equity }));
        equitySeries.setData(eq);
        if (equityFirstLoad) { equityChart.timeScale().fitContent(); equityFirstLoad = false; }
      }
    } catch (_) {}
  }
  refreshPnl();
  setInterval(refreshPnl, 10000);

  // Depth / order-book
  const depthCanvas = document.getElementById('depth-canvas');
  function drawDepth(ob) {
    if (!depthCanvas) return;
    const cssW = depthCanvas.offsetWidth, cssH = depthCanvas.offsetHeight;
    if (cssW === 0 || cssH === 0) return;
    if (depthCanvas.width !== cssW || depthCanvas.height !== cssH) {
      depthCanvas.width = cssW; depthCanvas.height = cssH;
    }
    const ctx = depthCanvas.getContext('2d');
    if (!ctx) return;
    const W = cssW, H = cssH;
    ctx.clearRect(0, 0, W, H);
    const bids = ob.bids || [], asks = ob.asks || [];
    if (bids.length === 0 || asks.length === 0) {
      ctx.fillStyle = getCssVar('--muted') || '#8b949e';
      ctx.font = '12px sans-serif'; ctx.textAlign = 'center';
      ctx.fillText('Awaiting order book data…', W / 2, H / 2); return;
    }
    const minPrice = bids[bids.length-1].price, maxPrice = asks[asks.length-1].price;
    const midPrice = (bids[0].price + asks[0].price) / 2;
    const priceSpan = maxPrice - minPrice;
    if (priceSpan <= 0) return;
    const maxCum = Math.max(bids[bids.length-1].total, asks[asks.length-1].total);
    if (maxCum <= 0) return;
    const PAD_TOP = 0.08, PAD_BOT = 0.15;
    const toX = (p) => ((p - minPrice) / priceSpan) * W;
    const toY = (s) => H * (1-PAD_BOT) - (s / maxCum) * H * (1-PAD_TOP-PAD_BOT);
    const midX = toX(midPrice);
    ctx.beginPath(); ctx.moveTo(toX(minPrice), H);
    ctx.lineTo(toX(minPrice), toY(bids[bids.length-1].total));
    for (let i = bids.length-1; i >= 0; i--) {
      const nP = i > 0 ? bids[i-1].price : midPrice, nT = i > 0 ? bids[i-1].total : 0;
      ctx.lineTo(toX(nP), toY(bids[i].total)); ctx.lineTo(toX(nP), toY(nT));
    }
    ctx.lineTo(midX, H); ctx.closePath();
    ctx.fillStyle = 'rgba(63,185,80,0.15)'; ctx.fill();
    ctx.beginPath(); ctx.moveTo(toX(minPrice), toY(bids[bids.length-1].total));
    for (let i = bids.length-1; i >= 0; i--) {
      const nP = i > 0 ? bids[i-1].price : midPrice, nT = i > 0 ? bids[i-1].total : 0;
      ctx.lineTo(toX(nP), toY(bids[i].total)); ctx.lineTo(toX(nP), toY(nT));
    }
    ctx.strokeStyle = '#3fb950'; ctx.lineWidth = 1.5; ctx.stroke();
    ctx.beginPath(); ctx.moveTo(midX, H); ctx.lineTo(midX, toY(0));
    for (let i = 0; i < asks.length; i++) {
      const pT = i > 0 ? asks[i-1].total : 0;
      ctx.lineTo(toX(asks[i].price), toY(pT)); ctx.lineTo(toX(asks[i].price), toY(asks[i].total));
    }
    ctx.lineTo(W, toY(asks[asks.length-1].total)); ctx.lineTo(W, H); ctx.closePath();
    ctx.fillStyle = 'rgba(248,81,73,0.15)'; ctx.fill();
    ctx.beginPath(); ctx.moveTo(midX, toY(0));
    for (let i = 0; i < asks.length; i++) {
      const pT = i > 0 ? asks[i-1].total : 0;
      ctx.lineTo(toX(asks[i].price), toY(pT)); ctx.lineTo(toX(asks[i].price), toY(asks[i].total));
    }
    ctx.lineTo(W, toY(asks[asks.length-1].total));
    ctx.strokeStyle = '#f85149'; ctx.lineWidth = 1.5; ctx.stroke();
    ctx.beginPath(); ctx.setLineDash([4,4]);
    ctx.strokeStyle = 'rgba(139,148,158,0.4)'; ctx.lineWidth = 1;
    ctx.moveTo(midX, 0); ctx.lineTo(midX, H*(1-PAD_BOT)); ctx.stroke(); ctx.setLineDash([]);
    const fmtP = (p) => p >= 10000 ? p.toFixed(0) : p >= 100 ? p.toFixed(1) : p.toFixed(2);
    ctx.fillStyle = 'rgba(139,148,158,0.8)'; ctx.font = '9px monospace';
    ctx.textAlign = 'left'; ctx.fillText(fmtP(minPrice), 4, H-3);
    ctx.textAlign = 'center'; ctx.fillText(fmtP(midPrice), midX, H-3);
    ctx.textAlign = 'right'; ctx.fillText(fmtP(maxPrice), W-4, H-3);
  }
  function updateObTable(ob) {
    const tbody = document.getElementById('ob-tbody');
    if (!tbody) return;
    const bids = (ob.bids || []).slice(0,10), asks = (ob.asks || []).slice(0,10);
    const spread = bids.length > 0 && asks.length > 0 ? asks[0].price - bids[0].price : null;
    const fmtP = (p) => p >= 10000 ? p.toFixed(1) : p.toFixed(2);
    const fmtS = (s) => s >= 100 ? s.toFixed(1) : s >= 10 ? s.toFixed(2) : s.toFixed(3);
    let rows = '';
    for (const a of [...asks].reverse()) {
      rows += `<tr class="ob-ask"><td>${fmtP(a.price)}</td><td>${fmtS(a.size)}</td><td>${fmtS(a.total)}</td></tr>`;
    }
    const spreadTxt = spread !== null ? '$' + spread.toFixed(2) + ' spread' : '— spread —';
    rows += `<tr class="ob-spread"><td colspan="3" style="padding:3px 8px">${spreadTxt}</td></tr>`;
    for (const b of bids) {
      rows += `<tr class="ob-bid"><td>${fmtP(b.price)}</td><td>${fmtS(b.size)}</td><td>${fmtS(b.total)}</td></tr>`;
    }
    tbody.innerHTML = rows;
  }
  async function refreshOrderbook() {
    try {
      const ob = await fetch('/api/orderbook?coin=' + encodeURIComponent(chartCoin)).then((r) => r.json());
      const labelEl = document.getElementById('depth-coin-label');
      if (labelEl) labelEl.textContent = chartCoin + '/USDT';
      drawDepth(ob); updateObTable(ob);
    } catch (_) {}
  }
  refreshOrderbook();
  setInterval(refreshOrderbook, 2000);

  if (typeof ResizeObserver !== 'undefined') {
    const ro = new ResizeObserver(() => {
      [candleChart, volChart, rsiChart, equityChart].filter(Boolean).forEach((c) => c.applyOptions({ width: 0 }));
    });
    const panel = document.querySelector('.chart-card');
    if (panel) ro.observe(panel);
  }

})();
</script>

<!-- ── Analytics charts: equity curve + funding history ── -->
<script>
(function () {
  'use strict';
  var LC  = window.LightweightCharts;
  var FMT = window.FMT;

  function getCssVar(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }
  function baseChartOpts(height) {
    var accent = getCssVar('--accent') || '#818CF8';
    var border = getCssVar('--border') || 'rgba(129,140,248,0.14)';
    return {
      width: 0, height: height,
      layout: {
        background: { type: 'solid', color: getCssVar('--surface') || '#0D1520' },
        textColor: getCssVar('--muted') || '#3D5A78', fontSize: 11, attributionLogo: false,
      },
      grid: { vertLines: { color: border, style: 1 }, horzLines: { color: border, style: 1 } },
      crosshair: {
        mode: 0,
        vertLine: { color: accent, width: 1, style: 1, labelBackgroundColor: accent },
        horzLine: { color: accent, width: 1, style: 1, labelBackgroundColor: accent },
      },
      rightPriceScale: { borderColor: border },
      timeScale: { borderColor: border, timeVisible: true },
      handleScroll: true, handleScale: true,
    };
  }
  function showState(container, kind, text) {
    var old = container.querySelector('.an-state-overlay');
    if (old) old.remove();
    var div = document.createElement('div');
    div.className = 'an-state' + (kind === 'error' ? ' an-state-err' : '') + ' an-state-overlay';
    div.style.cssText = 'position:absolute;inset:0;background:' + (getCssVar('--surface') || '#161b22');
    var icon = kind === 'empty' ? '📭' : kind === 'error' ? '⚠' : '';
    div.innerHTML = (icon ? '<span class="an-state-icon">' + icon + '</span>' : '') + '<span>' + text + '</span>';
    container.style.position = 'relative';
    container.appendChild(div);
  }
  function clearState(container) {
    var old = container.querySelector('.an-state-overlay');
    if (old) old.remove();
  }
  function activateRange(group, value, attr) {
    group.querySelectorAll('.tf').forEach(function (b) {
      b.classList.toggle('active', b.getAttribute(attr) === value);
    });
  }
  function downsample(rows, maxPts) {
    if (rows.length <= maxPts || maxPts < 2) return rows;
    var out = [], step = (rows.length - 1) / (maxPts - 1);
    for (var i = 0; i < maxPts; i++) out.push(rows[Math.min(Math.round(i * step), rows.length - 1)]);
    out[out.length - 1] = rows[rows.length - 1];
    return out;
  }

  // ── 1. Equity Curve ───────────────────────────────────────────────────────
  (function setupEquityChart() {
    var container  = document.getElementById('eq-chart');
    var rangeGroup = document.getElementById('eq-range-group');
    var updatedEl  = document.getElementById('eq-updated');
    var chart = null, series = null;

    function initChart() {
      if (chart) { try { chart.remove(); } catch (_) {} chart = null; }
      var opts = baseChartOpts(200);
      opts.rightPriceScale.mode = 0;
      chart  = LC.createChart(container, opts);
      chart.applyOptions({ width: container.clientWidth });
      series = chart.addAreaSeries({
        lineColor: getCssVar('--accent') || '#818CF8', topColor: 'rgba(129,140,248,0.14)',
        bottomColor: 'rgba(129,140,248,0)', lineWidth: 2,
        priceFormat: { type: 'custom', formatter: function (v) { return FMT.usd(v); } },
      });
    }
    async function load(range) {
      clearState(container);
      container.innerHTML = '<div class="an-skel an-state-overlay" style="position:absolute;inset:0"></div>';
      try {
        var resp = await fetch('/api/equity-history?range=' + range);
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        var rows = await resp.json();
        clearState(container);
        container.querySelectorAll('.an-state-overlay').forEach(function (e) { e.remove(); });
        if (!Array.isArray(rows) || rows.length === 0) {
          if (chart) { try { chart.remove(); } catch (_) {} chart = null; }
          showState(container, 'empty', 'No equity history yet. Once the bot starts trading, snapshots appear here (60 s interval).');
          if (updatedEl) updatedEl.textContent = '';
          return;
        }
        if (!chart) initChart();
        var pts = downsample(rows, 500).map(function (r) {
          return { time: Math.floor(r.ts / 1000), value: isFinite(r.equity_usd) ? r.equity_usd : 0 };
        });
        series.setData(pts);
        chart.timeScale().fitContent();
        if (updatedEl) updatedEl.textContent = rows.length + ' pts';
      } catch (e) {
        clearState(container);
        container.querySelectorAll('.an-state-overlay').forEach(function (el) { el.remove(); });
        showState(container, 'error', 'Failed to load equity history: ' + e.message);
      }
    }
    if (rangeGroup) {
      rangeGroup.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-eq]');
        if (!btn) return;
        activateRange(rangeGroup, btn.dataset.eq, 'data-eq');
        load(btn.dataset.eq);
      });
    }
    if (typeof ResizeObserver !== 'undefined' && container) {
      new ResizeObserver(function () {
        if (chart) chart.applyOptions({ width: container.clientWidth });
      }).observe(container);
    }
    load('24h');
  })();

  // ── 2. Funding-rate history ───────────────────────────────────────────────
  (function setupFundingHistory() {
    var container  = document.getElementById('fh-chart');
    var coinSel    = document.getElementById('fh-coin-sel');
    var rangeGroup = document.getElementById('fh-range-group');
    var updatedEl  = document.getElementById('fh-updated');
    var chart = null, hlSeries = null, dydxSeries = null, spreadSeries = null;

    function populateCoinSel(coins) {
      if (!coinSel || !Array.isArray(coins) || !coins.length) return;
      var current = coinSel.value;
      coinSel.innerHTML = coins.map(function (c) {
        return '<option value="' + c.coin + '"' + (c.coin === current ? ' selected' : '') + '>' + c.coin + '</option>';
      }).join('');
    }
    function initChart() {
      if (chart) { try { chart.remove(); } catch (_) {} chart = null; }
      chart = LC.createChart(container, baseChartOpts(180));
      chart.applyOptions({ width: container.clientWidth });
      hlSeries = chart.addLineSeries({
        color: getCssVar('--green') || '#3fb950', lineWidth: 2, title: 'HL',
        priceFormat: { type: 'custom', formatter: function (v) { return FMT.rate(v) || '—'; } },
      });
      dydxSeries = chart.addLineSeries({
        color: getCssVar('--accent') || '#818CF8', lineWidth: 2, title: 'dYdX',
        priceFormat: { type: 'custom', formatter: function (v) { return FMT.rate(v) || '—'; } },
      });
      spreadSeries = chart.addHistogramSeries({
        color: 'rgba(88,166,255,0.18)', priceScaleId: 'spread',
        priceFormat: { type: 'custom', formatter: function (v) { return FMT.spread(v) || '—'; } },
      });
      chart.priceScale('spread').applyOptions({ scaleMargins: { top: 0.8, bottom: 0 } });
    }
    async function load(coin, range) {
      clearState(container);
      container.querySelectorAll('.an-state-overlay').forEach(function (e) { e.remove(); });
      container.insertAdjacentHTML('beforeend', '<div class="an-skel an-state-overlay" style="position:absolute;inset:0"></div>');
      try {
        var resp = await fetch('/api/funding-history?coin=' + encodeURIComponent(coin) + '&range=' + range);
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        var aligned = await resp.json();
        container.querySelectorAll('.an-state-overlay').forEach(function (e) { e.remove(); });
        if (!Array.isArray(aligned) || aligned.length === 0) {
          if (chart) { try { chart.remove(); } catch (_) {} chart = null; }
          showState(container, 'empty', 'No funding rate history for ' + coin + ' yet.');
          if (updatedEl) updatedEl.textContent = '';
          return;
        }
        if (!chart) initChart();
        var toSec = function (b) { return Math.floor(b / 1000); };
        hlSeries.setData(downsample(aligned.filter(function (r) { return r.hl !== null; }), 500)
          .map(function (r) { return { time: toSec(r.ts), value: r.hl }; }));
        dydxSeries.setData(downsample(aligned.filter(function (r) { return r.dydx !== null; }), 500)
          .map(function (r) { return { time: toSec(r.ts), value: r.dydx }; }));
        spreadSeries.setData(downsample(aligned.filter(function (r) { return r.spread !== null; }), 500)
          .map(function (r) { return { time: toSec(r.ts), value: r.spread }; }));
        chart.timeScale().fitContent();
        if (updatedEl) updatedEl.textContent = aligned.length + ' buckets';
      } catch (e) {
        container.querySelectorAll('.an-state-overlay').forEach(function (el) { el.remove(); });
        showState(container, 'error', 'Failed to load funding history: ' + e.message);
      }
    }
    function currentCoin()  { return coinSel  ? coinSel.value  : 'HYPE'; }
    function currentRange() {
      var active = rangeGroup ? rangeGroup.querySelector('.tf.active') : null;
      return active ? active.dataset.fh : '24h';
    }
    if (coinSel)    coinSel.addEventListener('change', function () { load(currentCoin(), currentRange()); });
    if (rangeGroup) rangeGroup.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-fh]');
      if (!btn) return;
      activateRange(rangeGroup, btn.dataset.fh, 'data-fh');
      load(currentCoin(), currentRange());
    });
    if (typeof ResizeObserver !== 'undefined' && container) {
      new ResizeObserver(function () {
        if (chart) chart.applyOptions({ width: container.clientWidth });
      }).observe(container);
    }
    fetch('/api/funding-matrix')
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (data && Array.isArray(data.coins) && data.coins.length > 0) populateCoinSel(data.coins);
      })
      .catch(function () {});
    load('HYPE', '24h');
  })();

})();
</script>

<!-- ── Events log with level/module filter + consecutive dedup ── -->
<script>
(function () {
  'use strict';

  /* Active filter state */
  var activeLevels = new Set(['warn', 'error']);
  var activeModule = '';

  /* Collect known modules to populate the select */
  var knownModules = new Set();

  var badgeClass = { info: 'badge-info', warn: 'badge-warn', error: 'badge-error', debug: 'badge-info' };

  /* ── Module select ── */
  var modSel = document.getElementById('ev-mod-select');

  /* ── Level buttons ── */
  document.querySelectorAll('.ev-level-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var lv = btn.getAttribute('data-level');
      if (activeLevels.has(lv)) activeLevels.delete(lv);
      else                       activeLevels.add(lv);
      btn.classList.toggle('active', activeLevels.has(lv));
      fetchEvents();
    });
  });

  if (modSel) {
    modSel.addEventListener('change', function () {
      activeModule = modSel.value;
      fetchEvents();
    });
  }

  /* ── Fetch ── */
  async function fetchEvents() {
    var levels = Array.from(activeLevels).join(',');
    var url = '/api/events' + (levels ? '?level=' + encodeURIComponent(levels) : '');
    if (activeModule) url += (levels ? '&' : '?') + 'module=' + encodeURIComponent(activeModule);
    try {
      var events = await fetch(url).then(function (r) { return r.json(); });
      updateModuleSelect(events);
      renderEvents(events);
    } catch (_) {}
  }

  /* ── Populate module dropdown from seen events ── */
  function updateModuleSelect(events) {
    if (!modSel) return;
    var changed = false;
    events.forEach(function (ev) {
      if (ev.module && !knownModules.has(ev.module)) {
        knownModules.add(ev.module);
        changed = true;
      }
    });
    if (!changed) return;
    var current = modSel.value;
    var opts = '<option value="">All</option>';
    Array.from(knownModules).sort().forEach(function (m) {
      opts += '<option value="' + m + '"' + (m === current ? ' selected' : '') + '>' + m + '</option>';
    });
    modSel.innerHTML = opts;
  }

  /* ── Dedup consecutive same-message rows ── */
  function dedupEvents(events) {
    var out = [];
    for (var i = 0; i < events.length; i++) {
      var ev = events[i];
      var last = out.length > 0 ? out[out.length - 1] : null;
      if (last && last._ev.message === ev.message && last._ev.module === ev.module && last._ev.level === ev.level) {
        last._count++;
      } else {
        out.push({ _ev: ev, _count: 1 });
      }
    }
    return out;
  }

  /* ── Render ── */
  function renderEvents(events) {
    var tbody = document.getElementById('events-tbody');
    if (!tbody) return;
    if (events.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" style="padding:1.5rem;text-align:center;color:var(--muted);font-size:13px">' +
        (activeLevels.size === 0 ? 'No levels selected.' : 'No matching events.') + '</td></tr>';
      return;
    }
    var deduped = dedupEvents(events);
    tbody.innerHTML = deduped.map(function (row) {
      var ev = row._ev;
      var countBadge = row._count > 1
        ? '<span class="ev-count">×' + row._count + '</span>' : '';
      return '<tr>' +
        '<td class="mono text-muted" style="white-space:nowrap;padding:4px 8px;font-size:11px">' + ev.created_at + '</td>' +
        '<td style="padding:4px 8px;font-size:12px">' + (ev.module || '') + '</td>' +
        '<td style="padding:4px 8px"><span class="badge ' + (badgeClass[ev.level] || 'badge-info') + '">' + ev.level + '</span></td>' +
        '<td style="padding:4px 8px;font-size:12px">' + ev.message + countBadge + '</td>' +
        '</tr>';
    }).join('');
  }

  fetchEvents();
  setInterval(fetchEvents, 10000);

})();
</script>
</body>
