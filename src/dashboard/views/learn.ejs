<%- include('_head', { title: 'Learn' }) %>

<style>
  .learn-container {
    max-width: 780px;
    margin: 0 auto;
    padding: var(--sp-6);
  }

  .learn-header { margin-bottom: var(--sp-6); }
  .learn-header p { color: var(--muted); font-size: var(--t-body); line-height: 1.6; }

  .section-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: var(--sp-6) 0;
  }

  /* ── Strategy cards ─────────────────────────────────────────── */
  .strat-card {
    background: var(--surface);
    border-radius: 8px;
    margin-bottom: var(--sp-5);
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }
  .strat-card-header {
    padding: var(--sp-4) var(--sp-5) var(--sp-3);
    border-bottom: 1px solid var(--border);
    display: flex; align-items: baseline;
    gap: var(--sp-2); flex-wrap: wrap;
  }
  .strat-card-header h2 { font-size: var(--t-body); font-weight: 600; letter-spacing: -.01em; margin: 0; }
  .strat-category {
    font-size: var(--t-label); font-weight: 600; color: var(--muted);
    text-transform: uppercase; letter-spacing: .05em;
    padding: 2px var(--sp-2); border: 1px solid var(--border); border-radius: 20px;
  }
  .badge-planned {
    font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em;
    padding: 2px var(--sp-2); border-radius: 20px;
    color: #f0883e; border: 1px solid rgba(240,136,62,0.4); background: rgba(240,136,62,0.07);
  }

  .strat-summary {
    padding: var(--sp-3) var(--sp-5); font-size: var(--t-body); color: var(--muted);
    border-bottom: 1px solid var(--border); line-height: 1.6;
  }
  .strat-body { padding: var(--sp-4) var(--sp-5); display: grid; gap: var(--sp-4); }

  .strat-section-label {
    font-size: var(--t-label); font-weight: 700; text-transform: uppercase;
    letter-spacing: .07em; color: var(--muted); margin-bottom: var(--sp-1);
  }
  .strat-section-text { font-size: var(--t-body); line-height: 1.7; color: var(--text); }

  .signal-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--sp-1); }
  .signal-list li {
    font-size: var(--t-body); color: var(--text); padding: var(--sp-1) var(--sp-2);
    background: var(--accent-dim); border-left: 2px solid var(--accent); border-radius: 0 3px 3px 0;
  }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); }
  .condition-box { padding: var(--sp-3) var(--sp-4); border-radius: 6px; font-size: var(--t-body); line-height: 1.6; }
  .condition-box.works   { background: rgba(63,185,80,0.07);  border: 1px solid rgba(63,185,80,0.2); }
  .condition-box.struggles { background: rgba(248,81,73,0.07); border: 1px solid rgba(248,81,73,0.2); }
  .condition-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; margin-bottom: var(--sp-1); }
  .condition-box.works     .condition-label { color: var(--green); }
  .condition-box.struggles .condition-label { color: var(--red); }

  .param-list { display: flex; flex-direction: column; gap: var(--sp-1); }
  .param-row {
    display: flex; align-items: baseline; gap: var(--sp-3); font-size: var(--t-body);
    padding: var(--sp-1) 0; border-bottom: 1px solid var(--border);
  }
  .param-row:last-child { border-bottom: none; }
  .param-label { flex: 1; color: var(--text); }
  .param-default { font-size: var(--t-label); color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .param-range  { font-size: var(--t-label); color: var(--muted); white-space: nowrap; }
  .param-none   { font-size: var(--t-body); color: var(--muted); font-style: italic; }

  /* ── Indicator accordion ────────────────────────────────────── */
  .ind-toolbar {
    display: flex; align-items: center; gap: var(--sp-3);
    margin-bottom: var(--sp-5); flex-wrap: wrap;
  }
  .ind-search {
    flex: 1; min-width: 160px;
    background: var(--bg); border: 1px solid var(--border);
    color: var(--text); font-size: var(--t-body); font-family: inherit;
    padding: var(--sp-2) var(--sp-3); border-radius: 4px;
  }
  .ind-search:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-dim); }
  .ind-search::placeholder { color: var(--muted); }
  .ind-ctrl-btn {
    background: var(--surface); border: 1px solid var(--border); color: var(--text);
    font-size: var(--t-label); font-weight: 600; font-family: inherit;
    padding: var(--sp-1) var(--sp-3); border-radius: 4px;
    cursor: pointer; white-space: nowrap; transition: border-color .15s, color .15s;
  }
  .ind-ctrl-btn:hover { border-color: var(--accent); color: var(--accent); }

  .ind-group { margin-bottom: var(--sp-5); }
  .ind-group[hidden] { display: none; }

  .ind-group-label {
    font-size: var(--t-label); font-weight: 700; text-transform: uppercase;
    letter-spacing: .07em; color: var(--muted);
    padding-bottom: var(--sp-2); margin-bottom: var(--sp-2);
    border-bottom: 1px solid var(--border);
  }

  .ind-item {
    border-radius: 6px;
    margin-bottom: var(--sp-1); background: var(--surface); overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,0.2);
  }
  .ind-item[hidden] { display: none; }

  .ind-item-hdr {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-3); cursor: pointer; user-select: none;
    transition: background .1s;
  }
  .ind-item-hdr:hover { background: var(--surface2); }
  .ind-item-name { flex: 1; font-size: var(--t-body); font-weight: 600; }
  .ind-item-cat {
    font-size: 10px; font-weight: 600; color: var(--muted);
    text-transform: uppercase; letter-spacing: .04em;
    padding: 2px var(--sp-2); border: 1px solid var(--border); border-radius: 20px;
  }
  .ind-item-chevron {
    font-size: 9px; color: var(--muted); flex-shrink: 0;
    transition: transform 0.15s; line-height: 1;
  }
  .ind-item.open .ind-item-chevron { transform: rotate(90deg); }

  .ind-item-body {
    border-top: 1px solid var(--border);
    padding: var(--sp-4);
    display: none; grid-template-columns: 1fr; gap: var(--sp-3);
  }
  .ind-item.open .ind-item-body { display: grid; }

  .ind-example {
    font-family: 'SFMono-Regular', Consolas, monospace; font-size: var(--t-label);
    background: var(--surface2); padding: var(--sp-2) var(--sp-3);
    border-radius: 4px; border: 1px solid var(--border);
    color: var(--text); word-break: break-all;
  }

  @media (max-width: 600px) {
    .two-col { grid-template-columns: 1fr; }
    .learn-container { padding: var(--sp-4) var(--sp-3); }
  }
</style>

<%- include('_nav') %>

<div class="learn-container">

  <!-- ═══════════════════════════════════════════════════════════
       STRATEGIES
  ════════════════════════════════════════════════════════════ -->
  <div class="learn-header">
    <h1 class="page-title">Strategies</h1>
    <p>How each strategy works, what it trades on, and what market conditions it is suited to.</p>
  </div>

  <!-- ── Runnable strategies (from registry) ── -->
  <% for (const entry of registry.filter(e => e.isCandleStrategy)) { %>
  <div class="strat-card">
    <div class="strat-card-header">
      <h2><%= entry.displayName %></h2>
      <span class="strat-category"><%= entry.categoryLabel %></span>
    </div>
    <div class="strat-summary"><%= entry.summary %></div>
    <div class="strat-body">
      <div>
        <div class="strat-section-label">How it works</div>
        <div class="strat-section-text"><%= entry.howItWorks %></div>
      </div>
      <div>
        <div class="strat-section-label">Signals it uses</div>
        <ul class="signal-list">
          <% for (const sig of entry.signals) { %><li><%= sig %></li><% } %>
        </ul>
      </div>
      <div class="two-col">
        <div class="condition-box works">
          <div class="condition-label">When it tends to work</div>
          <%= entry.whenItWorks %>
        </div>
        <div class="condition-box struggles">
          <div class="condition-label">When it tends to struggle</div>
          <%= entry.whenItStruggles %>
        </div>
      </div>
      <div>
        <div class="strat-section-label">Parameters</div>
        <% if (entry.params.length > 0) { %>
        <div class="param-list">
          <% for (const p of entry.params) { %>
          <div class="param-row">
            <span class="param-label"><%= p.label %></span>
            <span class="param-default">default: <%= p.default %></span>
            <span class="param-range"><%= p.min %> – <%= p.max %></span>
          </div>
          <% } %>
        </div>
        <% } else { %>
        <span class="param-none">No configurable parameters — values are fixed in the implementation.</span>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ── Planned strategies (display-only, NOT in registry) ── -->

  <div class="strat-card">
    <div class="strat-card-header">
      <h2>Volatility Regime Switching</h2>
      <span class="strat-category">Adaptive (regime-aware)</span>
      <span class="badge-planned">Planned — not yet implemented</span>
    </div>
    <div class="strat-summary">Switches between mean-reversion and trend-following based on the current volatility regime.</div>
    <div class="strat-body">
      <div>
        <div class="strat-section-label">How it works</div>
        <div class="strat-section-text">It measures realised volatility on a rolling window and compares to a 30-day baseline. In low-vol periods (range-bound markets), it allocates more capital to mean-reversion logic; in high-vol periods (trending markets), it shifts to trend-following. Rather than a binary regime toggle, the allocation is weighted continuously by the volatility percentile, avoiding whipsaws at regime boundaries.</div>
      </div>
      <div>
        <div class="strat-section-label">Signals it uses</div>
        <ul class="signal-list">
          <li>Realised volatility (rolling window vs 30-day baseline)</li>
          <li>ATR (regime weighting)</li>
          <li>Underlying mean-reversion signals</li>
          <li>Underlying trend-following signals</li>
        </ul>
      </div>
      <div class="two-col">
        <div class="condition-box works">
          <div class="condition-label">When it tends to work</div>
          When the market clearly alternates between regimes over the holding window.
        </div>
        <div class="condition-box struggles">
          <div class="condition-label">When it tends to struggle</div>
          In transitional regimes where vol is changing rapidly.
        </div>
      </div>
      <div>
        <div class="strat-section-label">Parameters</div>
        <div class="param-list">
          <div class="param-row"><span class="param-label">Vol lookback period</span><span class="param-default">—</span></div>
          <div class="param-row"><span class="param-label">Regime weighting curve</span><span class="param-default">—</span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="strat-card">
    <div class="strat-card-header">
      <h2>Liquidation Cascade Fade</h2>
      <span class="strat-category">Microstructure (counter-trend)</span>
      <span class="badge-planned">Planned — not yet implemented</span>
    </div>
    <div class="strat-summary">Trades against forced-liquidation cascades after they begin to exhaust.</div>
    <div class="strat-body">
      <div>
        <div class="strat-section-label">How it works</div>
        <div class="strat-section-text">When Hyperliquid's liquidation volume spikes far above its rolling baseline, the strategy waits for the first candle close that prints opposite the cascade direction (a confirmation candle), then enters a counter-trend position with a tight stop. The confirmation filter sacrifices the first part of the bounce in exchange for not catching falling knives mid-cascade.</div>
      </div>
      <div>
        <div class="strat-section-label">Signals it uses</div>
        <ul class="signal-list">
          <li>Liquidation USD volume vs rolling baseline</li>
          <li>Candle direction (confirmation filter)</li>
        </ul>
      </div>
      <div class="two-col">
        <div class="condition-box works">
          <div class="condition-label">When it tends to work</div>
          During sharp cascade events that overshoot fair value and snap back.
        </div>
        <div class="condition-box struggles">
          <div class="condition-label">When it tends to struggle</div>
          In extended grinding moves where no single cascade resolves cleanly.
        </div>
      </div>
      <div>
        <div class="strat-section-label">Parameters</div>
        <div class="param-list">
          <div class="param-row"><span class="param-label">Spike threshold (× baseline)</span><span class="param-default">—</span></div>
          <div class="param-row"><span class="param-label">Baseline window</span><span class="param-default">—</span></div>
          <div class="param-row"><span class="param-label">Stop distance</span><span class="param-default">—</span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="strat-card">
    <div class="strat-card-header">
      <h2>Funding Deviation (Predicted vs Actual)</h2>
      <span class="strat-category">Positioning flow (rare metric)</span>
      <span class="badge-planned">Planned — not yet implemented</span>
    </div>
    <div class="strat-summary">Trades against positioning shifts revealed when actual funding diverges from Hyperliquid's predicted rate.</div>
    <div class="strat-body">
      <div>
        <div class="strat-section-label">How it works</div>
        <div class="strat-section-text">Hyperliquid publishes both the current funding rate and a predicted next rate. Persistent positive deviation (actual exceeds predicted) signals fresh long crowding — historically a precursor to reversals. Negative deviation signals short crowding. The raw deviation is normalised as a 7-day z-score so the signal is scale-invariant across calm and volatile funding regimes.</div>
      </div>
      <div>
        <div class="strat-section-label">Signals it uses</div>
        <ul class="signal-list">
          <li>Actual funding rate</li>
          <li>Predicted funding rate (next period)</li>
          <li>7-day rolling mean and std of the gap (z-score)</li>
        </ul>
      </div>
      <div class="two-col">
        <div class="condition-box works">
          <div class="condition-label">When it tends to work</div>
          When positioning is shifting fast and the market hasn't priced it in.
        </div>
        <div class="condition-box struggles">
          <div class="condition-label">When it tends to struggle</div>
          During sustained directional funding regimes where deviation is small but persistent.
        </div>
      </div>
      <div>
        <div class="strat-section-label">Parameters</div>
        <div class="param-list">
          <div class="param-row"><span class="param-label">Z-score window</span><span class="param-default">—</span></div>
          <div class="param-row"><span class="param-label">Entry threshold (z-score)</span><span class="param-default">—</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       INDICATOR LIBRARY
  ════════════════════════════════════════════════════════════ -->
  <hr class="section-divider">

  <div class="learn-header">
    <h1 class="page-title">Indicator Library</h1>
    <p>All 20 indicators available in the Strategy Builder. Click any row to expand details.</p>
  </div>

  <!-- Toolbar: search + expand/collapse -->
  <div class="ind-toolbar">
    <input type="text" id="ind-search" class="ind-search" placeholder="Search indicators…" autocomplete="off">
    <button class="ind-ctrl-btn" id="ind-expand-all">Expand all</button>
    <button class="ind-ctrl-btn" id="ind-collapse-all">Collapse all</button>
  </div>

  <!-- Grouped accordion — server-side rendered -->
  <%
    const IND_CATS = ['Momentum', 'Trend', 'Volatility', 'Volume'];
    for (const cat of IND_CATS) {
      const catInds = indicators.filter(m => m.category === cat);
      if (!catInds.length) continue;
  %>
  <div class="ind-group" data-cat="<%= cat %>">
    <div class="ind-group-label"><%= cat %></div>

    <% for (const m of catInds) { %>
    <div class="ind-item" data-name="<%= m.displayName.toLowerCase() %>">
      <div class="ind-item-hdr">
        <span class="ind-item-name"><%= m.displayName %></span>
        <span class="ind-item-cat"><%= m.category %></span>
        <span class="ind-item-chevron">&#9658;</span>
      </div>
      <div class="ind-item-body">

        <div>
          <div class="strat-section-label">Description</div>
          <div class="strat-section-text"><%= m.description %></div>
        </div>

        <div>
          <div class="strat-section-label">Common use</div>
          <div class="strat-section-text"><%= m.commonUse %></div>
        </div>

        <div>
          <div class="strat-section-label">Typical parameters</div>
          <div class="strat-section-text"><%= m.typicalParams %></div>
        </div>

        <div>
          <div class="strat-section-label">Example rule</div>
          <div class="ind-example"><%= m.exampleRule %></div>
        </div>

        <% if (m.defaultParams && m.defaultParams.length > 0) { %>
        <div>
          <div class="strat-section-label">Parameters</div>
          <div class="param-list">
            <% for (const p of m.defaultParams) { %>
            <div class="param-row">
              <span class="param-label"><%= p.label %></span>
              <span class="param-default">default: <%= p.default %></span>
              <span class="param-range"><%= p.min %> – <%= p.max %></span>
            </div>
            <% } %>
          </div>
        </div>
        <% } %>

      </div>
    </div>
    <% } %>

  </div>
  <% } %>

</div><!-- /.learn-container -->

<script>
(function () {
  'use strict';

  // ── Accordion ────────────────────────────────────────────────
  document.querySelectorAll('.ind-item-hdr').forEach(function (hdr) {
    hdr.addEventListener('click', function () {
      hdr.closest('.ind-item').classList.toggle('open');
    });
  });

  // ── Expand / Collapse all ────────────────────────────────────
  document.getElementById('ind-expand-all').addEventListener('click', function () {
    document.querySelectorAll('.ind-item:not([hidden])').forEach(function (el) {
      el.classList.add('open');
    });
  });
  document.getElementById('ind-collapse-all').addEventListener('click', function () {
    document.querySelectorAll('.ind-item').forEach(function (el) {
      el.classList.remove('open');
    });
  });

  // ── Live search ──────────────────────────────────────────────
  document.getElementById('ind-search').addEventListener('input', function () {
    var q = this.value.trim().toLowerCase();

    document.querySelectorAll('.ind-item').forEach(function (el) {
      var match = !q || el.dataset.name.includes(q);
      el.hidden = !match;
      // Auto-expand single exact-ish match; collapse when clearing
      if (match && q) el.classList.add('open');
    });

    // Hide group headers when all their items are hidden
    document.querySelectorAll('.ind-group').forEach(function (grp) {
      var anyVisible = grp.querySelector('.ind-item:not([hidden])');
      grp.hidden = !anyVisible;
    });
  });
})();
</script>

</body>
</html>
