<%- include('_head', { title: 'Backtest' }) %>
<style>
  .backtest-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .backtest-controls label { font-size: 12px; color: var(--muted); margin-right: 2px; }
  .backtest-controls select {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 12px;
    padding: 5px 8px;
    border-radius: 4px;
    cursor: pointer;
  }
  .btn-run {
    background: var(--blue);
    color: #fff;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity .15s;
  }
  .btn-run:disabled { opacity: 0.5; cursor: default; }
  .btn-run:hover:not(:disabled) { opacity: 0.85; }
  .backtest-status { font-size: 12px; color: var(--muted); margin-left: 0.5rem; }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .chart-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  .chart-toolbar {
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
  }
  #bt-equity-chart { height: 250px; }

  .pnl-pos { color: var(--green); }
  .pnl-neg { color: var(--red); }

  /* ── Comparison table ── */
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .compare-table th {
    padding: 7px 12px;
    text-align: right;
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .compare-table th:first-child { text-align: left; }
  .compare-table td {
    padding: 9px 12px;
    text-align: right;
    font-family: 'SFMono-Regular', Consolas, monospace;
    font-variant-numeric: tabular-nums;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .compare-table td:first-child {
    text-align: left;
    font-family: inherit;
    font-weight: 500;
  }
  .compare-table tbody tr.row-beats { background: rgba(63,185,80,0.07); }
  .compare-table tbody tr.row-lags  { background: rgba(248,81,73,0.07); }
  .compare-table tbody tr:last-child td { border-bottom: none; }

  /* ── Chart legend ── */
  .chart-legend { display: flex; gap: 1rem; font-size: 11px; color: var(--muted); }
  .chart-legend-item { display: flex; align-items: center; gap: 5px; }
  .legend-line { display: inline-block; width: 16px; height: 2px; border-radius: 1px; }
  .legend-line-dashed { border-top: 2px dashed; height: 0; border-radius: 0; }
</style>

<nav class="nav">
  <a href="/" class="nav-brand">HL Bot</a>
  <button class="hamburger" id="nav-hamburger" aria-label="Menu">&#9776;</button>
  <div class="nav-links" id="nav-links">
    <a href="/" class="nav-link">Overview</a>
    <a href="/strategies" class="nav-link">Strategies</a>
    <a href="/trades" class="nav-link">Trades</a>
    <a href="/backtest" class="nav-link active">Backtest</a>
  </div>
  <div class="nav-right">
    <span class="badge badge-net"><%= network %></span>
    <span class="text-muted"><%= coin %></span>
    <button class="theme-btn" id="theme-toggle" title="Toggle theme">&#9790;</button>
  </div>
</nav>

<div class="container">

  <div class="backtest-controls">
    <div>
      <label>Interval</label>
      <select id="bt-interval">
        <option value="1m">1m</option>
        <option value="5m">5m</option>
        <option value="15m">15m</option>
        <option value="1h" selected>1h</option>
        <option value="4h">4h</option>
        <option value="1d">1d</option>
      </select>
    </div>
    <div>
      <label>Candles</label>
      <select id="bt-limit">
        <option value="500">500</option>
        <option value="1000" selected>1000</option>
        <option value="2000">2000</option>
      </select>
    </div>
    <button class="btn-run" id="bt-run">Run Backtest</button>
    <span class="backtest-status" id="bt-status"></span>
  </div>

  <!-- "Number to beat" banner — hidden until first run -->
  <div id="bt-bh-banner" style="display:none;margin-bottom:1.5rem">
    <div class="card" style="display:flex;align-items:stretch;gap:0;padding:0;overflow:hidden">
      <div style="padding:0.75rem 1.25rem;border-right:1px solid var(--border);min-width:200px">
        <div class="card-label" style="color:var(--muted)">Number to beat &ensp;<span style="color:var(--muted);font-weight:400;text-transform:none;letter-spacing:0;font-size:10px">buy &amp; hold</span></div>
        <div class="card-value mono" style="font-size:1.8rem;line-height:1.1;margin-top:4px" id="bt-bh-return">—</div>
      </div>
      <div style="padding:0.75rem 1.25rem;border-right:1px solid var(--border)">
        <div class="card-label">B&amp;H Max Drawdown</div>
        <div class="card-value mono" style="font-size:1.1rem" id="bt-bh-dd">—</div>
      </div>
      <div style="padding:0.75rem 1.25rem">
        <div class="card-label">Strategy vs. B&amp;H</div>
        <div class="card-value mono" style="font-size:1.1rem" id="bt-bh-vs">—</div>
      </div>
    </div>
  </div>

  <!-- Per-strategy stats — hidden until first run, populated by JS -->
  <div id="bt-stats" style="display:none"></div>

  <!-- Equity chart -->
  <div class="chart-panel" id="bt-chart-panel" style="display:none">
    <div class="chart-toolbar" style="display:flex;align-items:center;justify-content:space-between">
      <span>Equity Curve</span>
      <div class="chart-legend" id="bt-chart-legend">
        <div class="chart-legend-item">
          <span class="legend-line" style="background:#58a6ff"></span>Confluence
        </div>
        <div class="chart-legend-item">
          <span class="legend-line" style="background:#b197fc"></span>Trend Follow
        </div>
        <div class="chart-legend-item">
          <span class="legend-line legend-line-dashed" style="border-color:rgba(210,153,34,0.7);width:18px"></span>Buy &amp; Hold
        </div>
      </div>
    </div>
    <div id="bt-equity-chart"></div>
  </div>

  <!-- Trades tables — populated by JS -->
  <div id="bt-trades-section" style="display:none"></div>

</div>

<script src="https://unpkg.com/lightweight-charts@4/dist/lightweight-charts.standalone.production.js"></script>
<script>
(function () {
  const LC = LightweightCharts;

  const STRAT_COLORS = [
    { line: '#58a6ff', top: 'rgba(88,166,255,0.18)', bottom: 'rgba(88,166,255,0)' },
    { line: '#b197fc', top: 'rgba(177,151,252,0.15)', bottom: 'rgba(177,151,252,0)' },
  ];
  const STRAT_NAMES = { 'confluence': 'Confluence', 'trend-follow': 'Trend Follow' };

  let equityChart = null;
  let stratSeries = [];
  let bhSeries    = null;

  function getCssVar(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }

  function initChart() {
    if (equityChart) return;
    const border = getCssVar('--border') || '#30363d';
    equityChart = LC.createChart(document.getElementById('bt-equity-chart'), {
      layout: {
        background: { type: 'solid', color: getCssVar('--surface') || '#161b22' },
        textColor:  getCssVar('--muted')  || '#8b949e',
        attributionLogo: false,
      },
      grid: {
        vertLines: { color: border },
        horzLines: { color: border },
      },
      crosshair: { mode: 1 },
      rightPriceScale: { borderColor: border },
      timeScale: { borderColor: border, timeVisible: true },
      height: 250,
    });
    // Buy-and-hold benchmark — drawn first so it sits behind strategy curves
    bhSeries = equityChart.addLineSeries({
      color:            'rgba(210,153,34,0.55)',
      lineWidth:        1,
      lineStyle:        2,
      lastValueVisible: false,
      priceLineVisible: false,
      priceFormat: { type: 'price', precision: 2, minMove: 0.01 },
    });
    // One area series per strategy (pre-create enough slots)
    stratSeries = STRAT_COLORS.map((c) => equityChart.addAreaSeries({
      lineColor:   c.line,
      topColor:    c.top,
      bottomColor: c.bottom,
      lineWidth:   1,
      priceFormat: { type: 'price', precision: 2, minMove: 0.01 },
    }));
    if (typeof ResizeObserver !== 'undefined') {
      const ro = new ResizeObserver(() => equityChart.applyOptions({ width: 0 }));
      ro.observe(document.getElementById('bt-chart-panel'));
    }
  }

  function fmtTime(ms) {
    return new Date(ms).toLocaleString();
  }

  function fmtPnl(pnl) {
    const sign  = pnl >= 0 ? '+' : '';
    const cls   = pnl >= 0 ? 'pnl-pos' : 'pnl-neg';
    return '<span class="' + cls + '">' + sign + '$' + Math.abs(pnl).toFixed(2) + '</span>';
  }

  document.getElementById('bt-run').addEventListener('click', async () => {
    const btn      = document.getElementById('bt-run');
    const status   = document.getElementById('bt-status');
    const interval = document.getElementById('bt-interval').value;
    const limit    = document.getElementById('bt-limit').value;

    btn.disabled = true;
    status.textContent = 'Fetching candles & running…';

    try {
      const res  = await fetch('/api/backtest?interval=' + interval + '&limit=' + limit);
      const data = await res.json();

      if (data.error) { status.textContent = 'Error: ' + data.error; return; }

      const results = data.results || [{ name: data.name || 'strategy', ...data }];
      status.textContent = data.fetchedCandles + ' candles · ' + interval;

      // ── "Number to beat" banner (buy-and-hold from first result) ──────────
      const bh = results[0].buyHold;
      document.getElementById('bt-bh-banner').style.display = '';
      const bhSign = bh.returnPct >= 0 ? '+' : '';
      const bhCls  = bh.returnPct >= 0 ? 'pnl-pos' : 'pnl-neg';
      document.getElementById('bt-bh-return').innerHTML =
        '<span class="' + bhCls + '">' + bhSign + bh.returnPct.toFixed(2) + '%</span>';
      document.getElementById('bt-bh-dd').innerHTML =
        '<span class="pnl-neg">' + bh.maxDrawdownPct.toFixed(2) + '%</span>';
      // Compare best-performing strategy vs benchmark
      const bestReturnPct = Math.max(...results.map((r) => (r.totalPnl / 1000) * 100));
      const diff = bestReturnPct - bh.returnPct;
      const diffSign = diff >= 0 ? '+' : '';
      const diffCls  = diff >= 0 ? 'pnl-pos' : 'pnl-neg';
      document.getElementById('bt-bh-vs').innerHTML =
        '<span class="' + diffCls + '">' + diffSign + diff.toFixed(2) + '%</span>' +
        '<span class="text-muted" style="font-size:11px"> best strategy vs benchmark</span>';

      // ── Comparison table ──────────────────────────────────────────────────
      const bhReturnPct = bh.returnPct;
      const statsEl = document.getElementById('bt-stats');
      statsEl.style.display = '';

      const bhSign2 = bhReturnPct >= 0 ? '+' : '';
      const thead = '<thead><tr>' +
        '<th>Strategy</th><th>Return %</th><th>Buy&amp;Hold %</th>' +
        '<th>Sharpe</th><th>Max DD %</th><th>Profit Factor</th>' +
        '<th>Trades</th><th>Win Rate</th>' +
        '</tr></thead>';

      const tbody = '<tbody>' + results.map((r, i) => {
        const retPct = (r.totalPnl / 1000) * 100;
        const beats  = retPct > bhReturnPct;
        const retCls = retPct >= 0 ? 'pnl-pos' : 'pnl-neg';
        const bhCls2 = bhReturnPct >= 0 ? 'pnl-pos' : 'pnl-neg';
        const dot    = (STRAT_COLORS[i] || STRAT_COLORS[0]).line;
        const label  = '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;' +
                       'background:' + dot + ';margin-right:7px;vertical-align:middle"></span>' +
                       (STRAT_NAMES[r.name] || r.name);
        return '<tr class="' + (beats ? 'row-beats' : 'row-lags') + '">' +
          '<td>' + label + '</td>' +
          '<td><span class="' + retCls + '">' + (retPct >= 0 ? '+' : '') + retPct.toFixed(2) + '%</span></td>' +
          '<td><span class="' + bhCls2 + '">' + bhSign2 + bhReturnPct.toFixed(2) + '%</span></td>' +
          '<td>' + r.sharpeRatio.toFixed(2) + '</td>' +
          '<td><span class="pnl-neg">' + r.maxDrawdownPct.toFixed(2) + '%</span></td>' +
          '<td>' + (r.profitFactor >= 999 ? '∞' : r.profitFactor.toFixed(2)) + '</td>' +
          '<td>' + r.tradeCount + '</td>' +
          '<td>' + (r.winRate * 100).toFixed(1) + '%</td>' +
          '</tr>';
      }).join('') + '</tbody>';

      statsEl.innerHTML = '<div class="table-wrap" style="margin-bottom:1.5rem">' +
        '<table class="compare-table">' + thead + tbody + '</table></div>';

      // ── Equity chart ──────────────────────────────────────────────────────
      document.getElementById('bt-chart-panel').style.display = '';
      initChart();
      bhSeries.setData(bh.equityCurve.map((p) => ({ time: Math.floor(p.time / 1000), value: p.equity })));
      results.forEach((r, i) => {
        if (stratSeries[i]) {
          stratSeries[i].setData(r.equityCurve.map((p) => ({ time: Math.floor(p.time / 1000), value: p.equity })));
        }
      });
      equityChart.timeScale().fitContent();

      // Regenerate chart legend from actual results
      const legendEl = document.getElementById('bt-chart-legend');
      if (legendEl) {
        legendEl.innerHTML = results.map((r, i) => {
          const c = STRAT_COLORS[i] || STRAT_COLORS[0];
          return '<div class="chart-legend-item">' +
            '<span class="legend-line" style="background:' + c.line + '"></span>' +
            (STRAT_NAMES[r.name] || r.name) +
            '</div>';
        }).join('') +
        '<div class="chart-legend-item">' +
          '<span class="legend-line legend-line-dashed" style="border-color:rgba(210,153,34,0.7);width:18px"></span>' +
          'Buy &amp; Hold' +
        '</div>';
      }

      // ── Trades tables (one per strategy) ─────────────────────────────────
      const tradesSection = document.getElementById('bt-trades-section');
      tradesSection.style.display = '';
      tradesSection.innerHTML = results.map((r, i) => {
        const rows = r.trades.map((t) =>
          '<tr>' +
          '<td class="text-muted">' + (t.index + 1) + '</td>' +
          '<td><span class="badge badge-' + t.side + '">' + t.side.toUpperCase() + '</span></td>' +
          '<td class="mono text-muted" style="white-space:nowrap;font-size:11px">' + fmtTime(t.entryTime) + '</td>' +
          '<td class="mono">$' + t.entryPrice.toFixed(2) + '</td>' +
          '<td class="mono text-muted" style="white-space:nowrap;font-size:11px">' + fmtTime(t.exitTime) + '</td>' +
          '<td class="mono">$' + t.exitPrice.toFixed(2) + '</td>' +
          '<td class="mono text-muted">' + t.size.toFixed(5) + '</td>' +
          '<td class="mono">' + fmtPnl(t.pnl) + '</td>' +
          '<td class="text-muted" style="font-size:12px">' + t.reason + '</td>' +
          '</tr>'
        ).join('');
        const dot   = (STRAT_COLORS[i] || STRAT_COLORS[0]).line;
        const label = '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:' + dot + ';margin-right:6px;vertical-align:middle"></span>' + (STRAT_NAMES[r.name] || r.name);
        return '<p class="section-title">' + label + ' — Simulated Trades</p>' +
          '<div class="table-wrap" style="margin-bottom:2rem"><table><thead><tr>' +
          '<th>#</th><th>Side</th><th>Entry Time</th><th>Entry $</th>' +
          '<th>Exit Time</th><th>Exit $</th><th>Size</th><th>P&amp;L</th><th>Reason</th>' +
          '</tr></thead><tbody>' + rows + '</tbody></table></div>';
      }).join('');
    } catch (e) {
      status.textContent = 'Error: ' + e.message;
    } finally {
      btn.disabled = false;
    }
  });


})();
</script>
</body>
</html>
