<%
  var _p   = locals.pillar      || 'bot';
  var _cp  = locals.currentPath || '/';
  var _net = locals.network     || '';

  var _inPulse    = _cp === '/' || _cp === '/bots' || _cp === '/funding';
  var _inEvidence = _cp === '/backtest' || _cp === '/builder';
%>
<nav class="nav nav-top">
  <a href="/" class="nav-brand">Howbrook <span class="brand-desc">Quant</span></a>
  <button class="hamburger" id="nav-hamburger" aria-label="Menu">&#9776;</button>
  <div class="nav-links" id="nav-links">
    <a href="/"       class="nav-link<%= _p === 'bot'    ? ' active' : '' %>">Trading Bot</a>
    <a href="/market"  class="nav-link<%= _p === 'market' ? ' active' : '' %>">Market</a>
  </div>
  <div class="nav-right">
    <span class="dot"></span>
    <% if (_net) { %><span class="badge badge-net"><%= _net %></span><% } %>
    <% if (locals.isAdmin) { %><a href="/logout" class="nav-link">Logout</a><% } else if (locals.authConfigured) { %><a href="/login" class="nav-link">Login</a><% } %>
    <button class="theme-btn" id="theme-toggle" title="Toggle theme">&#9790;</button>
  </div>
</nav>
<% if (_p === 'bot' && _cp !== '/login') { %>
<nav class="nav nav-sub nav-groups-row">
  <div class="nav-links">
    <a href="/"         class="nav-link nav-group<%= _inPulse    ? ' active' : '' %>">Pulse</a>
    <a href="/backtest" class="nav-link nav-group<%= _inEvidence ? ' active' : '' %>">Evidence</a>
    <a href="/trades"   class="nav-link nav-group<%= _cp === '/trades'   ? ' active' : '' %>">Track Record</a>
    <a href="/learn"    class="nav-link nav-group<%= _cp === '/learn'    ? ' active' : '' %>">Learn</a>
  </div>
  <a href="/settings" class="nav-link nav-settings<%= _cp === '/settings' ? ' active' : '' %>">Settings</a>
</nav>
<% if (_inPulse) { %>
<nav class="nav nav-sub2">
  <div class="nav-links">
    <a href="/"        class="nav-link<%= _cp === '/'        ? ' active' : '' %>">Overview</a>
    <a href="/bots"    class="nav-link<%= _cp === '/bots'    ? ' active' : '' %>">Bots</a>
    <a href="/funding" class="nav-link<%= _cp === '/funding' ? ' active' : '' %>">Funding</a>
  </div>
</nav>
<% } else if (_inEvidence) { %>
<nav class="nav nav-sub2">
  <div class="nav-links">
    <a href="/backtest" class="nav-link<%= _cp === '/backtest' ? ' active' : '' %>">Backtest</a>
    <a href="/builder"  class="nav-link<%= _cp === '/builder'  ? ' active' : '' %>">Builder</a>
  </div>
</nav>
<% } %>
<% } %>
