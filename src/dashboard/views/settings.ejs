<%- include('_head', { title: 'Settings' }) %>

<style>
  .settings-page {
    max-width: 780px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .settings-hdr { margin-bottom: 2rem; }
  .settings-hdr h1 { font-size: 1.2rem; font-weight: 600; margin-bottom: 0.25rem; }
  .settings-hdr p  { color: var(--muted); font-size: 13px; }

  /* ── Bots table ── */
  .bots-table-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  .bots-table { width: 100%; border-collapse: collapse; }
  .bots-table th {
    font-size: 11px; font-weight: 500; color: var(--muted);
    text-align: left; padding: 0.55rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  .bots-table td {
    padding: 0.6rem 1rem; font-size: 13px;
    border-bottom: 1px solid var(--border); vertical-align: middle;
  }
  .bots-table tbody tr:last-child td { border-bottom: none; }
  .bots-table tbody tr.bot-inactive { opacity: 0.45; }

  .strat-badge {
    display: inline-block; font-size: 10px; padding: 1px 5px;
    border-radius: 3px; margin-left: 5px;
    color: var(--muted); border: 1px solid var(--border);
  }
  .coin-label { font-family: monospace; font-size: 12px; font-weight: 600; }
  .tf-label {
    display: inline-block; font-size: 11px; padding: 1px 6px;
    border: 1px solid var(--border); border-radius: 3px; color: var(--muted);
  }

  /* Toggle */
  .toggle {
    position: relative; width: 36px; height: 20px;
    cursor: pointer; display: inline-block;
  }
  .toggle input { opacity: 0; width: 0; height: 0; position: absolute; }
  .toggle-slider {
    position: absolute; inset: 0;
    background: var(--border); border-radius: 20px; transition: background 0.15s;
  }
  .toggle-slider::after {
    content: ""; position: absolute;
    width: 14px; height: 14px; background: #fff;
    border-radius: 50%; top: 3px; left: 3px; transition: transform 0.15s;
  }
  .toggle input:checked + .toggle-slider { background: var(--blue); }
  .toggle input:checked + .toggle-slider::after { transform: translateX(16px); }
  .toggle input:disabled + .toggle-slider { opacity: 0.4; cursor: default; }
  .toggle-live input:checked + .toggle-slider { background: var(--green); }

  .bots-empty {
    padding: 1.5rem 1rem; text-align: center;
    color: var(--muted); font-size: 13px;
  }

  /* ── Funding basis ── */
  .funding-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.875rem 1.25rem;
    margin-bottom: 1.5rem;
    display: flex; align-items: flex-start; gap: 1rem;
  }
  .funding-info { flex: 1; min-width: 0; }
  .funding-info strong { font-size: 13px; display: block; margin-bottom: 0.2rem; }
  .funding-info p { font-size: 11px; color: var(--muted); margin: 0; line-height: 1.5; }

  /* ── Save row ── */
  .save-row { display: flex; align-items: center; gap: 1rem; }
  .btn-save {
    background: var(--blue); color: #fff; border: none;
    border-radius: 5px; padding: 0.5rem 1.25rem;
    font-size: 13px; font-weight: 500; cursor: pointer;
  }
  .btn-save:hover { opacity: 0.88; }
  .btn-save:disabled { opacity: 0.5; cursor: default; }
  #save-msg { font-size: 12px; color: var(--muted); display: none; }
  #save-msg.ok    { color: var(--green); display: block; }
  #save-msg.error { color: var(--red);   display: block; }
</style>

<nav class="nav">
  <a href="/" class="nav-brand">HL Bot</a>
  <button class="hamburger" id="nav-hamburger" aria-label="Menu">&#9776;</button>
  <div class="nav-links" id="nav-links">
    <a href="/" class="nav-link">Overview</a>
    <a href="/strategies" class="nav-link">Strategies</a>
    <a href="/bots" class="nav-link">Bots</a>
    <a href="/trades" class="nav-link">Trades</a>
    <a href="/backtest" class="nav-link">Backtest</a>
    <a href="/builder" class="nav-link">Builder</a>
    <a href="/learn" class="nav-link">Learn</a>
    <a href="/settings" class="nav-link active">Settings</a>
  </div>
  <div class="nav-right">
    <span class="dot"></span>
    <span class="badge badge-net"><%= network %></span>
    <span class="text-muted"><%= coin %></span>
    <button class="theme-btn" id="theme-toggle" title="Toggle theme">&#9790;</button>
  </div>
</nav>

<div class="settings-page">

  <div class="settings-hdr">
    <h1>Settings</h1>
    <p>Toggle active/live flags for each bot and control global settings. To add or delete bots, use the <a href="/bots" style="color:var(--blue)">Bots page</a>.</p>
  </div>

  <!-- Bots table — active / live toggles only; add/delete on the Bots page -->
  <div class="bots-table-wrap">
    <table class="bots-table">
      <thead>
        <tr>
          <th>Strategy</th>
          <th>Coin</th>
          <th>Timeframe</th>
          <th>Active</th>
          <th title="Live bots place real testnet orders. Max one live bot per coin.">Live</th>
        </tr>
      </thead>
      <tbody id="bots-tbody">
        <tr><td colspan="5" class="bots-empty">Loading…</td></tr>
      </tbody>
    </table>
  </div>

  <!-- Funding basis -->
  <div class="funding-section">
    <div class="funding-info">
      <strong>Funding Basis (paper simulation)</strong>
      <p>Simulates both legs (long spot + short perp). Entry/exit fees deducted; funding rate accrues hourly. Cannot place real orders.</p>
    </div>
    <label class="toggle" title="Enable funding basis simulation">
      <input type="checkbox" id="funding-toggle">
      <span class="toggle-slider"></span>
    </label>
  </div>

  <!-- Save -->
  <div class="save-row">
    <button class="btn-save" id="btn-save">Save changes</button>
    <span id="save-msg"></span>
  </div>

</div>

<script>
(function () {
  'use strict';

  // Server-seeded data (snapshot at page-load time — Save is merge-only so unseen bots are safe)
  const initialBots  = <%- JSON.stringify(botsFile.bots) %>;
  const fundingInit  = <%- JSON.stringify(botsFile.fundingActive ?? false) %>;
  const candleStrats = <%- JSON.stringify(registry.filter(e => e.isCandleStrategy).map(e => ({ id: e.id, displayName: e.displayName, categoryLabel: e.categoryLabel }))) %>;

  // Local copy — only active/live flags are editable here; add/delete on the Bots page
  let bots = initialBots.map(b => Object.assign({}, b));

  const tbody         = document.getElementById('bots-tbody');
  const fundingToggle = document.getElementById('funding-toggle');
  const btnSave       = document.getElementById('btn-save');
  const saveMsg       = document.getElementById('save-msg');

  fundingToggle.checked = fundingInit;

  // ── Helpers ───────────────────────────────────────────────────────────────
  function stratLabel(id) {
    const e = candleStrats.find(s => s.id === id);
    return e ? e.displayName : id;
  }
  function stratCat(id) {
    const e = candleStrats.find(s => s.id === id);
    return e ? e.categoryLabel : '';
  }

  // ── Render table ──────────────────────────────────────────────────────────
  function render() {
    if (!bots.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="bots-empty">No bots — <a href="/bots" style="color:var(--blue)">add one on the Bots page</a>.</td></tr>';
      return;
    }
    tbody.innerHTML = bots.map((bot, idx) => [
      `<tr class="bot-row${bot.active ? '' : ' bot-inactive'}" data-idx="${idx}">`,
        `<td>${stratLabel(bot.strategyId)} <span class="strat-badge">${stratCat(bot.strategyId)}</span></td>`,
        `<td><span class="coin-label">${bot.coin}</span></td>`,
        `<td><span class="tf-label">${bot.timeframe}</span></td>`,
        `<td><label class="toggle"><input type="checkbox" class="chk-active" data-idx="${idx}"${bot.active ? ' checked' : ''}><span class="toggle-slider"></span></label></td>`,
        `<td><label class="toggle toggle-live"><input type="checkbox" class="chk-live" data-idx="${idx}"${bot.live && bot.active ? ' checked' : ''}${!bot.active ? ' disabled' : ''}><span class="toggle-slider"></span></label></td>`,
      '</tr>',
    ].join('')).join('');

    tbody.querySelectorAll('.chk-active').forEach(chk => {
      chk.addEventListener('change', function () {
        const i = +this.dataset.idx;
        bots[i].active = this.checked;
        if (!this.checked) bots[i].live = false;
        render();
      });
    });
    tbody.querySelectorAll('.chk-live').forEach(chk => {
      chk.addEventListener('change', function () {
        bots[+this.dataset.idx].live = this.checked;
      });
    });
  }

  // ── Validate ─────────────────────────────────────────────────────────────
  function validate() {
    const counts = {};
    for (const bot of bots) {
      if (bot.active && bot.live) {
        counts[bot.coin] = (counts[bot.coin] || 0) + 1;
        if (counts[bot.coin] > 1) return `Coin ${bot.coin} has ${counts[bot.coin]} live bots (max 1 per coin)`;
      }
    }
    return null;
  }

  // ── Save — sends the active/live changes for known bots + fundingActive.
  //    The server merges with any bots added after this page loaded (addBot API),
  //    so they are never lost.
  btnSave.addEventListener('click', async function () {
    const err = validate();
    if (err) {
      saveMsg.className = 'error';
      saveMsg.textContent = err;
      saveMsg.style.display = 'block';
      setTimeout(() => { saveMsg.className = ''; saveMsg.style.display = 'none'; }, 5000);
      return;
    }
    btnSave.disabled = true;
    saveMsg.className = '';
    saveMsg.textContent = 'Saving…';
    saveMsg.style.display = 'block';
    try {
      const resp = await fetch('/api/bots/config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bots, fundingActive: fundingToggle.checked }),
      });
      const data = await resp.json();
      if (!resp.ok) throw new Error(data.error || resp.statusText);
      saveMsg.className = 'ok';
      saveMsg.textContent = 'Saved';
    } catch (e) {
      saveMsg.className = 'error';
      saveMsg.textContent = e.message;
    } finally {
      btnSave.disabled = false;
      setTimeout(() => { saveMsg.className = ''; saveMsg.style.display = 'none'; }, 4000);
    }
  });

  render();
})();
</script>

</body>
</html>
