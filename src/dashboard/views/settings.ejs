<%- include('_head', { title: 'Settings' }) %>

<style>
  .settings-page {
    max-width: 780px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .settings-hdr { margin-bottom: 2rem; }
  .settings-hdr h1 { font-size: 1.2rem; font-weight: 600; margin-bottom: 0.25rem; }
  .settings-hdr p  { color: var(--muted); font-size: 13px; line-height: 1.6; }

  .settings-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 1.5rem;
    overflow: hidden;
  }
  .section-header {
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; gap: 0.75rem;
  }
  .section-header h2 {
    font-size: 13px; font-weight: 600; margin: 0; flex: 1;
  }
  .section-body { padding: 1rem 1.25rem; }

  .setting-row {
    display: flex; align-items: center; gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
  }
  .setting-row:last-child { border-bottom: none; }
  .setting-lbl { flex: 1; color: var(--text); }
  .setting-sub { font-size: 11px; color: var(--muted); margin-top: 1px; }
  .setting-val { color: var(--muted); font-size: 13px; font-family: monospace; }

  /* Network badge */
  .net-badge {
    font-size: 11px; font-weight: 700; letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem; border-radius: 99px; text-transform: uppercase;
  }
  .net-testnet { background: rgba(88,166,255,0.15); color: var(--blue); }
  .net-mainnet { background: rgba(63,185,80,0.15);  color: var(--green); }

  /* Safety gates */
  .safety-list { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.75rem; }
  .safety-item {
    display: flex; align-items: flex-start; gap: 0.75rem;
    padding: 0.5rem 0.75rem; border-radius: 5px; font-size: 12px;
  }
  .safety-item.pass    { background: rgba(63,185,80,0.07);  border: 1px solid rgba(63,185,80,0.2); }
  .safety-item.fail    { background: rgba(248,81,73,0.07);   border: 1px solid rgba(248,81,73,0.2); }
  .safety-item.warn    { background: rgba(210,153,34,0.07);  border: 1px solid rgba(210,153,34,0.2); }
  .safety-icon { font-size: 14px; flex-shrink: 0; margin-top: 1px; }
  .safety-name { font-weight: 500; margin-bottom: 2px; }
  .safety-detail { color: var(--muted); font-size: 11px; }
  .safety-loading { color: var(--muted); font-size: 12px; font-style: italic; padding: 0.5rem 0; }

  /* Wallet key display */
  .key-row { display: flex; align-items: center; gap: 0.75rem; }
  .key-mono { font-family: monospace; font-size: 12px; color: var(--text); }
  .key-badge {
    font-size: 10px; font-weight: 600; padding: 0.1rem 0.5rem;
    border-radius: 3px; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .key-set    { background: rgba(63,185,80,0.15);  color: var(--green); }
  .key-notset { background: rgba(139,148,158,0.15); color: var(--muted); }

  /* Mainnet button */
  .btn-mainnet {
    background: none; border: 1px solid var(--border); color: var(--muted);
    border-radius: 4px; padding: 0.3rem 0.85rem; font-size: 12px; cursor: pointer;
    transition: all 0.15s;
  }
  .btn-mainnet:hover:not(:disabled) { border-color: var(--green); color: var(--green); }
  .btn-mainnet:disabled { opacity: 0.4; cursor: not-allowed; }

  @media (max-width: 600px) {
    .settings-page { padding: 1.25rem 0.75rem 3rem; }
  }
</style>

<nav class="nav">
  <a href="/" class="nav-brand">HL Bot</a>
  <button class="hamburger" id="nav-hamburger" aria-label="Menu">&#9776;</button>
  <div class="nav-links" id="nav-links">
    <a href="/" class="nav-link">Overview</a>
    <a href="/strategies" class="nav-link">Strategies</a>
    <a href="/bots" class="nav-link">Bots</a>
    <a href="/trades" class="nav-link">Trades</a>
    <a href="/backtest" class="nav-link">Backtest</a>
    <a href="/builder" class="nav-link">Builder</a>
    <a href="/learn" class="nav-link">Learn</a>
    <a href="/settings" class="nav-link active">Settings</a>
  </div>
  <div class="nav-right">
    <span class="dot"></span>
    <span class="badge badge-net"><%= network %></span>
    <span class="text-muted"><%= coin %></span>
    <button class="theme-btn" id="theme-toggle" title="Toggle theme">&#9790;</button>
  </div>
</nav>

<div class="settings-page">

  <div class="settings-hdr">
    <h1>Settings</h1>
    <p>Global configuration. Bot management is on the <a href="/bots" style="color:var(--blue)">Bots page</a>.</p>
  </div>

  <!-- ── Network ── -->
  <div class="settings-section">
    <div class="section-header">
      <h2>Network</h2>
      <span class="net-badge net-<%= network %>"><%= network %></span>
    </div>
    <div class="section-body">
      <div class="setting-row">
        <div class="setting-lbl">
          Current network
          <div class="setting-sub">Set via <code>HL_NETWORK</code> in .env · requires restart to change</div>
        </div>
        <span class="setting-val"><%= network %></span>
      </div>
      <% if (network === 'testnet') { %>
      <div class="setting-row">
        <div class="setting-lbl">
          Switch to mainnet
          <div class="setting-sub">All safety gates below must pass before this is enabled</div>
        </div>
        <button class="btn-mainnet" id="btn-mainnet" disabled title="Safety gates must all pass first">
          Enable Mainnet
        </button>
      </div>
      <% } %>

      <!-- Safety gates (loaded async) -->
      <div style="margin-top:0.5rem">
        <p style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:var(--muted);margin-bottom:0.5rem">
          Mainnet Safety Gates
        </p>
        <div id="safety-list">
          <div class="safety-loading">Checking…</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Risk Defaults ── -->
  <div class="settings-section">
    <div class="section-header">
      <h2>Risk Defaults</h2>
      <span style="font-size:11px;color:var(--muted)">Edit in config/default.json · restart to apply</span>
    </div>
    <div class="section-body">
      <div class="setting-row">
        <div class="setting-lbl">Risk per trade
          <div class="setting-sub">Maximum loss per trade if the stop-loss fires, as % of account equity.
            Determines position size: a 2% risk with a 2% stop puts 1× leverage on the trade.</div>
        </div>
        <span class="setting-val"><%= risk.riskPerTradePercent ?? 2.0 %>%</span>
      </div>
      <div class="setting-row">
        <div class="setting-lbl">Max concurrent risk
          <div class="setting-sub">Maximum simultaneous open risk across all live bots, as % of equity.
            New trades are rejected once this cap is reached.</div>
        </div>
        <span class="setting-val"><%= risk.maxConcurrentRiskPercent ?? 10.0 %>%</span>
      </div>
      <div class="setting-row">
        <div class="setting-lbl">Stop-loss %
          <div class="setting-sub">Executor triggers a reduce-only close when unrealised loss hits this threshold.
            Also used in the position-sizing formula: tighter stop → larger position for the same dollar risk.</div>
        </div>
        <span class="setting-val"><%= risk.stopLossPercent ?? 2 %>%</span>
      </div>
      <div class="setting-row">
        <div class="setting-lbl">Max leverage
          <div class="setting-sub">Maximum leverage on any single position. If the sizing formula would produce
            a higher leverage, the position is scaled down to fit.</div>
        </div>
        <span class="setting-val"><%= risk.maxLeverage ?? 5 %>×</span>
      </div>
      <div class="setting-row">
        <div class="setting-lbl">Max daily loss %
          <div class="setting-sub">Risk manager blocks all new entry signals once daily drawdown reaches this level.
            Resets at midnight UTC.</div>
        </div>
        <span class="setting-val"><%= risk.maxDailyLossPercent ?? 5 %>%</span>
      </div>
      <div style="margin-top:0.5rem;padding:0.6rem 0.75rem;background:var(--bg);border-radius:5px;font-size:11px;color:var(--muted);line-height:1.6">
        <strong style="color:var(--text)">Sizing formula:</strong>
        dollarRisk = equity × riskPerTrade% ·
        size = dollarRisk ÷ (price × stopLoss%) ·
        leverage = riskPerTrade% ÷ stopLoss%
        (capped at maxLeverage)
      </div>
    </div>
  </div>

  <!-- ── Wallet Status ── -->
  <div class="settings-section">
    <div class="section-header">
      <h2>Wallet Status</h2>
    </div>
    <div class="section-body">
      <div class="setting-row">
        <div class="setting-lbl">HL_PRIVATE_KEY (testnet executor)</div>
        <div class="key-row">
          <% if (hlKeyLoaded) { %>
            <span class="key-badge key-set">Loaded</span>
            <span class="key-mono"><%= hlKeyMasked %></span>
          <% } else { %>
            <span class="key-badge key-notset">Not set</span>
          <% } %>
        </div>
      </div>
      <div class="setting-row">
        <div class="setting-lbl">HL_MAINNET_PRIVATE_KEY</div>
        <div class="key-row">
          <% if (hlMainnetKeyLoaded) { %>
            <span class="key-badge key-set">Loaded</span>
            <span class="key-mono"><%= hlMainnetKeyMasked %></span>
          <% } else { %>
            <span class="key-badge key-notset">Not set</span>
          <% } %>
        </div>
      </div>
      <div class="setting-row">
        <div class="setting-lbl">DYDX_TESTNET_MNEMONIC</div>
        <span class="key-badge <%= dydxMnemonicLoaded ? 'key-set' : 'key-notset' %>">
          <%= dydxMnemonicLoaded ? 'Loaded (24 words)' : 'Not set' %>
        </span>
      </div>
    </div>
  </div>

</div>

<script>
(function () {
  'use strict';

  // ── Safety gates ──────────────────────────────────────────────────────────
  async function loadSafetyStatus() {
    const container = document.getElementById('safety-list');
    try {
      const resp = await fetch('/api/safety-status');
      if (!resp.ok) throw new Error(resp.statusText);
      const { checks, allPass } = await resp.json();

      container.innerHTML = checks.map(c => {
        const icon = c.status === 'pass' ? '✓' : c.status === 'warn' ? '⚠' : '✗';
        return `<div class="safety-item ${c.status}">
          <span class="safety-icon">${icon}</span>
          <div>
            <div class="safety-name">${c.name}</div>
            <div class="safety-detail">${c.detail}</div>
          </div>
        </div>`;
      }).join('');

      const btn = document.getElementById('btn-mainnet');
      if (btn) btn.disabled = !allPass;
    } catch (e) {
      container.innerHTML = `<div class="safety-loading">Error loading safety status: ${e.message}</div>`;
    }
  }

  loadSafetyStatus();

  // ── Mainnet toggle (just writes a hint to the user for now) ───────────────
  const btnMainnet = document.getElementById('btn-mainnet');
  if (btnMainnet) {
    btnMainnet.addEventListener('click', function () {
      alert(
        'To switch to mainnet:\n\n' +
        '1. Set HL_NETWORK=mainnet in your .env file\n' +
        '2. Set HL_MAINNET_PRIVATE_KEY to your mainnet wallet key\n' +
        '3. Restart the bot process (pm2 restart hl-trading-bot)\n\n' +
        'Confirm all safety gates pass before doing this.'
      );
    });
  }
})();
</script>

</body>
</html>
